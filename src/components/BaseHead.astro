---
import '../styles/global.css';
import { getLocale, inLanguage, translator } from '../i18n/locale';

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
}

const {
  title,
  description,
  image = '/og/vincenzo-di-perna-og.png',
  ogType = 'website',
} = Astro.props;

const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(inLanguage(Astro.url.pathname, locale), site).toString();
const hasAlternates = Astro.url.pathname === "/" || Astro.url.pathname === "/it/" ||
  inLanguage(Astro.url.pathname, locale === "it" ? "en" : "it") !== Astro.url.pathname;
const imageURL = new URL(image, Astro.site ?? Astro.url).toString();
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<meta name="google-site-verification" content="iVnoLzm8FR9h5ZJ2baEdQicKupuVMng0c6Jk3hPQKV8" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

{hasAlternates && (
  <>
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="en" href={new URL(inLanguage(Astro.url.pathname, "en"), site)} />
    <link rel="alternate" hreflang="it" href={new URL(inLanguage(Astro.url.pathname, "it"), site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(inLanguage(Astro.url.pathname, "en"), site)} />
  </>
)}

<!-- Open Graph / Facebook -->
<meta property="og:locale" content={locale === "it" ? "it_IT" : "en_US"} />
{hasAlternates && <meta property="og:locale:alternate" content={locale === "it" ? "en_US" : "it_IT"} />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Vincenzo Di Perna" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:secure_url" content={imageURL} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content={t("Preview of the Vincenzo Di Perna website", "Anteprima del sito di Vincenzo Di Perna")}
/>

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />