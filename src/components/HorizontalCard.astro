---
import { getLocale, inLanguage } from "../i18n/locale";

const { title, img, imgAlt = "", desc, url, badge, tags, target = "_blank" } = Astro.props;
const href = typeof url === "string" && url ? inLanguage(url, getLocale(Astro.url.pathname)) : undefined;
const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<article class:list={[
  "network-protected relative rounded-lg bg-base-100 shadow-md",
  href && "transition-shadow hover:shadow-xl focus-within:shadow-xl",
]}>
  <div class="hero-content flex-col md:flex-row">
    {img && (
      <img
        src={img}
        alt={imgAlt}
        decoding="async"
        width="750"
        height="422"
        loading="lazy"
        class="w-full md:w-52 h-auto shrink-0 aspect-video rounded-lg object-cover"
      />
    )}
    <div class="grow w-full">
      <h3 class="text-xl font-bold">
        {href ? (
          <a {href} {target} {rel} class="hover:underline after:absolute after:inset-0 after:rounded-lg">
            {title}
          </a>
        ) : title}
      </h3>
      {badge && <span class="badge badge-secondary mt-1">{badge}</span>}
      <p class="py-1">{desc}</p>
      {tags && (
        <div class="card-actions justify-end">
          {tags.map((tag) => <span class="badge badge-outline">{tag}</span>)}
        </div>
      )}
    </div>
  </div>
</article>
