---
import { translator } from "../../../i18n/locale";

const t = translator(Astro.url.pathname);
---

<section id="token-ownership-lab" class="network-protected card bg-base-100 shadow-md">
  <div class="card-body">
    <div class="flex flex-wrap gap-2 items-center mb-2">
      <h3 class="card-title">{t("Tokens, incentives & ownership", "Token, incentivi e proprietà")}</h3>
      <span class="badge badge-secondary">Tokenomics</span>
      <span class="badge badge-outline">{t("Distribution", "Distribuzione")}</span>
      <span class="badge badge-outline">{t("Concentration", "Concentrazione")}</span>
    </div>

    <p class="opacity-80 mb-4">
      {t("Change token distribution events and observe how ownership concentration changes. This is a toy model, not a financial model.", "Cambia la distribuzione dei token e osserva in quali mani si concentra la proprietà. È un modello semplificato per fare pratica.")}
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_0.8fr] gap-4">
      <div class="grid gap-3">
        <div data-token-bars class="grid gap-3"></div>

        <div class="flex flex-wrap gap-2">
          <button class="btn btn-primary" data-token-action="equal-airdrop">
            {t("Equal airdrop", "Distribuisci la stessa quantità a tutti")}
          </button>

          <button class="btn btn-outline" data-token-action="whale-buy">
            {t("Whale accumulation", "Aumenta la quota del maggiore detentore")}
          </button>

          <button class="btn btn-outline" data-token-action="staking">
            {t("Staking rewards", "Ricompense per lo staking")}
          </button>

          <button class="btn btn-outline" data-token-action="reset">
            {t("Reset", "Ripristina")}
          </button>
        </div>
      </div>

      <div class="rounded-xl bg-base-200 border border-base-300 p-4">
        <p class="font-semibold mb-2">{t("Concentration meter", "Misura della concentrazione")}</p>

        <div class="stats stats-vertical w-full bg-base-100 mb-4">
          <div class="stat">
            <div class="stat-title">{t("Largest holder", "Chi detiene più token")}</div>
            <div class="stat-value text-2xl" data-largest-holder>-</div>
          </div>

          <div class="stat">
            <div class="stat-title">{t("HHI-style score", "Indice di concentrazione HHI")}</div>
            <div class="stat-value text-2xl" data-hhi-score>-</div>
          </div>
        </div>

        <p data-token-status class="text-sm opacity-80">
          {t("Try different distribution events.", "Prova diversi tipi di distribuzione.")}
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const isItalian = () => document.documentElement.lang === "it";
  const translate = (english, italian) => isItalian() ? italian : english;

  function initTokenOwnershipLab() {
    const root = document.querySelector("#token-ownership-lab");

    if (!root || root.dataset.initialized === "true") {
    return;
    }

    root.dataset.initialized = "true";

    const bars = root.querySelector("[data-token-bars]");
    const largestHolderOutput = root.querySelector("[data-largest-holder]");
    const hhiOutput = root.querySelector("[data-hhi-score]");
    const status = root.querySelector("[data-token-status]");

    const initialBalances = {
      Community: 250,
      Builders: 250,
      Treasury: 250,
      Whale: 250,
    };

    const italianHolders = {
      Community: "Comunità",
      Builders: "Sviluppatori",
      Treasury: "Tesoreria",
      Whale: "Grande detentore",
    };
    const holderLabel = (holder) => translate(holder, italianHolders[holder]);
    let balances = { ...initialBalances };

    function totalSupply() {
      return Object.values(balances).reduce((sum, value) => sum + value, 0);
    }

    function concentrationScore() {
      const total = totalSupply();

      return Object.values(balances).reduce((sum, value) => {
        const share = value / total;
        return sum + share * share;
      }, 0);
    }

    function render() {
      const total = totalSupply();

      bars.innerHTML = Object.entries(balances)
        .map(([holder, balance]) => {
          const percentage = Math.round((balance / total) * 100);

          return `
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span>${holderLabel(holder)}</span>
                <span class="font-mono">${balance} TOK · ${percentage}%</span>
              </div>
              <progress class="progress progress-primary w-full" value="${percentage}" max="100"></progress>
            </div>
          `;
        })
        .join("");

      const largest = Object.entries(balances).sort((a, b) => b[1] - a[1])[0];
      largestHolderOutput.textContent = `${holderLabel(largest[0])} ${Math.round((largest[1] / total) * 100)}%`;
      hhiOutput.textContent = concentrationScore().toFixed(3);
    }

    function equalAirdrop() {
      Object.keys(balances).forEach((holder) => {
        balances[holder] += 50;
      });

      status.textContent =
        translate("Equal airdrop: all groups receive the same amount, so relative concentration changes little.", "Tutti ricevono la stessa quantità di token. La concentrazione cambia di poco.");
      render();
    }

    function whaleBuy() {
      balances.Whale += 220;
      balances.Community = Math.max(0, balances.Community - 80);
      balances.Builders = Math.max(0, balances.Builders - 70);
      balances.Treasury = Math.max(0, balances.Treasury - 70);

      status.textContent =
        translate("Whale accumulation: one actor gains a larger share, increasing ownership concentration.", "Accumulo: un soggetto ottiene una quota più grande e la proprietà diventa più concentrata.");
      render();
    }

    function stakingRewards() {
      Object.entries(balances).forEach(([holder, balance]) => {
        balances[holder] += Math.round(balance * 0.08);
      });

      status.textContent =
        translate("Proportional staking rewards: larger holders receive larger absolute rewards, so concentration may persist.", "Chi parte da una quota più alta riceve più token in valore assoluto. Le ricompense proporzionali possono quindi lasciare invariata la concentrazione.");
      render();
    }

    function reset() {
      balances = { ...initialBalances };
      status.textContent = translate("Distribution reset to equal ownership.", "Distribuzione riportata a quote uguali.");
      render();
    }

    root.querySelector('[data-token-action="equal-airdrop"]').addEventListener("click", equalAirdrop);
    root.querySelector('[data-token-action="whale-buy"]').addEventListener("click", whaleBuy);
    root.querySelector('[data-token-action="staking"]').addEventListener("click", stakingRewards);
    root.querySelector('[data-token-action="reset"]').addEventListener("click", reset);

    render();
  }

  initTokenOwnershipLab();

  if (!window.__tokenOwnershipLabPageLoadRegistered) {
    window.__tokenOwnershipLabPageLoadRegistered = true;
    document.addEventListener("astro:page-load", initTokenOwnershipLab);
  }
</script>