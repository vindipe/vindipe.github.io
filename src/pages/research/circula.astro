---
import { getLocale, inLanguage, translator } from "../../i18n/locale";
import BaseLayout from "../../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);
const lifecycleUrl = locale === "it" ? "/circula-lifecycle.html?lang=it" : "/circula-lifecycle.html";
---

<BaseLayout
  title={t("CIRCULA | Expiry-Aware Blockchain Research | Vincenzo Di Perna", "CIRCULA | Scadenza e rinnovo nelle blockchain | Vincenzo Di Perna")}
  description={t("CIRCULA is an SNSF-funded research project exploring expiry and renewal in blockchain systems, hosted at the University of Neuchâtel.", "CIRCULA studia come gestire scadenza e rinnovo nelle blockchain. L’Università di Neuchâtel ospita il progetto, finanziato dal Fondo nazionale svizzero.")}
  sideBarActiveItemID="research"
  enableTransitions={false}
>
  <section class="mb-10">
    <div class="flex flex-wrap gap-2 mb-4"><span class="badge badge-primary">{t("Expected start · 1 February 2027", "Avvio previsto · 1° febbraio 2027")}</span><span class="badge badge-outline">{t("SNSF-funded · University of Neuchâtel", "Università di Neuchâtel · Finanziato dal Fondo nazionale svizzero")}</span></div>
    <h1 class="mb-5">
      <span class="sr-only">{t("CIRCULA: expiry and renewal in blockchains", "CIRCULA: scadenza e rinnovo nelle blockchain")}</span>
      <img src="/research/circula/wordmark.webp" alt="" width="450" height="155" class="w-56 max-w-full rounded-lg" />
    </h1>
    <p class="text-xl font-semibold mb-4">{t("Expiry-Aware System Design for Blockchains", "Come progettare blockchain in cui le risorse possono scadere")}</p>
    <p class="text-lg leading-relaxed max-w-3xl">{t("What if a digital resource had a lifetime designed into the system? CIRCULA will investigate how expiry and renewal can be represented and studied in programmable distributed ledgers.", "E se un registro distribuito potesse stabilire fino a quando una risorsa digitale è valida? CIRCULA studierà come definire scadenza e rinnovo nei registri programmabili e quali effetti hanno sul funzionamento del sistema.")}</p>
  </section>
  <section class="mb-10">
    <h2 id="time" class="text-3xl font-bold mb-4">{t("A new dimension: time", "Una nuova dimensione: il tempo")}</h2>
    <div class="space-y-4 leading-relaxed max-w-3xl">
      <p>{t("During my PhD, I studied how network topology affects the behaviour and evaluation of blockchain systems. CIRCULA starts from another question: how might a system handle a resource whose validity is meant to end or be renewed?", "Nel dottorato ho studiato come la struttura della rete cambi il comportamento delle blockchain e le misure con cui le confrontiamo. Con CIRCULA entra in gioco un’altra variabile: il tempo. Come dovrebbe comportarsi il sistema quando una risorsa scade o viene rinnovata?")}</p>
      <p>{t("For example, a digital entitlement might be valid for a defined period and later require renewal. CIRCULA will study the rules and system implications of lifetimes such as these, including the assumptions and boundaries of different approaches.", "Pensa a un diritto di accesso valido fino a una certa data. Che cosa accade se il titolare ne chiede il rinnovo? CIRCULA studierà quali regole può applicare il sistema, quali ipotesi richiedono e che cosa succede nei casi limite.")}</p>
      <p>{t("The project will connect an evidence base with formal and executable semantics, prototypes, and controlled evaluation. These are research objectives: the project is expected to begin on 1 February 2027.", "Partiremo da ciò che sappiamo sui sistemi esistenti, formalizzeremo le regole e le metteremo alla prova con prototipi ed esperimenti controllati. L’avvio del progetto è previsto per il 1° febbraio 2027.")}</p>
    </div>
  </section>
  <section class="mb-10">
    <h2 id="expiry-and-renewal" class="text-3xl font-bold mb-4">{t("Explore expiry and renewal", "Simula scadenza e rinnovo")}</h2>
    <p class="mb-4">{t("Compare what happens to a digital right with and without renewal. This illustrative tool is adapted from the CIRCULA website.", "Nella simulazione puoi confrontare due scenari per lo stesso diritto digitale: la scadenza alla data iniziale e il rinnovo prima di quella data. Il simulatore proviene dal sito di CIRCULA.")}</p>
    <iframe src={lifecycleUrl} title={t("CIRCULA expiry and renewal interactive demonstration", "Simulazione interattiva di CIRCULA su scadenza e rinnovo")} id="lifecycle-frame" loading="lazy" style="display:block;width:100%;height:900px;border:0;border-radius:1rem;background:#121a17"></iframe>
    <p class="mt-2"><a class="link link-primary" href={lifecycleUrl}>{t("Open the interactive demonstration on its own", "Apri la simulazione in una pagina dedicata")}</a></p>
  </section>
  <section class="mb-10">
    <h2 id="project-links" class="text-3xl font-bold mb-4">{t("Explore the project", "Approfondisci il progetto")}</h2>
    <p class="mb-5 leading-relaxed">{t("CIRCULA is funded by the Swiss National Science Foundation and hosted by the University of Neuchâtel.", "L’Università di Neuchâtel ospita CIRCULA, con il finanziamento del Fondo nazionale svizzero per la ricerca scientifica.")}</p>
    <div class="flex flex-wrap gap-3">
      <a class="btn btn-primary" href={locale === "it" ? "https://circula.unine.ch/it/" : "https://circula.unine.ch/"} target="_blank" rel="noopener noreferrer">{t("Official CIRCULA website", "Sito ufficiale di CIRCULA")}</a>
      <a class="btn btn-outline" href="https://data.snf.ch/grants/grant/10010141" target="_blank" rel="noopener noreferrer">{t("SNSF grant", "Scheda del progetto sul sito del Fondo nazionale svizzero")}</a>
      <a class="btn btn-outline" href={localPath("/research")}>{t("More research", "Torna a Ricerca")}</a>
    </div>
  </section>
</BaseLayout>

<script>
  const frame = document.querySelector<HTMLIFrameElement>("#lifecycle-frame");
  if (frame) {
    let observer: ResizeObserver | undefined;

    function attach() {
      observer?.disconnect();
      const content = frame?.contentDocument?.getElementById("content");
      if (!content || !frame) return;
      const resize = () => {
        frame.style.height = `${Math.ceil(content.getBoundingClientRect().height)}px`;
      };
      observer = new ResizeObserver(resize);
      observer.observe(content);
      resize();
    }

    frame.addEventListener("load", attach);
    attach();
  }
</script>
