---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
const language = locale === "it" ? "it-IT" : "en-US";

const technologies = [
  ["github", "GitHub"], ["git", "Git"], ["githubactions", "GitHub Actions"],
  ["docker", "Docker"], ["kubernetes", "Kubernetes"], ["linux", "Linux"],
  ["gnubash", "Bash"], ["python", "Python"], ["rust", "Rust"], ["go", "Go"],
  ["c", "C"], ["cplusplus", "C++"], ["javascript", "JavaScript"], ["typescript", "TypeScript"],
  ["html5", "HTML"], ["css", "CSS"], ["astro", "Astro"], ["tailwindcss", "Tailwind CSS"],
  ["githubpages", "GitHub Pages"], ["cloudflare", "Cloudflare"], ["jupyter", "Jupyter"],
  ["ethereum", "Ethereum"], ["solana", "Solana"], ["algorand", "Algorand"],
  ["nodedotjs", "Node.js"], ["express", "Express"], ["ejs", "EJS"],
  ["heroku", "Heroku"], ["nginx", "NGINX"], ["gitlab", "GitLab"],
  ["terraform", "Terraform"], ["notion", "Notion"], ["openai", "OpenAI / ChatGPT"],
  ["bitcoin", "Bitcoin"], ["web3dotjs", "Web3.js"], ["markdown", "Markdown"],
  ["latex", "LaTeX"],
];

const roles = [
  t("Software Engineer", "Ingegnere del software"),
  t("Researcher", "Ricercatore"),
  t("Backend Developer", "Sviluppatore backend"),
  t("Python Developer", "Sviluppatore Python"),
  t("Rust Developer", "Sviluppatore Rust"),
  t("Go Developer", "Sviluppatore Go"),
  t("Web Developer", "Sviluppatore web"),
  t("Blockchain Infrastructure Engineer", "Ingegnere delle infrastrutture blockchain"),
  t("Protocol Engineer", "Ingegnere dei protocolli"),
  t("Distributed Systems Engineer", "Ingegnere dei sistemi distribuiti"),
  t("DevOps Engineer", "Ingegnere DevOps"),
  t("Performance Engineer", "Ingegnere delle prestazioni software"),
  t("AI & LLM Consultant", "Consulente IA e LLM"),
  t("LLM Application Developer", "Sviluppatore di applicazioni con LLM"),
  t("DeFi Analyst", "Analista DeFi"),
  t("Digital Asset Analyst", "Analista di asset digitali"),
  t("Technical Consultant", "Consulente tecnico"),
  t("Technical Trainer", "Formatore tecnico"),
];

const services = [
  {
    image: "strategy",
    name: t("Consulting and digital strategy planning", "Consulenza e pianificazione strategia digitale"),
    question: t("What solution do I need, and where should I start?", "Quale soluzione mi serve e da dove comincio?"),
    need: t(
      "You know what you want to achieve but need to decide whether to adopt a ready-made tool, adapt what you already use or build something tailored to your needs.",
      "Hai un obiettivo, ma devi decidere se adottare uno strumento già pronto, adattare quello che usi o sviluppare qualcosa su misura."
    ),
    work: [
      t("Clarify who will use the solution and what they need it to do.", "Chiarire chi userà la soluzione e che cosa deve poter fare."),
      t("Compare options by cost, time and the effort needed to maintain them.", "Confrontare le alternative per costi, tempi e impegno di gestione."),
      t("Decide what you need now and what can wait.", "Decidere quali funzioni servono subito e quali possono aspettare."),
    ],
    outcome: t(
      "A decision you can explain and a plan that tells you what to do first.",
      "Una scelta motivata e un piano che ti dice da dove partire."
    ),
  },
  {
    image: "infrastructure",
    name: t("Implement digital infrastructure", "Implementare infrastruttura digitale"),
    question: t("How do I build and launch my website or application?", "Come realizzo e metto online il sito o l’applicazione che mi serve?"),
    need: t(
      "You need a website built, an application published or an existing service moved to a new hosting provider. You want someone to handle the technical work through to launch.",
      "Devi realizzare un sito, pubblicare un’applicazione o trasferire un servizio che usi già. Cerchi chi può occuparsi del lavoro tecnico fino alla messa online."
    ),
    work: [
      t("Build the site or configure the application around the features we agree on.", "Sviluppare il sito o configurare l’applicazione in base alle funzioni concordate."),
      t("Set up hosting, the domain and the tools needed to publish changes.", "Configurare l’hosting, il dominio e gli strumenti per pubblicare gli aggiornamenti."),
      t("Move existing content or services where needed and check that core features work online.", "Trasferire contenuti o servizi esistenti, se previsto, e verificare online le funzioni principali."),
    ],
    outcome: t(
      "A live website or application, with instructions for managing and updating it.",
      "Un sito o un’applicazione online, con le istruzioni per la gestione e gli aggiornamenti."
    ),
  },
  {
    image: "support",
    name: t("Digital support", "Supporto digitale"),
    question: t("Something has stopped working. Who can help?", "Uno strumento che uso si è bloccato. Come riprendo a lavorare?"),
    need: t(
      "A tool you rely on has stopped working, you can’t access a service or you need help configuring it. Remote help is also available.",
      "Uno strumento che usi per lavorare non funziona più, hai difficoltà ad accedere a un servizio o ti serve una mano a configurarlo. Posso aiutarti anche da remoto."
    ),
    work: [
      t("Work out whether the issue is with the device, the software or the account settings.", "Individuare se il problema dipende dal dispositivo, dal software o dalle impostazioni dell’account."),
      t("Apply a fix or reconfigure the tool so you can use it again.", "Applicare una correzione o riconfigurare lo strumento per renderlo di nuovo utilizzabile."),
      t("Check the result with you and identify any next steps.", "Verificare insieme che tu possa riprendere il lavoro e individuare eventuali passi successivi."),
    ],
    outcome: t(
      "A fix we’ve tested together, or a clear account of what to report if the provider needs to step in.",
      "Una soluzione verificata insieme oppure indicazioni precise su cosa segnalare se deve intervenire il fornitore."
    ),
  },
  {
    image: "training",
    name: t("Training", "Formazione"),
    question: t("How can I get better at using the tools I need?", "Come imparo a usare meglio gli strumenti che mi servono?"),
    need: t(
      "You want to learn a new tool or skill and practise it on a task you actually do at work.",
      "Vuoi imparare a usare uno strumento o acquisire una competenza esercitandoti su un’attività che svolgi davvero."
    ),
    work: [
      t("Define what you want to be able to do on your own.", "Definire che cosa vuoi riuscire a fare in autonomia."),
      t("Work through your task together, whether it involves managing data, using AI or programming.", "Fare pratica sul tuo caso, dalla gestione di dati e documenti all’uso dell’IA o alla programmazione."),
      t("Guide you as you repeat the key steps and check the result.", "Affiancarti mentre ripeti i passaggi chiave e verifichi il risultato."),
    ],
    outcome: t(
      "A way to carry out the task independently and check that you’ve got the result you need.",
      "Un metodo per svolgere l’attività da solo e verificare di aver ottenuto il risultato che ti serve."
    ),
  },
];

const appointmentHours = [[9, 12], [14, 17]];
const slots = appointmentHours.map(([start, end]) => (
  Array.from({ length: (end - start) * 2 }, (_, index) => {
    const hour = String(start + Math.floor(index / 2)).padStart(2, "0");
    return `${hour}:${index % 2 === 0 ? "00" : "30"}`;
  })
));
const email = "vincenzopaolo.diperna@outlook.com";
---

<BaseLayout
  title={t("Freelance Services | Vincenzo Di Perna", "Servizi freelance | Vincenzo Di Perna")}
  description={t(
    "Digital consulting, website and application development and deployment, technical support and hands-on training from Vincenzo Di Perna.",
    "Consulenza digitale, realizzazione e messa in produzione di siti e applicazioni, supporto tecnico e formazione pratica con Vincenzo Di Perna."
  )}
  sideBarActiveItemID="services"
>
  <digital-services class="block" data-language={language} data-email={email}>
    <header class="mb-10">
      <h1 class="text-4xl font-bold mb-4">{t("Freelance Services", "Servizi freelance")}</h1>
      <p class="text-lg leading-relaxed opacity-90">{t(
        "I help you choose, build and manage the digital tools you rely on at work. I take websites and applications through to launch and offer technical support and hands-on training.",
        "Ti aiuto a scegliere, realizzare e gestire gli strumenti digitali con cui lavori. Seguo la messa in produzione di siti e applicazioni e offro supporto tecnico e formazione pratica."
      )}</p>
    </header>

    <div class="service-profile mb-12">
      <ul class="technology-medals" aria-label={t("Technologies I know", "Tecnologie che conosco")}>
        {technologies.map(([icon, name]) => (
          <li title={name}>
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24">
              <use href={`/services/technology-logos.svg#${icon}`} />
            </svg>
            <span class="sr-only">{name}</span>
          </li>
        ))}
      </ul>
      <ul class="service-roles" aria-label={t("Roles I’m open to", "Ruoli che posso ricoprire")}>
        {roles.map((role) => <li>{role}</li>)}
      </ul>
    </div>

    <section class="mb-12" aria-labelledby="choose-service">
      <h2 id="choose-service" class="text-3xl font-bold mb-5">{t("What do you need help with?", "Di cosa hai bisogno?")}</h2>
      <div class="grid gap-4">
        {services.map(({ image, name, question, need, work, outcome }) => (
          <details class="network-protected collapse collapse-arrow bg-base-100 shadow-md motion-safe:transition-shadow hover:shadow-2xl">
            <summary class="collapse-title rounded-box focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-4">
              <h3 class="card-title">{name}</h3>
              <span class="block mt-1">{question}</span>
            </summary>
            <div class="collapse-content">
              <div class="border-t border-base-300 pt-4 space-y-4">
                <img
                  class="service-photo"
                  src={`/services/${image}.webp`}
                  width="960"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  alt=""
                />
                <div>
                  <h4 class="font-semibold">{t("When it’s useful", "Quando ti serve")}</h4>
                  <p class="mt-1">{need}</p>
                </div>
                <div>
                  <h4 class="font-semibold">{t("What I can do for you", "Su cosa ti aiuto")}</h4>
                  <ul class="list-disc pl-5 mt-1 space-y-1">
                    {work.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
                <div>
                  <h4 class="font-semibold">{t("What you get", "Cosa ottieni")}</h4>
                  <p class="mt-1">{outcome}</p>
                </div>
                <div class="card-actions justify-end">
                  <button class="btn btn-sm btn-outline" type="button" data-open-booking data-service={name} aria-haspopup="dialog" hidden>
                    {t("Request an appointment", "Richiedi un appuntamento")}
                  </button>
                </div>
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="mb-12 text-center" aria-labelledby="appointment">
      <h2 id="appointment" class="text-3xl font-bold mb-4">{t("Let's connect", "Parliamone")}</h2>
      <p class="max-w-prose mx-auto mb-4 text-center">{t(
        "In a free 30-minute call, we can go over what you want to achieve, what you already have and where I can help.",
        "In un primo colloquio gratuito di 30 minuti possiamo capire cosa vuoi ottenere, da cosa parti e come posso aiutarti."
      )}</p>
      <button class="btn btn-primary" type="button" data-open-booking aria-haspopup="dialog" hidden>
        {t("Request an appointment", "Richiedi un appuntamento")}
      </button>
      <noscript>
        <a class="btn btn-primary" href={inLanguage("/contact/", locale)}>{t("Contact me", "Contattami")}</a>
      </noscript>
    </section>

    <dialog class="modal modal-bottom sm:modal-middle" aria-labelledby="booking-title" aria-describedby="booking-topic booking-note">
      <div class="modal-box">
        <div class="flex items-center justify-between gap-2">
          <h3 id="booking-title" class="card-title">{t("Request a free appointment", "Richiedi un appuntamento gratuito")}</h3>
          <form method="dialog">
            <button class="btn btn-ghost btn-circle btn-sm" aria-label={t("Close", "Chiudi")}>×</button>
          </form>
        </div>
        <p id="booking-topic" class="mt-2 font-semibold" data-booking-topic hidden></p>
        <p id="booking-note" class="mt-2">{t(
          "Choose a time for your free 30-minute call. I’ll confirm the appointment by email.",
          "Scegli un orario per il colloquio gratuito di 30 minuti. Ti confermerò l’appuntamento via email."
        )}</p>

        <form class="grid gap-3 mt-4" data-booking-form data-subject={t("Freelance services · Appointment request", "Servizi freelance · Richiesta appuntamento")}>
          <label class="grid gap-1 font-semibold">
            {t("Preferred date", "Data preferita")}
            <input class="input input-bordered w-full max-w-[13rem] font-normal" type="date" name="date" required />
          </label>
          <fieldset class="booking-times min-w-0" aria-describedby="booking-timezone" disabled>
            <legend class="font-semibold">{t("Start time", "Ora di inizio")}</legend>
            <p id="booking-timezone" class="text-sm opacity-80 mb-2">{t(
              "Italy time (Europe/Rome) · 09:00–12:00 and 14:00–17:00",
              "Ora italiana (Europe/Rome) · 09:00–12:00 e 14:00–17:00"
            )}</p>
            {slots.map((times, index) => (
              <div class="grid grid-cols-3 sm:grid-cols-6 gap-1.5 mb-1.5" role="group" aria-label={index === 0 ? t("Morning", "Mattina") : t("Afternoon", "Pomeriggio")}>
                {times.map((time) => (
                  <label class="min-w-0">
                    <input type="radio" class="peer sr-only" name="time" value={time} required />
                    <span class="btn btn-outline btn-sm w-full px-0 peer-checked:btn-active peer-focus-visible:outline peer-focus-visible:outline-2 peer-disabled:opacity-40 peer-disabled:cursor-default">{time}</span>
                  </label>
                ))}
              </div>
            ))}
          </fieldset>
          <p class="text-sm opacity-80" data-no-times hidden>{t(
            "Choose another date to see more times.",
            "Scegli un’altra data per vedere altri orari."
          )}</p>
          <button class="btn btn-primary justify-self-start" type="submit">{t("Open email", "Apri email")}</button>
        </form>
      </div>
    </dialog>
  </digital-services>
</BaseLayout>

<style>
  .service-profile {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 1.15rem;
  }

  .technology-medals {
    display: grid;
    grid-template-columns: repeat(auto-fill, 2.25rem);
    gap: 0.35rem;
  }

  .technology-medals li {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid oklch(var(--bc) / 0.12);
    border-radius: 50%;
    background-color: oklch(var(--b2));
  }

  .service-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    border-inline-start: 1px solid oklch(var(--bc) / 0.15);
    padding-inline-start: 1.15rem;
  }

  .service-roles li {
    padding: 0.25rem 0.55rem;
    border-radius: 0.45rem;
    background-color: oklch(var(--b2));
    font-size: 0.8rem;
    line-height: 1.35;
    text-align: start;
    hyphens: none;
  }

  .service-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 3;
    border-radius: 0.65rem;
    object-fit: cover;
  }

  @media (max-width: 36rem) {
    .service-profile { grid-template-columns: 1fr; }
    .service-roles {
      border-inline-start: 0;
      border-block-start: 1px solid oklch(var(--bc) / 0.15);
      padding-inline-start: 0;
      padding-block-start: 1rem;
    }
  }
</style>

<script>
  const romeClock = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Rome",
    year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
  });

  class DigitalServices extends HTMLElement {
    #initialized = false;

    connectedCallback() {
      if (this.#initialized) return;
      this.#initialized = true;

      const dialog = this.querySelector("dialog")!;
      const form = dialog.querySelector<HTMLFormElement>("[data-booking-form]")!;
      const topic = dialog.querySelector<HTMLParagraphElement>("[data-booking-topic]")!;
      const date = form.querySelector<HTMLInputElement>('[name="date"]')!;
      const timeGroup = form.querySelector<HTMLFieldSetElement>(".booking-times")!;
      const times = [...timeGroup.querySelectorAll<HTMLInputElement>('[name="time"]')];
      const noTimes = form.querySelector<HTMLElement>("[data-no-times]")!;
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const italian = this.dataset.language === "it-IT";

      const updateTimes = () => {
        const parts = Object.fromEntries(romeClock.formatToParts(new Date()).map(({ type, value }) => [type, value]));
        const today = `${parts.year}-${parts.month}-${parts.day}`;
        const now = `${parts.hour}:${parts.minute}`;

        date.min = today;
        timeGroup.disabled = !date.value || !date.validity.valid;
        for (const time of times) {
          time.disabled = date.value === today && time.value <= now;
          if (time.disabled) time.checked = false;
        }
        const noneAvailable = times.every((time) => time.disabled);
        noTimes.hidden = !noneAvailable;
        submitButton.disabled = timeGroup.disabled || noneAvailable;
      };

      for (const button of this.querySelectorAll<HTMLButtonElement>("[data-open-booking]")) {
        button.hidden = false;
        button.addEventListener("click", () => {
          topic.textContent = button.dataset.service ?? "";
          topic.hidden = !topic.textContent;
          updateTimes();
          dialog.showModal();
        });
      }

      date.addEventListener("change", updateTimes);
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        updateTimes();
        const time = times.find((slot) => slot.checked && !slot.disabled);
        if (!form.reportValidity() || !time) return;

        const serviceLine = topic.textContent ? `\n${italian ? "Servizio" : "Service"}: ${topic.textContent}` : "";
        const body = italian
          ? `Ciao Vincenzo,\n\nvorrei richiedere un colloquio gratuito di 30 minuti.${serviceLine}\nData e ora preferite: ${date.value}, ${time.value} (Europe/Rome).\n\nDi cosa ho bisogno:\n\nGrazie!`
          : `Hi Vincenzo,\n\nI’d like to request a free 30-minute call.${serviceLine}\nPreferred date and time: ${date.value}, ${time.value} (Europe/Rome).\n\nWhat I need help with:\n\nThank you!`;
        location.href = `mailto:${this.dataset.email}?subject=${encodeURIComponent(form.dataset.subject!)}&body=${encodeURIComponent(body)}`;
      });
    }
  }

  customElements.define("digital-services", DigitalServices);
</script>

<style>
  [data-open-booking][hidden], dialog:not([open]) {
    display: none;
  }
</style>
