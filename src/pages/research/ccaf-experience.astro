---
import { getLocale, inLanguage, translator } from "../../i18n/locale";
import BaseLayout from "../../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const experienceAreas = [
  {
    title: t("Digital assets research", "Ricerca sugli asset digitali"),
    desc: t("Research activity within the Digital Asset Programme, focused on decentralised finance, digital-asset infrastructures, taxonomy design, and ecosystem analysis.", "Attività nel Digital Asset Programme su finanza decentralizzata, infrastrutture per asset digitali, progettazione di tassonomie e analisi dell’ecosistema."),
  },
  {
    title: t("DeFi taxonomy work", "Tassonomia della DeFi"),
    desc: t("Contribution to taxonomy-oriented research connecting DeFi protocol functions, actors, assets, infrastructure, and traditional-finance classification perspectives.", "Contributo alla ricerca sulle relazioni tra funzioni dei protocolli DeFi, attori, asset, infrastrutture e criteri di classificazione della finanza tradizionale."),
  },
  {
    title: t("Protocol classification", "Classificazione dei protocolli"),
    desc: t("Work connected to the structured analysis of DeFi protocols, their categories, governance properties, documentation, and protocol-level characteristics.", "Analisi strutturata dei protocolli DeFi, delle loro categorie, della governance, della documentazione e delle caratteristiche a livello di protocollo."),
  },
  {
    title: t("Research communication", "Comunicazione della ricerca"),
    desc: t("Support for translating a complex DeFi taxonomy into research outputs and digital-tool context, including the Cambridge DeFi Navigator.", "Contributo alla presentazione della tassonomia DeFi in pubblicazioni e strumenti digitali, tra cui il Cambridge DeFi Navigator."),
  },
];

const outputs = [
  {
    title: "Dynamic Taxonomy: A Bridge from DeFi to TradFi",
    href: "/research/dynamic-taxonomy-defi-tradfi",
    desc: t("Working paper on a dynamic taxonomy for connecting DeFi and TradFi through activities, actors, assets, architecture, and protocol-level attributes.", "Working paper su una tassonomia dinamica che mette in relazione DeFi e TradFi attraverso attività, attori, asset, architettura e attributi dei protocolli."),
  },
  {
    title: "Cambridge DeFi Navigator",
    href: "https://ccaf.io/defi/ecosystem-map/visualisation/graph",
    desc: t("Interactive CCAF digital tool for exploring the DeFi ecosystem through protocol categories and ecosystem visualisations.", "Strumento interattivo del CCAF per esplorare l’ecosistema DeFi attraverso categorie di protocolli e visualizzazioni."),
    external: true,
  },
];

const skills = [
  "Digital assets research",
  "DeFi ecosystem analysis",
  "Taxonomy design",
  "Protocol classification",
  "Data-oriented research",
  "Regulatory-facing analysis",
  "Research writing",
  "DeFi / TradFi mapping",
];
---

<BaseLayout
  title={t("Digital Asset Research at CCAF | Vincenzo Di Perna", "Ricerca sugli asset digitali al CCAF | Vincenzo Di Perna")}
  description={t("Vincenzo Di Perna’s research internship at the Cambridge Centre for Alternative Finance on digital assets, DeFi taxonomy and protocol classification.", "Tirocinio di Vincenzo Di Perna al Cambridge Centre for Alternative Finance su asset digitali, tassonomia DeFi e analisi dell’ecosistema.")}
  sideBarActiveItemID="research"
>
  <section class="mb-8">
    <a href={localPath("/research")} class="btn btn-sm btn-outline mb-6">
      {t("← Back to Research", "← Torna alla ricerca")}
    </a>

    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <div class="flex flex-wrap gap-2 items-center mb-3">
          <h1 class="text-4xl font-bold">
            {t("Digital Asset Programme Intern", "Tirocinio nel Digital Asset Programme")}
          </h1>
          <span class="badge badge-secondary">CCAF</span>
          <span class="badge badge-outline">{t("Research experience", "Esperienza di ricerca")}</span>
        </div>

        <p class="text-lg leading-relaxed opacity-90">
          {t("Research internship experience at the Cambridge Centre for Alternative Finance, within the Digital Asset Programme, focused on digital assets, decentralised finance, DeFi taxonomy, protocol classification, and the relationship between DeFi and traditional financial infrastructures.", "Tirocinio presso il Cambridge Centre for Alternative Finance, nel Digital Asset Programme. Ho lavorato su asset digitali, tassonomia della DeFi, classificazione dei protocolli e rapporto tra finanza decentralizzata e infrastrutture finanziarie tradizionali.")}
        </p>

        <div class="flex flex-wrap gap-2 mt-5">
          <span class="badge badge-outline">Digital Asset Programme</span>
          <span class="badge badge-outline">{t("Digital assets", "Asset digitali")}</span>
          <span class="badge badge-outline">DeFi</span>
          <span class="badge badge-outline">TradFi</span>
          <span class="badge badge-outline">{t("Taxonomy", "Tassonomia")}</span>
          <span class="badge badge-outline">Cambridge DeFi Navigator</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">Cambridge DeFi Navigator</h2>

        <p class="leading-relaxed opacity-90">
          {t("Explore the Cambridge DeFi Navigator, the interactive CCAF tool for navigating DeFi protocols, categories, and ecosystem relationships.", "Esplora il Cambridge DeFi Navigator, lo strumento del CCAF per orientarsi tra protocolli, categorie e relazioni nell’ecosistema DeFi.")}
        </p>

        <div class="mt-5 overflow-hidden rounded-xl border border-base-300 bg-base-200">
          <iframe
            src="https://ccaf.io/defi/ecosystem-map/visualisation/graph"
            title={t("Cambridge DeFi Navigator ecosystem map", "Mappa dell’ecosistema nel Cambridge DeFi Navigator")}
            class="h-[520px] w-full bg-base-100"
            loading="lazy"
          ></iframe>
        </div>

        <p class="text-sm opacity-70 mt-3">
          {t("If the embedded preview is blocked by the external website or by the browser, use the direct link below.", "Se l’anteprima è bloccata dal sito esterno o dal browser, puoi aprire lo strumento dal link qui sotto.")}
        </p>

        <a
          href="https://ccaf.io/defi/ecosystem-map/visualisation/graph"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-sm mt-3"
        >
          {t("Open Cambridge DeFi Navigator", "Apri Cambridge DeFi Navigator")}
        </a>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">CCAF</p>
          <p class="opacity-80">{t("research centre context", "centro di ricerca")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">DAP</p>
          <p class="opacity-80">Digital Asset Programme</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">DeFi</p>
          <p class="opacity-80">{t("taxonomy and ecosystem analysis", "tassonomia e analisi dell’ecosistema")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">TradFi</p>
          <p class="opacity-80">{t("financial-infrastructure bridge", "collegamento con le infrastrutture finanziarie")}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Experience context", "Contesto dell’esperienza")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("This experience sits at the intersection of digital-asset research, decentralised finance, financial-market infrastructure, and regulatory understanding. The work is connected to the need for clearer tools and frameworks to describe DeFi protocols in a way that is understandable both to blockchain-native stakeholders and to traditional-finance audiences.", "Questa esperienza unisce ricerca sugli asset digitali, finanza decentralizzata, infrastrutture dei mercati finanziari e aspetti normativi. Il lavoro nasce dalla necessità di descrivere i protocolli DeFi con strumenti e criteri comprensibili sia a chi opera nel mondo blockchain sia a chi proviene dalla finanza tradizionale.")}
        </p>

        <p class="leading-relaxed opacity-90 mt-3">
          {t("The main research line connected to this experience is the development of a dynamic DeFi taxonomy and its relationship with the Cambridge DeFi Navigator, a digital tool designed to make the DeFi ecosystem more accessible through interactive exploration.", "Il filone principale è lo sviluppo di una tassonomia dinamica della DeFi e la sua applicazione al Cambridge DeFi Navigator, uno strumento digitale per esplorare l’ecosistema in modo interattivo.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Areas of work", "Aree di lavoro")}</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
          {
            experienceAreas.map((area) => (
              <div class="card bg-base-200/50 border border-base-300">
                <div class="card-body">
                  <h3 class="font-bold">{area.title}</h3>
                  <p class="text-sm opacity-80">{area.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <figure class="px-6 pt-6">
        <img
          src="/research/ccaf/high-level-taxonomy.png"
          alt={t("High-level DeFi taxonomy developed around Activities, Actors, Assets, and Architecture.", "Tassonomia generale della DeFi articolata in attività, attori, asset e architettura.")}
          class="rounded-xl border border-base-300 bg-base-200"
          loading="lazy"
        />
      </figure>

      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Research focus: DeFi taxonomy", "La tassonomia della DeFi")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("A central output connected to the experience is the taxonomy work around DeFi and TradFi. The taxonomy organises decentralised finance through high-level categories and protocol-level attributes, making it easier to describe DeFi systems in a way that supports research, ecosystem mapping, and regulatory-facing interpretation.", "La tassonomia DeFi–TradFi è uno dei risultati centrali di questa esperienza. Organizza la finanza decentralizzata in categorie generali e attributi dei singoli protocolli per agevolare la ricerca, la mappatura dell’ecosistema e l’analisi normativa.")}
        </p>

        <div class="card-actions mt-4">
          <a
            href={localPath("/research/dynamic-taxonomy-defi-tradfi")}
            class="btn btn-sm btn-outline"
          >
            {t("Open taxonomy paper page", "Vai alla scheda dell’articolo sulla tassonomia")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Related outputs", "Risultati correlati")}</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
          {
            outputs.map((output) => (
              <a
                href={localPath(output.href)}
                target={output.external ? "_blank" : undefined}
                rel={output.external ? "noopener noreferrer" : undefined}
                class="card bg-base-200/50 border border-base-300 transition hover:shadow-lg hover:scale-[101%]"
              >
                <div class="card-body">
                  <h3 class="font-bold">{output.title}</h3>
                  <p class="text-sm opacity-80">{output.desc}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Skills and research capabilities", "Competenze di ricerca")}</h2>

        <div class="flex flex-wrap gap-2">
          {skills.map((skill) => <span class="badge badge-outline">{skill}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Links", "Collegamenti")}</h2>

        <div class="flex flex-wrap gap-3 mt-2">
          <a
            href={localPath("/research/dynamic-taxonomy-defi-tradfi")}
            class="btn btn-primary btn-sm"
          >
            {t("Open Dynamic Taxonomy page", "Vai alla scheda della tassonomia dinamica")}
          </a>

          <a
            href="https://ccaf.io/defi/ecosystem-map/visualisation/graph"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-sm"
          >
            {t("Open DeFi Navigator", "Apri DeFi Navigator")}
          </a>

          <a
            href="https://www.jbs.cam.ac.uk/faculty-research/centres/alternative-finance/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-sm"
          >
            {t("Open CCAF website", "Vai al sito del CCAF")}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
