---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const publications = [
  {
    title:
      t("The Impact of Network Topology on Performance Metrics and Energy Consumption for Blockchains: Towards Repeatable Benchmarking", "L’effetto della topologia di rete sulle prestazioni e sui consumi delle blockchain"),
    badge: t("ACM DLT journal", "Rivista ACM DLT"),
    href: "/research/acm-dlt-network-topologies-blockchain-performance",
    desc: t("ACM DLT journal article on topology-aware blockchain benchmarking, network-controlled experiments, workload sensitivity, and reproducible evaluation of blockchain performance.", "L’articolo su ACM DLT studia come rete e carichi di lavoro cambiano le prestazioni delle blockchain e come controllarli per rendere riproducibili le misure."),
    tags: [
      "ACM DLT",
      t("Blockchain benchmarking", "Benchmarking delle blockchain"),
      t("Network topology", "Topologia di rete"),
      t("Reproducibility", "Riproducibilità"),
    ],
  },
  {
    title: t("Dynamic Taxonomy: A Bridge from DeFi to TradFi", "Una tassonomia per collegare DeFi e finanza tradizionale"),
    badge: t("CCAF / Working paper", "CCAF / Documento di lavoro"),
    href: "/research/dynamic-taxonomy-defi-tradfi",
    desc: t("Research developed within the Cambridge Centre for Alternative Finance on a dynamic DeFi taxonomy designed to connect decentralised finance with traditional finance, regulatory perspectives, and the Cambridge DeFi Navigator.", "Il Cambridge Centre for Alternative Finance ha sviluppato una classificazione dei protocolli DeFi che aiuta a confrontarli con i servizi della finanza tradizionale e a esaminarli dal punto di vista normativo. È alla base del Cambridge DeFi Navigator."),
    tags: ["DeFi", "TradFi", t("Taxonomy", "Tassonomia"), t("Digital assets", "Asset digitali"), "CCAF"],
  },
  {
    title:
      t("An Entropy-Based Approach to Evaluating the Economic Efficiency of Cryptocurrencies", "Misurare l’efficienza economica delle criptovalute con l’entropia"),
    badge: "DLT '25",
    href: "/research/entropy-based-economic-efficiency",
    desc: t("Research introducing an entropy-based index to evaluate the economic efficiency of cryptocurrencies through on-chain attributes, user participation, supply dynamics, and transfer activity.", "Un indice basato sull’entropia valuta l’efficienza economica delle criptovalute usando dati registrati sulla blockchain, tra cui partecipazione degli utenti, andamento dell’offerta e trasferimenti."),
    tags: [
      t("Cryptocurrency efficiency", "Efficienza delle criptovalute"),
      t("Shannon entropy", "Entropia di Shannon"),
      t("Economic index", "Indice economico"),
      "Coin Metrics",
    ],
  },
  {
    title:
      t("Blockchain Energy Consumption: Unveiling the Impact of Network Topologies", "Come la topologia di rete incide sui consumi delle blockchain"),
    badge: "IEEE ICBC '25",
    href: "/research/performance-energy-economic-efficiency",
    desc: t("Peer-reviewed research on how network topology, workload type, and blockchain design affect energy consumption and energy per transaction.", "Lo studio confronta i consumi complessivi e l’energia per transazione al variare della topologia, del carico e della piattaforma blockchain."),
    tags: [
      t("Blockchain energy", "Consumi energetici delle blockchain"),
      t("Network topology", "Topologia di rete"),
      "RAPL",
      t("Energy per transaction", "Energia per transazione"),
    ],
  },
  {
    title: t("Impact of Network Topologies on Blockchain Performance", "L’effetto delle topologie di rete sulle prestazioni delle blockchain"),
    badge: "ACM DEBS '25",
    href: "/research/topology-aware-blockchain-benchmarking",
    desc: t("Peer-reviewed research on how network topology affects blockchain performance under controlled, reproducible, and cloud-inspired experimental conditions.", "Lo studio misura quanto la topologia incida sulle prestazioni delle blockchain riproducendo in laboratorio condizioni di rete tipiche del cloud."),
    tags: [
      t("Blockchain benchmarking", "Benchmarking delle blockchain"),
      t("Network topology", "Topologia di rete"),
      "Lilith",
      t("Reproducibility", "Riproducibilità"),
    ],
  },
];

const artifacts = [
  {
    title: t("Lilith - A Topology-Aware Blockchain Benchmarking Framework", "Lilith – Strumenti per confrontare blockchain in reti controllate"),
    badge: t("Artifact", "Materiali di ricerca"),
    href: "/research/lilith-benchmarking-framework",
    desc: t("Public GitHub research artifact supporting topology-aware blockchain benchmarking, workload execution, network emulation, local validation, Git LFS-backed datasets, and reproducible experimental analysis.", "Lilith automatizza gli esperimenti: genera ed esegue i carichi, emula la rete e aiuta a riprodurre le analisi. Su GitHub sono disponibili il codice, gli strumenti di verifica locale e i riferimenti ai dati gestiti con Git LFS."),
    tags: [
      "Framework",
      "GitHub",
      "Benchmarking",
      t("Network emulation", "Emulazione di rete"),
      t("Reproducibility", "Riproducibilità"),
    ],
  },
  {
    title: t("CryptoEntropy - Economic Efficiency Dataset", "CryptoEntropy – Dataset sull’efficienza economica"),
    badge: t("Dataset / Tool", "Dataset e strumento"),
    href: "/research/entropy-based-economic-efficiency",
    desc: t("Public normalized and entropy-derived cryptocurrency datasets supporting the DLT '25 EB-index paper, with documentation, citation metadata, reproducible plotting material, and an interactive dashboard.", "I dati elaborati per l’articolo DLT ’25 sono pubblici. Trovi anche la documentazione, le indicazioni per citare il dataset, il codice per riprodurre i grafici e uno strumento interattivo."),
    tags: [
      "Dataset",
      "EB-index",
      t("Cryptocurrency efficiency", "Efficienza delle criptovalute"),
      "Coin Metrics",
      t("Interactive dashboard", "Dashboard interattiva"),
    ],
  },
  {
    title:
      t("Network-Controlled Dataset of Blockchain Benchmarks for Evaluating Repeatability and Performance Predictability", "Dataset per studiare la ripetibilità e la prevedibilità dei benchmark blockchain"),
    badge: "Dataset",
    href: "/research/blockchain-repeatability-dataset",
    desc: t("Public dataset of 300 aggregate configurations for evaluating blockchain benchmark repeatability and performance predictability across five platforms, five network topologies, six workloads, and two network sizes.", "Risultati aggregati di 300 configurazioni per studiare quanto siano ripetibili i benchmark e prevedibili le prestazioni. Il dataset comprende cinque piattaforme, cinque topologie, sei carichi di lavoro e reti di due dimensioni."),
    tags: [
      "Dataset",
      t("Repeatability", "Ripetibilità"),
      t("Performance predictability", "Prevedibilità delle prestazioni"),
      t("Experimental analysis", "Analisi sperimentale"),
    ],
  },
];

const academicTheses = [
  {
    title: t("Comparing Blockchains: Performance, Energy, and Economic Efficiencies", "Confrontare le blockchain: prestazioni, consumi ed efficienza economica"),
    badge: t("PhD thesis", "Tesi di dottorato"),
    href: "/research/comparing-blockchains",
    desc: t("Doctoral dissertation presenting a multidimensional comparison of blockchain systems across performance, energy consumption, experimental repeatability, performance predictability, and economic efficiency.", "La tesi confronta prestazioni, consumi ed efficienza economica delle blockchain e studia quanto siano ripetibili e prevedibili i risultati."),
    tags: [
      t("PhD thesis", "Tesi di dottorato"),
      t("Blockchain systems", "Sistemi blockchain"),
      t("Network topology", "Topologia di rete"),
      t("Repeatability", "Ripetibilità"),
      t("Energy", "Energia"),
      t("Economic efficiency", "Efficienza economica"),
    ],
  },
  {
    title:
      t("Decentralized accounting system: Efficient document management system implemented on top of blockchain secure transactions environment", "Contabilità decentralizzata e gestione dei documenti su blockchain"),
    badge: t("Master's thesis", "Tesi magistrale"),
    href: "/research/decentralized-accounting-system",
    desc: t("Master's thesis on an efficient document-management and accounting system implemented with blockchain transactions, Solid Pods, MetaMask, QR codes, and eBill-inspired workflows.", "Un prototipo di contabilità e gestione dei documenti che usa Solid Pods, MetaMask, codici QR e transazioni su blockchain. La fatturazione si ispira a eBill."),
    tags: [
      "Ethereum",
      "Solid Pods",
      t("Document management", "Gestione documentale"),
      t("SME accounting", "Contabilità per PMI"),
      t("Prototype", "Prototipo"),
    ],
  },
  {
    title: "Threat Modeling Process: Strumenti per la gestione del processo di modellamento delle minacce",
    badge: t("Bachelor's thesis", "Tesi triennale"),
    href: "/theses/bachelor-thesis-threat-modeling-process.pdf",
    external: true,
    desc: t("Bachelor's thesis on threat modeling, secure software development, threat intelligence, monitoring tools, log analysis, visualization, containerization, and security-oriented infrastructure.", "Tesi sulla modellazione delle minacce e sullo sviluppo sicuro, con approfondimenti su threat intelligence, monitoraggio, analisi dei log, visualizzazione e container."),
    tags: [
      t("Threat modeling", "Modellazione delle minacce"),
      t("Cybersecurity", "Sicurezza informatica"),
      t("Monitoring", "Monitoraggio"),
      "Docker",
      "Kubernetes",
    ],
  },
];
---

<BaseLayout
  title={t("Blockchain Research and Publications | Vincenzo Di Perna", "Ricerca e pubblicazioni sulle blockchain | Vincenzo Di Perna")}
  description={t("Explore CIRCULA’s research on blockchain expiry and renewal, plus previous publications and datasets on network topology, energy use, economic efficiency and DeFi.", "CIRCULA e la ricerca sulla scadenza e sul rinnovo nelle blockchain. Pubblicazioni e dati su topologie di rete, consumi energetici, efficienza economica e DeFi.")}
  sideBarActiveItemID="research"
>
  <section class="mb-10">
    <h1 class="text-4xl font-bold mb-4">{t("Research", "Ricerca")}</h1>

    <div class="intro-copy space-y-3 text-lg leading-relaxed opacity-90">
      <p>{t("During my PhD, I studied how network topology and workload affected blockchain performance and energy use. I used realistic network topologies in a controlled environment to measure how results varied across runs and how repeatable and predictable they were. I also studied the economic efficiency of cryptocurrencies.", "Durante il dottorato ho studiato come topologia di rete e carico di lavoro incidessero sulle prestazioni e sui consumi delle blockchain. Ho usato topologie realistiche in un ambiente controllato per capire quanto variassero i risultati da una prova all’altra e quanto fossero ripetibili e prevedibili. Mi sono occupato anche dell’efficienza economica delle criptovalute.")}</p>
      <p>{t("My next line of research is CIRCULA. We will study how blockchains can represent and enforce expiry and renewal for digital resources.", "Con CIRCULA apro un nuovo filone di ricerca. Studieremo come definire e applicare regole di scadenza e rinnovo per le risorse digitali nelle blockchain.")}</p>
    </div>
  </section>

  <section class="mb-12"><h2 id="research-direction" class="text-3xl font-bold mb-5">{t("Research direction", "Nuovo filone di ricerca")}</h2>
    <article class="network-protected card bg-base-100 shadow-md"><div class="card-body">
  <div class="flex flex-wrap items-center gap-2"><h3 class="card-title">{t("CIRCULA - Expiry-Aware System Design for Blockchains", "CIRCULA – Scadenza e rinnovo delle risorse nelle blockchain")}</h3><span class="badge badge-primary">{t("Expected start · 1 February 2027", "Avvio previsto · 1° febbraio 2027")}</span></div>
  <p>{t("What if digital resources had an explicit lifetime? CIRCULA will investigate expiry and renewal in blockchain systems through formal semantics, prototypes and controlled evaluation. The project is funded by the SNSF and hosted at the University of Neuchâtel.", "Che cosa succede quando una risorsa digitale ha una data di scadenza? CIRCULA studierà come rappresentare e verificare scadenza e rinnovo con modelli formali, prototipi ed esperimenti controllati. Il progetto è ospitato dall’Università di Neuchâtel e finanziato dal Fondo nazionale svizzero.")}</p>
  
  <div class="card-actions mt-3"><a class="btn btn-sm btn-primary" href={localPath("/research/circula")}>{t("Explore CIRCULA", "Scopri CIRCULA")}</a><a class="btn btn-sm btn-outline" href="https://circula.unine.ch/" target="_blank" rel="noopener noreferrer">{t("Project website", "Sito del progetto")}</a></div>
</div></article>
  </section>

  <section class="mb-12">
    <h2 id="publications" class="text-3xl font-bold mb-5">{t("Publications", "Pubblicazioni")}</h2>

    <div class="grid gap-5">
      {
        publications.map((item) => (
          <a
            href={localPath(item.href)}
            class="network-protected card bg-base-100 shadow-md transition ease-in-out hover:shadow-2xl hover:scale-[101%]"
          >
            <article class="card-body">
              <div class="flex flex-wrap gap-2 items-center">
                <h3 class="card-title">{item.title}</h3>
                <span class="badge badge-secondary">{item.badge}</span>
              </div>

              <p>{item.desc}</p>

              <div class="flex flex-wrap gap-2 mt-2">
                {item.tags.map((tag) => (
                  <span class="badge badge-outline">{tag}</span>
                ))}
              </div>

              <div class="card-actions justify-end mt-4">
                <span class="btn btn-sm btn-outline">{t("Open research page", "Approfondisci lo studio")}</span>
              </div>
            </article>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mb-12">
    <h2 id="artifacts-and-datasets" class="text-3xl font-bold mb-5">{t("Artifacts & Datasets", "Materiali e dataset")}</h2>

    <div class="grid gap-5">
      {
        artifacts.map((item) =>
          item.disabled ? (
            <article class="network-protected card bg-base-100 shadow-md opacity-80">
              <div class="card-body">
                <div class="flex flex-wrap gap-2 items-center">
                  <h3 class="card-title">{item.title}</h3>
                  <span class="badge badge-secondary">{item.badge}</span>
                  <span class="badge badge-warning">{item.status}</span>
                </div>

                <p>{item.desc}</p>

                <div class="flex flex-wrap gap-2 mt-2">
                  {item.tags.map((tag) => (
                    <span class="badge badge-outline">{tag}</span>
                  ))}
                </div>

                <div class="card-actions justify-end mt-4">
                  <span class="btn btn-sm btn-disabled">{t("Page not available yet", "Pagina in preparazione")}</span>
                </div>
              </div>
            </article>
          ) : (
            <a
              href={localPath(item.href)}
              class="network-protected card bg-base-100 shadow-md transition ease-in-out hover:shadow-2xl hover:scale-[101%]"
            >
              <article class="card-body">
                <div class="flex flex-wrap gap-2 items-center">
                  <h3 class="card-title">{item.title}</h3>
                  <span class="badge badge-secondary">{item.badge}</span>
                </div>

                <p>{item.desc}</p>

                <div class="flex flex-wrap gap-2 mt-2">
                  {item.tags.map((tag) => (
                    <span class="badge badge-outline">{tag}</span>
                  ))}
                </div>

                <div class="card-actions justify-end mt-4">
                  <span class="btn btn-sm btn-outline">{t("Open artifact page", "Vai alla risorsa")}</span>
                </div>
              </article>
            </a>
          )
        )
      }
    </div>
  </section>

  <section class="mb-12">
    <h2 id="theses" class="text-3xl font-bold mb-5">{t("Academic Theses", "Tesi")}</h2>

    <div class="grid gap-5">
      {
        academicTheses.map((item) =>
          item.disabled ? (
            <article class="network-protected card bg-base-100 shadow-md opacity-80">
              <div class="card-body">
                <div class="flex flex-wrap gap-2 items-center">
                  <h3 class="card-title">{item.title}</h3>
                  <span class="badge badge-secondary">{item.badge}</span>
                  <span class="badge badge-warning">{item.status}</span>
                </div>

                <p>{item.desc}</p>

                <div class="flex flex-wrap gap-2 mt-2">
                  {item.tags.map((tag) => (
                    <span class="badge badge-outline">{tag}</span>
                  ))}
                </div>

                <div class="card-actions justify-end mt-4">
                  <span class="btn btn-sm btn-disabled">{t("Page not available yet", "Pagina in preparazione")}</span>
                </div>
              </div>
            </article>
          ) : (
            <a
              href={localPath(item.href)}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class="network-protected card bg-base-100 shadow-md transition ease-in-out hover:shadow-2xl hover:scale-[101%]"
            >
              <article class="card-body">
                <div class="flex flex-wrap gap-2 items-center">
                  <h3 class="card-title">{item.title}</h3>
                  <span class="badge badge-secondary">{item.badge}</span>
                </div>

                <p>{item.desc}</p>

                <div class="flex flex-wrap gap-2 mt-2">
                  {item.tags.map((tag) => (
                    <span class="badge badge-outline">{tag}</span>
                  ))}
                </div>

                <div class="card-actions justify-end mt-4">
                  <span class="btn btn-sm btn-outline">
                    {item.external ? t("Open thesis PDF", "Apri la tesi in PDF") : t("Open thesis page", "Vai alla tesi")}
                  </span>
                </div>
              </article>
            </a>
          )
        )
      }
    </div>
  </section>

  <section class="mb-12">
    <h2 id="research-experience" class="text-3xl font-bold mb-5">{t("Research Experience", "Esperienza di ricerca")}</h2>

    <a
      href={localPath("/research/ccaf-experience")}
      class="network-protected card bg-base-100 shadow-md transition ease-in-out hover:shadow-2xl hover:scale-[101%]"
    >
      <article class="card-body">
        <div class="flex flex-wrap gap-2 items-center">
          <h3 class="card-title">
            {t("Digital Asset Programme Intern", "Tirocinio nel Digital Asset Programme")}
          </h3>
          <span class="badge badge-secondary">CCAF</span>
        </div>

        <p>
          {t("Research internship experience at the Cambridge Centre for Alternative Finance, within the Digital Asset Programme, connected to digital assets, DeFi taxonomy, TradFi integration, protocol classification, and the Cambridge DeFi Navigator.", "Durante il tirocinio al Cambridge Centre for Alternative Finance ho lavorato alla classificazione dei protocolli DeFi e al loro confronto con i servizi della finanza tradizionale, nell’ambito del Digital Asset Programme. Il lavoro è collegato al Cambridge DeFi Navigator.")}
        </p>

        <div class="flex flex-wrap gap-2 mt-2">
          <span class="badge badge-outline">Digital Asset Programme</span>
          <span class="badge badge-outline">DeFi</span>
          <span class="badge badge-outline">TradFi</span>
          <span class="badge badge-outline">{t("Taxonomy", "Tassonomia")}</span>
          <span class="badge badge-outline">DeFi Navigator</span>
        </div>

        <div class="card-actions justify-end mt-4">
          <span class="btn btn-sm btn-outline">{t("Open experience page", "Leggi dell’esperienza al CCAF")}</span>
        </div>
      </article>
    </a>
  </section>
</BaseLayout>
