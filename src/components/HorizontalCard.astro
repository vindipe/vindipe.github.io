---
import { getLocale, inLanguage } from "../i18n/locale";

const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;

const hasUrl = typeof url === "string" && url.length > 0;
const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<div
  class:list={[
    "network-protected rounded-lg bg-base-100 shadow-md transition ease-in-out",
    hasUrl ? "hover:shadow-2xl hover:scale-[102%]" : "",
  ]}
>
  {
    hasUrl ? (
      <a href={inLanguage(url, getLocale(Astro.url.pathname))} target={target} rel={rel} class="block">
        <div class="hero-content flex-col md:flex-row">
          {
            img && (
              <img
                src={img}
                alt="" decoding="async"
                width="750"
                height="422"
                loading="lazy"
                class="w-full md:w-52 h-auto shrink-0 aspect-video rounded-lg object-cover"
              />
            )
          }

          <div class="grow w-full">
            <h3 class="text-xl font-bold">
              {title}
              {badge && <span class="badge badge-secondary mx-2">{badge}</span>}
            </h3>

            <p class="py-1 text-1xl">{desc}</p>

            <div class="card-actions justify-end">
              {
                tags &&
                  tags.map((tag) => (
                    <span class="badge badge-outline">{tag}</span>
                  ))
              }
            </div>
          </div>
        </div>
      </a>
    ) : (
      <div class="hero-content flex-col md:flex-row">
        {
          img && (
            <img
              src={img}
              alt="" decoding="async"
              width="750"
              height="422"
              loading="lazy"
              class="w-full md:w-52 h-auto shrink-0 aspect-video rounded-lg object-cover"
            />
          )
        }

        <div class="grow w-full">
          <h3 class="text-xl font-bold">
            {title}
            {badge && <span class="badge badge-secondary mx-2">{badge}</span>}
          </h3>

          <p class="py-1 text-1xl">{desc}</p>

          <div class="card-actions justify-end">
            {
              tags &&
                tags.map((tag) => (
                  <span class="badge badge-outline">{tag}</span>
                ))
            }
          </div>
        </div>
      </div>
    )
  }
</div>
