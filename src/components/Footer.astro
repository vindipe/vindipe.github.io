---
import { getLocale, inLanguage, translator } from "../i18n/locale";
const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
---

<footer class="footer footer-center p-4 bg-primary text-primary-content text-sm">
  <div>
    <a class="link link-hover" href={inLanguage("/privacy", locale)}>
      {t("Privacy & analytics", "Privacy e dati di navigazione")}
    </a>
  </div>
</footer>
