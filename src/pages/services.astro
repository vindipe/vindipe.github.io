---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
const language = locale === "it" ? "it-IT" : "en-US";

const skills = [
  {
    name: t("Web development", "Sviluppo web"),
    detail: t("Interfaces, responsive layouts and deployment.", "Interfacce, layout per mobile e desktop, messa online."),
  },
  {
    name: t("Programming and automation", "Programmazione e automazione"),
    detail: t("Scripts, integrations and AI tools.", "Script, integrazione tra strumenti e uso dell’IA."),
  },
  {
    name: t("Experiments and data analysis", "Sperimentazione e analisi dei dati"),
    detail: t("Test design, measurement and interpretation.", "Progettazione dei test, misurazione e lettura dei risultati."),
  },
  {
    name: t("Teaching and mentoring", "Formazione e affiancamento"),
    detail: t("Technical explanations, hands-on exercises and code review.", "Spiegazioni tecniche, esercizi pratici e revisione del codice."),
  },
];

const services = [
  {
    id: "consulting",
    name: t("Technical consulting", "Consulenza tecnica"),
    detail: t("Evaluate a technology choice or work through a specific problem.", "Valutare una scelta tecnica o affrontare un problema concreto."),
    rates: { EUR: 55, USD: 65 },
  },
  {
    id: "mentoring",
    name: "Mentoring",
    detail: t("Plan your next steps and get feedback as you build your own project.", "Impostare i prossimi passi e ricevere un riscontro mentre lavori al tuo progetto."),
    rates: { EUR: 45, USD: 50 },
  },
  {
    id: "tutoring",
    name: t("Tutoring", "Tutoraggio"),
    detail: t("One-to-one lessons in programming, AI tools or blockchain.", "Lezioni individuali su programmazione, strumenti di IA o blockchain."),
    rates: { EUR: 35, USD: 40 },
  },
  {
    id: "website",
    name: t("Website development", "Realizzazione di siti web"),
    detail: t("Build a website, add a page or improve an existing site.", "Creare un sito, aggiungere una pagina o migliorare un sito esistente."),
    rates: { EUR: 50, USD: 60 },
  },
];

const currencies = ["EUR", "USD"] as const;
const formatRate = new Intl.NumberFormat(language, {
  style: "currency", currency: "EUR", currencyDisplay: "narrowSymbol", maximumFractionDigits: 0,
});
const websiteRate = services.find((service) => service.id === "website")!.rates;
const example = {
  fixed: { EUR: 500, USD: 600 },
  stages: [
    { label: t("Structure and layout", "Struttura e layout"), manual: 2, assisted: 0.5 },
    { label: t("Build and add content", "Sviluppo e inserimento dei contenuti"), manual: 4, assisted: 1 },
    { label: t("Checks and deployment", "Verifiche e messa online"), manual: 2, assisted: 0.5 },
  ],
};
const manualHours = example.stages.reduce((sum, stage) => sum + stage.manual, 0);
const assistedHours = example.stages.reduce((sum, stage) => sum + stage.assisted, 0);
const assistedTotal = { EUR: assistedHours * websiteRate.EUR, USD: assistedHours * websiteRate.USD };
const saving = { EUR: example.fixed.EUR - assistedTotal.EUR, USD: example.fixed.USD - assistedTotal.USD };
const savingPercent = Math.round(saving.EUR / example.fixed.EUR * 100);
const formatHours = (hours: number) => new Intl.NumberFormat(language).format(hours) + " h";
const appointmentHours = [[9, 12], [14, 17]];
const slots = appointmentHours.map(([start, end]) => (
  Array.from({ length: (end - start) * 2 }, (_, index) => {
    const hour = String(start + Math.floor(index / 2)).padStart(2, "0");
    return `${hour}:${index % 2 === 0 ? "00" : "30"}`;
  })
));
const email = "vincenzopaolo.diperna@outlook.com";
const generalTopic = t("Discuss a project", "Parlare di un progetto");
---

<BaseLayout
  title={t("Freelancing | Independent services | Vincenzo Di Perna", "Freelancing | Servizi indipendenti | Vincenzo Di Perna")}
  description={t(
    "Independent technical consulting, mentoring, tutoring and web development. Explore hourly rates and request a free 30-minute call.",
    "Consulenza tecnica, mentoring, tutoraggio e sviluppo web come attività indipendente. Consulta le tariffe orarie e richiedi un colloquio gratuito di 30 minuti."
  )}
  sideBarActiveItemID="services"
>
  <freelancing-page class="studio" data-language={language} data-email={email} data-general-topic={generalTopic}>
    <header class="studio-header">
      <h1>Freelancing</h1>
      <p class="studio-lead">{t(
        "I build websites, help solve technical problems and teach one-to-one. I use AI where it saves time, and bill for the hours the work actually takes.",
        "Sviluppo siti web, risolvo problemi tecnici e faccio formazione individuale. Uso l’IA dove fa risparmiare tempo e fatturo le ore effettive di lavoro."
      )}</p>
      <a class="studio-link" href="#rates" data-astro-reload>{t("See hourly rates", "Vedi il tariffario")} <span aria-hidden="true">↓</span></a>
    </header>

    <section class="studio-section comparison" aria-labelledby="pricing">
      <div class="comparison-header">
        <div>
          <h2 id="pricing">{t("How much can an hour save?", "Quanto incide il tempo sul prezzo?")}</h2>
          <p>{t(
            "Example estimate for the same one-page site, with copy and images supplied, mobile checks and deployment.",
            "Esempio di stima per la stessa pagina web, con testi e immagini già pronti, verifica su mobile e messa online."
          )}</p>
        </div>
        <fieldset class="currency-switch">
          <legend class="sr-only">{t("Currency", "Valuta")}</legend>
          {currencies.map((currency) => (
            <label>
              <input class="sr-only" type="radio" name="studio-currency" value={currency} checked={currency === "EUR"} />
              <span>{currency}</span>
            </label>
          ))}
        </fieldset>
      </div>

      <div class="comparison-body">
        <div class="comparison-prices">
          <div class="comparison-price">
            <h3>{t("Without AI", "Senza IA")}</h3>
            <p>{t("Fixed project quote", "Preventivo a progetto")}</p>
            <strong data-rate data-eur={example.fixed.EUR} data-usd={example.fixed.USD}>{formatRate.format(example.fixed.EUR)}</strong>
            <span>{t("Estimated work", "Lavoro stimato")} · {formatHours(manualHours)}</span>
            <div class="time-track" aria-hidden="true"><span style="width: 100%"></span></div>
          </div>
          <div class="comparison-price comparison-offer">
            <h3>{t("My offer, with AI assistance", "La mia proposta, con l’aiuto dell’IA")}</h3>
            <p>{t("Hourly billing", "Pagamento a ore")}</p>
            <strong data-rate data-eur={assistedTotal.EUR} data-usd={assistedTotal.USD}>{formatRate.format(assistedTotal.EUR)}</strong>
            <span>{formatHours(assistedHours)} × <span data-rate data-eur={websiteRate.EUR} data-usd={websiteRate.USD}>{formatRate.format(websiteRate.EUR)}</span>{t("/hour", "/ora")}</span>
            <div class="time-track" aria-hidden="true"><span style={`width: ${assistedHours / manualHours * 100}%`}></span></div>
          </div>
        </div>

        <table class="comparison-table">
          <caption class="sr-only">{t("Estimated work by stage", "Stima delle ore per fase")}</caption>
          <thead>
            <tr>
              <th scope="col">{t("Work", "Fase")}</th>
              <th scope="col">{t("Without AI", "Senza IA")}</th>
              <th scope="col">{t("With AI", "Con IA")}</th>
            </tr>
          </thead>
          <tbody>
            {example.stages.map(({ label, manual, assisted }) => (
              <tr>
                <th scope="row">{label}</th>
                <td>{formatHours(manual)}</td>
                <td>{formatHours(assisted)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <p class="comparison-saving" aria-live="polite">
          <strong><span data-rate data-eur={saving.EUR} data-usd={saving.USD}>{formatRate.format(saving.EUR)}</span> {t("less", "in meno")} ({savingPercent}%)</strong>
          <span>{t("in this illustrative example", "in questo esempio indicativo")}</span>
        </p>
      </div>

      <p class="pricing-note">{t(
        "I use AI for drafts and repetitive steps, then review, test and deliver the work myself. We agree on an estimate and a spending limit up front. When the deliverables are clear, I can also quote a fixed price.",
        "Uso l’IA per le bozze e i passaggi ripetitivi. Mi occupo personalmente di revisione, test e consegna. Concordiamo in anticipo una stima e un limite di spesa. Per un incarico ben definito posso anche proporre un prezzo fisso."
      )}</p>
    </section>

    <section class="studio-section" aria-labelledby="rates">
      <div class="rate-heading">
        <div>
          <h2 id="rates">{t("Services and hourly rates", "Servizi e tariffe orarie")}</h2>
          <p>{t("Select a service to include it in your request. Rates are indicative.", "Seleziona un servizio per indicarlo nella richiesta. Le tariffe sono indicative.")}</p>
        </div>
        <fieldset class="currency-switch">
          <legend class="sr-only">{t("Rate currency", "Valuta del tariffario")}</legend>
          {currencies.map((currency) => (
            <label>
              <input class="sr-only" type="radio" name="rate-currency" value={currency} checked={currency === "EUR"} />
              <span>{currency}</span>
            </label>
          ))}
        </fieldset>
      </div>
      <fieldset class="service-list">
        <legend class="sr-only">{t("Choose a service", "Scegli un servizio")}</legend>
        {services.map((service) => (
          <label class="service-row">
            <input type="radio" name="studio-service" value={service.id} data-name={service.name} />
            <span class="service-text">
              <strong>{service.name}</strong>
              <span>{service.detail}</span>
            </span>
            <span class="rate-cell">
              <strong data-rate data-eur={service.rates.EUR} data-usd={service.rates.USD}>{formatRate.format(service.rates.EUR)}</strong>
              <span>{t("/ hour", "/ ora")}</span>
            </span>
          </label>
        ))}
      </fieldset>
    </section>

    <section class="studio-section skills" aria-labelledby="skills">
      <h2 id="skills">{t("Skills you can hire me for", "Competenze che metto a disposizione")}</h2>
      <p>{t(
        "Bring me in for one task or combine skills for a larger project. A website can include design, development and deployment. An experiment can include test design, automation and data analysis.",
        "Puoi coinvolgermi per una singola attività o combinare più competenze. Un sito può includere progettazione, sviluppo e pubblicazione. Un esperimento può richiedere la definizione dei test, l’automazione e l’analisi dei dati."
      )}</p>
      <dl class="skill-list">
        {skills.map(({ name, detail }) => (
          <div>
            <dt>{name}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <p class="studio-note">{t(
        "I offer these services independently of my job and academic research. Before accepting an assignment, I check for conflicts of interest and respect my professional and confidentiality obligations.",
        "Offro questi servizi come attività indipendente dal mio lavoro e dalla mia ricerca accademica. Prima di accettare un incarico, verifico eventuali conflitti di interesse e la compatibilità con i miei impegni professionali e di riservatezza."
      )}</p>
    </section>

    <section class="studio-section studio-booking" aria-labelledby="appointment">
      <div>
        <h2 id="appointment">{t("A free 30-minute call", "Un colloquio gratuito di 30 minuti")}</h2>
        <p>{t(
          "Tell me what you have in mind. We’ll discuss the work and how to price it.",
          "Raccontami cosa ti serve. Vediamo insieme cosa c’è da fare e come stimare il costo."
        )}</p>
      </div>
      <button class="btn btn-primary studio-cta" type="button" data-open-booking aria-haspopup="dialog" hidden>
        {t("Book an appointment", "Prenota un appuntamento")}
      </button>
      <noscript><a href={inLanguage("/contact/", locale)}>{t("Request an appointment by email", "Richiedi un appuntamento via email")}</a></noscript>
    </section>

    <dialog class="booking-dialog" aria-labelledby="booking-title" aria-describedby="booking-note">
      <div class="booking-header">
        <h3 id="booking-title">{t("Request a free appointment", "Richiedi un appuntamento gratuito")}</h3>
        <form method="dialog">
          <button class="btn btn-ghost btn-circle btn-sm" aria-label={t("Close", "Chiudi")}>×</button>
        </form>
      </div>
      <p class="booking-summary" data-booking-summary>{generalTopic}</p>
      <p id="booking-note">{t(
        "Choose a time for your free 30-minute call. I’ll confirm the appointment by email.",
        "Scegli un orario per il colloquio gratuito di 30 minuti. Ti confermerò l’appuntamento via email."
      )}</p>

      <form class="booking-form" data-booking-form data-subject={t("Freelancing · Free appointment request", "Freelancing · Richiesta appuntamento gratuito")}>
        <label class="booking-date">
          {t("Preferred date", "Data preferita")}
          <input class="input input-bordered" type="date" name="date" required />
        </label>
        <fieldset class="booking-times" aria-describedby="booking-timezone" disabled>
          <legend>{t("Start time", "Ora di inizio")}</legend>
          <p id="booking-timezone">{t(
            "Italy time (Europe/Rome) · 09:00–12:00 and 14:00–17:00",
            "Ora italiana (Europe/Rome) · 09:00–12:00 e 14:00–17:00"
          )}</p>
          {slots.map((times, index) => (
            <div class="slot-group" role="group" aria-label={index === 0 ? t("Morning", "Mattina") : t("Afternoon", "Pomeriggio")}>
              {times.map((time) => (
                <label class="slot">
                  <input type="radio" class="sr-only" name="time" value={time} required />
                  <span>{time}</span>
                </label>
              ))}
            </div>
          ))}
        </fieldset>
        <p class="studio-note" data-no-times hidden>{t(
          "Choose another date to see more times.",
          "Scegli un’altra data per vedere altri orari."
        )}</p>
        <button class="btn btn-primary" type="submit">{t("Open email", "Apri email")}</button>
      </form>
    </dialog>
  </freelancing-page>
</BaseLayout>

<script>
  const romeClock = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Rome",
    year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
  });

  class FreelancingPage extends HTMLElement {
    #initialized = false;

    connectedCallback() {
      if (this.#initialized) return;
      this.#initialized = true;

      const dialog = this.querySelector("dialog")!;
      const summary = dialog.querySelector<HTMLElement>("[data-booking-summary]")!;
      const form = dialog.querySelector<HTMLFormElement>("[data-booking-form]")!;
      const date = form.querySelector<HTMLInputElement>('[name="date"]')!;
      const timeGroup = form.querySelector<HTMLFieldSetElement>(".booking-times")!;
      const times = [...timeGroup.querySelectorAll<HTMLInputElement>('[name="time"]')];
      const noTimes = form.querySelector<HTMLElement>("[data-no-times]")!;
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const italian = this.dataset.language === "it-IT";

      const currencyInputs = this.querySelectorAll<HTMLInputElement>('.currency-switch input');
      const updateRates = (currency: string) => {
        for (const input of currencyInputs) input.checked = input.value === currency;
        const format = new Intl.NumberFormat(this.dataset.language, {
          style: "currency", currency, currencyDisplay: "narrowSymbol", maximumFractionDigits: 0,
        });
        for (const price of this.querySelectorAll<HTMLElement>("[data-rate]")) {
          price.textContent = format.format(Number(price.dataset[currency.toLowerCase()]));
        }
      };

      const updateTimes = () => {
        const parts = Object.fromEntries(romeClock.formatToParts(new Date()).map(({ type, value }) => [type, value]));
        const today = `${parts.year}-${parts.month}-${parts.day}`;
        const now = `${parts.hour}:${parts.minute}`;

        date.min = today;
        timeGroup.disabled = !date.value || !date.validity.valid;
        for (const time of times) {
          time.disabled = date.value === today && time.value <= now;
          if (time.disabled) time.checked = false;
        }
        const noneAvailable = times.every((time) => time.disabled);
        noTimes.hidden = !noneAvailable;
        submitButton.disabled = timeGroup.disabled || noneAvailable;
      };

      for (const input of currencyInputs) {
        input.addEventListener("change", () => updateRates(input.value));
      }
      updateRates(this.querySelector<HTMLInputElement>('[name="studio-currency"]:checked')!.value);

      const bookingButton = this.querySelector<HTMLButtonElement>("[data-open-booking]")!;
      bookingButton.hidden = false;
      bookingButton.addEventListener("click", () => {
        const service = this.querySelector<HTMLInputElement>('[name="studio-service"]:checked');
        summary.textContent = service?.dataset.name ?? this.dataset.generalTopic!;
        updateTimes();
        dialog.showModal();
      });

      date.addEventListener("change", updateTimes);
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        updateTimes();
        const time = times.find((slot) => slot.checked && !slot.disabled);
        if (!form.reportValidity() || !time) return;

        const body = italian
          ? `Ciao Vincenzo,\n\nvorrei richiedere un colloquio gratuito di 30 minuti.\nArgomento: ${summary.textContent}.\nData e ora preferite: ${date.value}, ${time.value} (Europe/Rome).\n\nIl mio progetto:\n\nGrazie!`
          : `Hi Vincenzo,\n\nI’d like to request a free 30-minute call.\nTopic: ${summary.textContent}.\nPreferred date and time: ${date.value}, ${time.value} (Europe/Rome).\n\nAbout my project:\n\nThank you!`;
        location.href = `mailto:${this.dataset.email}?subject=${encodeURIComponent(form.dataset.subject!)}&body=${encodeURIComponent(body)}`;
      });
    }
  }

  customElements.define("freelancing-page", FreelancingPage);
</script>

<style>
  .studio {
    display: block;
    width: min(53rem, 100%);
    margin-inline: auto;
    color: #232637;
  }

  .studio-header {
    max-width: 47rem;
    padding: clamp(1rem, 3vw, 2rem) 0 0.2rem;
  }

  .studio-header h1 {
    margin-bottom: 0.6rem;
    font-size: clamp(2.9rem, 8vw, 4.85rem);
    line-height: 1.02;
    letter-spacing: -0.065em;
    font-weight: 750;
  }

  .studio p, .studio dd { text-align: start; hyphens: none; }
  .studio-lead { max-width: 37rem; font-size: 1.13rem; line-height: 1.6; }
  .studio-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.85rem;
    padding: 0.25rem 0;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #a66c16;
    text-underline-offset: 0.2em;
  }
  .studio-note { margin-top: 0.65rem; font-size: 0.91rem; color: #505362; }

  .studio-section {
    margin-top: clamp(1.35rem, 4vw, 2rem);
    padding: clamp(1rem, 3vw, 1.45rem);
    border: 1px solid #dfe1e7;
    border-radius: 0.75rem;
    background: #fff;
  }

  .studio-section h2 {
    margin-bottom: 0.4rem;
    font-size: clamp(1.28rem, 4vw, 1.65rem);
    line-height: 1.2;
    font-weight: 750;
    letter-spacing: -0.035em;
  }

  .comparison { padding: 0; border-color: #262b3e; }
  .comparison-header, .comparison-body { padding-inline: clamp(1rem, 3.6vw, 1.55rem); }
  .comparison-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 0.6rem 1.2rem;
    flex-wrap: wrap;
    padding-block: clamp(1rem, 3vw, 1.4rem);
    border-radius: 0.7rem 0.7rem 0 0;
    background: #222738;
    color: #fff;
  }
  .comparison-header p { max-width: 35rem; color: #e0e3ec; font-size: 0.92rem; }
  .comparison-body { padding-block: 1rem; background: #f8f8fa; }
  .comparison-prices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.7rem; }
  .comparison-price {
    display: grid;
    grid-template-rows: auto auto 1fr auto auto;
    gap: 0.15rem;
    min-width: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid #dbdee7;
    border-radius: 0.45rem;
    background: #fff;
  }
  .comparison-price h3 { font-size: 1rem; line-height: 1.25; font-weight: 750; }
  .comparison-price p, .comparison-price > span { color: #505362; font-size: 0.85rem; }
  .comparison-price > strong {
    align-self: end;
    padding-block: 0.28rem;
    font-size: clamp(1.5rem, 4.7vw, 2.55rem);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.06em;
  }
  .comparison-offer { border-color: #d9b95f; background: #fff2c9; }
  .time-track { height: 0.25rem; margin-top: 0.45rem; background: #e4e5ea; }
  .time-track span { display: block; height: 100%; background: #52596f; }
  .comparison-offer .time-track { background: #ebdca9; }
  .comparison-offer .time-track span { background: #895600; }

  .comparison-table { width: 100%; margin-top: 0.85rem; border-collapse: collapse; font-size: 0.88rem; }
  .comparison-table :is(th, td) { padding: 0.32rem 0.25rem; border-bottom: 1px solid #e0e2e9; text-align: end; }
  .comparison-table :is(th, td):first-child { text-align: start; }
  .comparison-table :is(th, td):not(:first-child) { width: 22%; }
  .comparison-table tbody th { font-weight: 500; }
  .comparison-table td { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .comparison-saving { display: flex; gap: 0.2rem 0.45rem; flex-wrap: wrap; align-items: baseline; margin-top: 0.72rem; font-size: 0.9rem; }
  .comparison-saving strong { font-size: 1.1rem; color: #6c4609; }
  .pricing-note { padding: 0.85rem clamp(1rem, 3.6vw, 1.55rem); font-size: 0.92rem; }

  .rate-heading {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: 0.45rem 1rem;
    flex-wrap: wrap;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid #dfe1e7;
  }

  .currency-switch { display: inline-flex; gap: 0.15rem; }
  .currency-switch span, .slot span {
    display: block;
    padding: 0.4rem 0.55rem;
    border-radius: 0.25rem;
    text-align: center;
    font-size: 0.87rem;
    font-weight: 650;
    cursor: pointer;
  }

  .currency-switch input:checked + span, .slot input:checked + span {
    background: #ffdf73;
    color: #322507;
  }

  .currency-switch input:focus-visible + span, .slot input:focus-visible + span {
    outline: 2px solid #805000;
    outline-offset: 2px;
  }
  .comparison-header .currency-switch input:focus-visible + span { outline-color: #fff; }

  .service-list { min-width: 0; }
  .service-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.65rem;
    padding: 0.7rem 0.45rem;
    border-bottom: 1px solid #e3e5eb;
    cursor: pointer;
  }
  .service-row:last-child { border-bottom: 0; }
  .service-row:hover, .service-row:has(input:checked) { background: #fff8e2; }
  .service-row input { width: 1rem; height: 1rem; margin-top: 0.22rem; accent-color: #805000; }
  .service-text > span { display: block; color: #505362; font-size: 0.92rem; }
  .rate-cell { text-align: end; font-variant-numeric: tabular-nums; white-space: nowrap; }
