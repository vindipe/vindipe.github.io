---
import { translator } from "../../i18n/locale";
import LabGuide from "./LabGuide.astro";
import CryptoPlayground from "./tools/CryptoPlayground.astro";
import P2PNetworkPlayground from "./tools/P2PNetworkPlayground.astro";
import ConsensusGame from "./tools/ConsensusGame.astro";
import SmartContractSandbox from "./tools/SmartContractSandbox.astro";
import PublicPermissionedLab from "./tools/PublicPermissionedLab.astro";
import TokenOwnershipLab from "./tools/TokenOwnershipLab.astro";
import WalletKeysLab from "./tools/WalletKeysLab.astro";
import QuantumBlockchainLab from "./tools/QuantumBlockchainLab.astro";
import FeesScalabilityLab from "./tools/FeesScalabilityLab.astro";

const t = translator(Astro.url.pathname);


const labs = [
  {
    id: "crypto",
    title: t("Cryptography playground", "Laboratorio di crittografia"),
    status: t("Playable", "Interattivo"),
    desc: t("Understand hashing, tamper detection, and why blocks can be linked through cryptographic fingerprints.", "Scopri come funzionano gli hash, come rilevare alterazioni e come collegare blocchi tramite impronte crittografiche."),
    tags: [t("Hashing", "Calcolo degli hash"), t("Tamper detection", "Rilevamento delle alterazioni"), t("Block links", "Collegamenti tra blocchi")],
  },
  {
    id: "wallets",
    title: t("Wallets, keys & ownership", "Wallet, chiavi e proprietà"),
    status: t("Playable", "Interattivo"),
    desc: t("See how private keys, public keys, addresses, and signatures connect users to blockchain assets.", "Scopri come chiavi private, chiavi pubbliche, indirizzi e firme collegano gli utenti agli asset su blockchain."),
    tags: [t("Wallets", "Wallet"), t("Keys", "Chiavi"), t("Signatures", "Firme")],
  },
  {
    id: "p2p",
    title: t("P2P network simulator", "Simulatore di rete P2P"),
    status: t("Playable", "Interattivo"),
    desc: t("Move nodes, remove peers, split the network, and broadcast a transaction across a distributed network.", "Sposta o rimuovi nodi, dividi la rete e propaga una transazione in un sistema distribuito."),
    tags: [t("Nodes", "Nodi"), t("Links", "Collegamenti"), t("Propagation", "Propagazione")],
  },
  {
    id: "consensus",
    title: t("Consensus game", "Gioco del consenso"),
    status: t("Playable", "Interattivo"),
    desc: t("Simulate validators voting on blocks and see why failures, delays, and quorum thresholds matter.", "Simula il voto dei validatori sui blocchi e osserva l’effetto di guasti, ritardi e soglie di quorum."),
    tags: [t("Validators", "Validatori"), t("Votes", "Voti"), t("Finality", "Finalità")],
  },
  {
    id: "smart-contract",
    title: t("Smart contract sandbox", "Laboratorio di smart contract"),
    status: t("Playable", "Interattivo"),
    desc: t("Interact with a tiny contract state machine to understand balances, rules, and deterministic execution.", "Prova una piccola macchina a stati per capire saldi, regole ed esecuzione deterministica."),
    tags: [t("State", "Stato"), t("Rules", "Regole"), t("Execution", "Esecuzione")],
  },
  {
    id: "permissioned",
    title: t("Public vs permissioned networks", "Reti pubbliche e ad accesso riservato"),
    status: t("Playable", "Interattivo"),
    desc: t("Compare open and controlled blockchain networks by changing who can join, validate, read, and govern.", "Confronta reti aperte e ad accesso controllato cambiando chi può partecipare, convalidare, leggere e decidere."),
    tags: [t("Access", "Accesso"), "Governance", t("Validation", "Convalida")],
  },
  {
    id: "tokens",
    title: t("Tokens, incentives & ownership", "Token, incentivi e proprietà"),
    status: t("Playable", "Interattivo"),
    desc: t("Explore token distribution, rewards, concentration, and how incentives can affect ownership structures.", "Esplora distribuzione, ricompense e concentrazione dei token. Osserva come gli incentivi cambiano la proprietà."),
    tags: ["Tokenomics", t("Incentives", "Incentivi"), t("Concentration", "Concentrazione")],
  },
  {
    id: "fees",
    title: t("Fees, blockspace & scalability", "Commissioni, capacità dei blocchi e scalabilità"),
    status: t("Playable", "Interattivo"),
    desc: t("Experiment with transaction demand, block capacity, fees, congestion, and throughput limits.", "Varia la domanda di transazioni, la capacità dei blocchi e le commissioni. Osserva la congestione e i limiti di throughput."),
    tags: [t("Fees", "Commissioni"), t("Blockspace", "Spazio nei blocchi"), t("Scalability", "Scalabilità")],
  },
  {
    id: "quantum",
    title: t("Quantum & blockchain impact", "Calcolo quantistico e blockchain"),
    status: t("Playable", "Interattivo"),
    desc: t("Understand what quantum computing could affect, what it would not magically break, and why post-quantum migration matters.", "Scopri quali componenti della blockchain potrebbe influenzare il calcolo quantistico e perché conta la migrazione post-quantistica."),
    tags: [t("Quantum", "Calcolo quantistico"), t("Signatures", "Firme"), "PQC"],
  },
];
---

<section id="blockchain-interactive-labs" class="mb-12">
  <h2 class="text-3xl font-bold mb-2">{t("Blockchain fundamentals - interactive labs", "Fondamenti delle blockchain – Laboratori interattivi")}</h2>

  <p class="mb-5 opacity-80">
    {t("Select a topic to open its guided interactive tool below. Each lab explains where the concept appears inside a blockchain, how to use the simulator, what to observe, and what to explore next.", "Scegli un argomento per aprire il simulatore guidato. Ogni laboratorio spiega dove entra in gioco il concetto, come provarlo, che cosa osservare e come proseguire.")}
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mb-6">
    {
      labs.map((lab, index) => (
        <button
          type="button"
          class:list={[
            "network-protected card bg-base-100 shadow-md text-left transition hover:shadow-2xl hover:scale-[101%]",
            index === 0 ? "ring-2 ring-primary" : "",
          ]}
          data-lab-card={lab.id}
          aria-expanded={index === 0 ? "true" : "false"}
        >
          <div class="card-body">
            <div class="flex flex-wrap gap-2 items-center">
              <h3 class="card-title">{lab.title}</h3>
              <span class="badge badge-secondary">{lab.status}</span>
            </div>

            <p>{lab.desc}</p>

            <div class="card-actions justify-end mt-2">
              {lab.tags.map((tag) => (
                <span class="badge badge-outline">{tag}</span>
              ))}
            </div>
          </div>
        </button>
      ))
    }
  </div>

  <div class="rounded-2xl border border-base-300 bg-base-200 p-3 md:p-5">
    <div data-lab-panel="crypto">
      <LabGuide
        title={t("Cryptography playground", "Laboratorio di crittografia")}
        context={t("Blockchains use cryptographic hashes to fingerprint data and digital signatures to prove that an action was authorized by the holder of a private key.", "Le blockchain usano gli hash come impronte crittografiche dei dati e le firme digitali per dimostrare che il titolare di una chiave privata ha autorizzato un’azione.")}
        howToPlay={t("Edit the transaction text, compute its hash, mine a toy block, and then tamper with the data.", "Modifica il testo della transazione, calcola l’hash, mina un blocco dimostrativo e poi alterane i dati.")}
        observe={t("A tiny input change produces a completely different hash. This is why tampering becomes visible when blocks and transactions are fingerprinted.", "Una modifica minima produce un hash completamente diverso. Le impronte crittografiche rendono quindi visibili le alterazioni di blocchi e transazioni.")}
        nextStep={t("After hashes, open Wallets, keys & ownership to understand how users authorize transactions.", "Passa a Wallet, chiavi e proprietà per capire come si autorizzano le transazioni.")}
      />
      <CryptoPlayground />
    </div>

    <div data-lab-panel="wallets" hidden>
      <LabGuide
        title={t("Wallets, keys & ownership", "Wallet, chiavi e proprietà")}
        context={t("A wallet does not literally store coins. It manages keys. The private key authorizes actions, the public key helps verify signatures, and the address identifies an account or destination.", "Un wallet gestisce le chiavi. La chiave privata autorizza le operazioni, quella pubblica aiuta a verificare le firme e l’indirizzo identifica un conto o una destinazione.")}
        howToPlay={t("Generate a toy identity, sign a transaction, then try to verify it or tamper with the message.", "Genera un’identità dimostrativa, firma una transazione e prova a verificarla o a modificarne il messaggio.")}
        observe={t("The same signature only works for the original message and the matching public identity. If the message changes, verification fails.", "La firma è valida solo per il messaggio originale e l’identità pubblica corrispondente. Se modifichi il messaggio, la verifica fallisce.")}
        nextStep={t("After signatures, open Quantum & blockchain impact to see why future quantum computers matter for some signature schemes.", "Passa a Calcolo quantistico e blockchain per capire perché i futuri computer quantistici contano per alcuni schemi di firma.")}
      />
      <WalletKeysLab />
    </div>

    <div data-lab-panel="p2p" hidden>
      <LabGuide
        title={t("P2P network simulator", "Simulatore di rete P2P")}
        context={t("A blockchain network is a peer-to-peer system: transactions and blocks must propagate across many nodes before the network can converge on a shared view.", "Le transazioni e i blocchi si propagano da nodo a nodo in una rete peer-to-peer. Solo così la rete può convergere verso una visione condivisa.")}
        howToPlay={t("Select a node, drag nodes around, remove a node, create a partition, and broadcast a transaction.", "Seleziona e trascina i nodi, rimuovine uno, crea una partizione e invia una transazione.")}
        observe={t("Connectivity affects propagation. If nodes are offline or the network splits, some peers may not receive the transaction.", "La connettività determina la propagazione. Se dei nodi sono offline o la rete si divide, la transazione può non raggiungere tutti i nodi.")}
        nextStep={t("After propagation, open Consensus game to see how validators agree on blocks.", "Passa al Gioco del consenso per vedere come i validatori si accordano sui blocchi.")}
      />
      <P2PNetworkPlayground />
    </div>

    <div data-lab-panel="consensus" hidden>
      <LabGuide
        title={t("Consensus game", "Gioco del consenso")}
        context={t("Consensus protocols let distributed validators agree on which block becomes part of the chain, even when some validators are offline, delayed, or faulty.", "I protocolli di consenso permettono ai validatori di concordare quale blocco aggiungere alla catena anche quando alcuni sono offline, in ritardo o si comportano in modo anomalo.")}
        howToPlay={t("Toggle validators between honest, offline, and faulty states, then propose a block.", "Imposta i validatori come corretti, offline o guasti, poi proponi un blocco.")}
        observe={t("Finality requires enough valid votes. If too many validators fail, the block cannot be finalized.", "Un blocco diventa definitivo solo con un numero sufficiente di voti validi. Se troppi validatori non partecipano correttamente, la finalità non viene raggiunta.")}
        nextStep={t("After consensus, open Public vs permissioned networks to compare different validator-access models.", "Passa a Reti pubbliche e ad accesso riservato per confrontare chi può fare da validatore nei due modelli.")}
      />
      <ConsensusGame />
    </div>

    <div data-lab-panel="smart-contract" hidden>
      <LabGuide
        title={t("Smart contract sandbox", "Laboratorio di smart contract")}
        context={t("A smart contract is code that updates blockchain state according to predefined rules. Every node must be able to reproduce the same result.", "Uno smart contract aggiorna lo stato della blockchain secondo regole predefinite. Ogni nodo deve poter ottenere lo stesso risultato.")}
        howToPlay={t("Choose sender, receiver, and amount. Execute valid and invalid transfers.", "Scegli mittente, destinatario e importo. Prova trasferimenti validi e non validi.")}
        observe={t("The contract changes state only when its rules are satisfied. Invalid transactions are rejected.", "Lo stato cambia solo quando sono rispettate le regole del contratto. Le transazioni non valide vengono rifiutate.")}
        nextStep={t("After contract execution, open Fees, blockspace & scalability to understand why execution capacity is limited.", "Passa a Commissioni, capacità dei blocchi e scalabilità per capire perché la capacità di esecuzione è limitata.")}
      />
      <SmartContractSandbox />
    </div>

    <div data-lab-panel="permissioned" hidden>
      <LabGuide
        title={t("Public vs permissioned networks", "Reti pubbliche e ad accesso riservato")}
        context={t("Not all blockchains are open in the same way. Public systems prioritize open participation, while permissioned systems restrict who can join, validate, or read.", "Nelle blockchain pubbliche la partecipazione è aperta. In quelle ad accesso riservato ci sono regole su chi può entrare, convalidare o leggere.")}
        howToPlay={t("Switch between public and permissioned modes, then test joining, validating, and reading.", "Alterna la modalità pubblica e quella ad accesso riservato e prova a entrare, convalidare e leggere.")}
        observe={t("The trust model changes depending on who controls access and validation.", "Il modello di fiducia cambia in base a chi controlla l’accesso e la convalida.")}
        nextStep={t("After access models, open Tokens, incentives & ownership to see how economic power can concentrate.", "Passa a Token, incentivi e proprietà per vedere come si concentra il potere economico.")}
      />
      <PublicPermissionedLab />
    </div>

    <div data-lab-panel="tokens" hidden>
      <LabGuide
        title={t("Tokens, incentives & ownership", "Token, incentivi e proprietà")}
        context={t("Tokens can represent value, governance power, access rights, rewards, or ownership claims. Their distribution affects decentralization and economic power.", "I token possono rappresentare valore, potere decisionale, diritti di accesso, ricompense o proprietà. La loro distribuzione incide sulla decentralizzazione e sul potere economico.")}
        howToPlay={t("Trigger an equal airdrop, whale accumulation, or staking rewards.", "Prova una distribuzione uguale per tutti, l’accumulo da parte di un grande detentore o i premi per lo staking.")}
        observe={t("Some mechanisms preserve concentration, while others can spread or concentrate ownership.", "Alcuni meccanismi mantengono la concentrazione esistente, altri distribuiscono o concentrano la proprietà.")}
        nextStep={t("After ownership, open Fees, blockspace & scalability to see how demand and fees affect users.", "Passa a Commissioni, capacità dei blocchi e scalabilità per vedere come domanda e commissioni incidono sugli utenti.")}
      />
      <TokenOwnershipLab />
    </div>

    <div data-lab-panel="fees" hidden>
      <LabGuide
        title={t("Fees, blockspace & scalability", "Commissioni, capacità dei blocchi e scalabilità")}
        context={t("Blockchains have limited capacity. When transaction demand exceeds available blockspace, users compete through fees and some transactions are delayed.", "Quando le transazioni richieste superano lo spazio disponibile nei blocchi, gli utenti competono tramite le commissioni e alcune operazioni subiscono ritardi.")}
        howToPlay={t("Change transaction demand, block capacity, and average fee willingness.", "Modifica la domanda, la capacità dei blocchi e la commissione media che gli utenti sono disposti a pagare.")}
        observe={t("Congestion increases when demand exceeds capacity. Higher fee pressure can prioritize some transactions while pricing out others.", "Quando la domanda supera la capacità, la congestione cresce. Le commissioni più alte possono dare priorità ad alcune operazioni ed escluderne altre.")}
        nextStep={t("After fees, explore smart contracts or consensus again to connect execution, capacity, and finality.", "Torna agli smart contract o al consenso per collegare esecuzione, capacità e finalità.")}
      />
      <FeesScalabilityLab />
    </div>

    <div data-lab-panel="quantum" hidden>
      <LabGuide
        title={t("Quantum & blockchain impact", "Calcolo quantistico e blockchain")}
        context={t("Quantum computing would not automatically destroy every part of a blockchain. The main concern is that sufficiently powerful quantum computers could threaten some classical digital signature schemes, while hashes are affected differently.", "Computer quantistici abbastanza potenti potrebbero minacciare alcuni schemi di firma digitale classici. Gli hash risentono del calcolo quantistico in modo diverso.")}
        howToPlay={t("Switch between blockchain components and attacker scenarios to see which parts are exposed and which mitigations are possible.", "Cambia il componente e lo scenario per vedere quali parti sono esposte e come si possono proteggere.")}
        observe={t("Signatures, exposed public keys, validator keys, and migration strategy matter more than vague claims that quantum computers break all blockchain security.", "Osserva firme, chiavi pubbliche esposte, chiavi dei validatori e strategie di migrazione per capire quali rischi riguardano ciascun componente.")}
        nextStep={t("After this, revisit Wallets, keys & ownership and Cryptography playground to connect keys, signatures, hashes, and post-quantum migration.", "Torna a Wallet, chiavi e proprietà e al Laboratorio di crittografia per collegare chiavi, firme, hash e migrazione post-quantistica.")}
      />
      <QuantumBlockchainLab />
    </div>
  </div>
</section>

<script>
  function initBlockchainInteractiveLabs() {
    const root = document.querySelector("#blockchain-interactive-labs");

    if (!root || root.dataset.initialized === "true") {
      return;
    }

    root.dataset.initialized = "true";

    const cards = root.querySelectorAll("[data-lab-card]");
    const panels = root.querySelectorAll("[data-lab-panel]");

    function activateLab(labId) {
      cards.forEach((card) => {
        const isActive = card.getAttribute("data-lab-card") === labId;
        card.classList.toggle("ring-2", isActive);
        card.classList.toggle("ring-primary", isActive);
        card.setAttribute("aria-expanded", isActive ? "true" : "false");
      });

      panels.forEach((panel) => {
        panel.hidden = panel.getAttribute("data-lab-panel") !== labId;
      });
    }

    cards.forEach((card) => {
      card.addEventListener("click", () => {
        activateLab(card.getAttribute("data-lab-card"));
      });
    });
  }

  initBlockchainInteractiveLabs();

  if (!window.__blockchainInteractiveLabsPageLoadRegistered) {
    window.__blockchainInteractiveLabsPageLoadRegistered = true;
    document.addEventListener("astro:page-load", initBlockchainInteractiveLabs);
  }
</script>