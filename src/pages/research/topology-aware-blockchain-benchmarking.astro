---
import { getLocale, inLanguage, translator } from "../../i18n/locale";
import BaseLayout from "../../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const topologies = [
  {
    name: "Fat-tree",
    src: "/research/debs/topology-fat-tree.png",
    desc: t("A layered topology often associated with data-center-like infrastructures.", "Topologia a livelli comune nelle infrastrutture dei data center."),
  },
  {
    name: t("Full mesh", "Maglia completa"),
    src: "/research/debs/topology-full-mesh.png",
    desc: t("A dense topology where gateways are directly interconnected.", "Topologia densa in cui i gateway sono collegati direttamente."),
  },
  {
    name: t("Hypercube", "Ipercubo"),
    src: "/research/debs/topology-hypercube.png",
    desc: t("A structured topology inspired by parallel and distributed computing systems.", "Topologia strutturata ispirata ai sistemi di calcolo parallelo e distribuito."),
  },
  {
    name: t("Scale-free", "Rete a invarianza di scala"),
    src: "/research/debs/topology-scale-free.png",
    desc: t("A topology with highly connected hubs, resembling Internet-like networks.", "Topologia con nodi molto connessi, simile alla struttura di Internet."),
  },
  {
    name: t("Torus", "Toro"),
    src: "/research/debs/topology-torus.png",
    desc: t("A wrap-around grid topology often used in high-performance computing contexts.", "Griglia con collegamenti ai bordi opposti, usata nel calcolo ad alte prestazioni."),
  },
];

const dynamics = [
  {
    title: t("Packet drop", "Perdita di pacchetti"),
    src: "/research/debs/dynamic-packet-drop.png",
    desc: t("Stress scenario used to observe how blockchain systems react when packet loss increases.", "Test per osservare come reagiscono le blockchain quando si perde una quota maggiore di pacchetti."),
  },
  {
    title: t("Bandwidth congestion", "Congestione di rete"),
    src: "/research/debs/dynamic-bandwidth-congestion.png",
    desc: t("Stress scenario used to study the impact of constrained network capacity.", "Test per misurare l’effetto di una banda limitata."),
  },
  {
    title: t("Node crash", "Guasto di un nodo"),
    src: "/research/debs/dynamic-node-crash.png",
    desc: t("Stress scenario used to evaluate behaviour when part of the network becomes unavailable.", "Test per capire che cosa accade quando un nodo smette di rispondere."),
  },
];
---

<BaseLayout
  title={t("Blockchain Benchmarking with Lilith | ACM DEBS", "Benchmarking delle blockchain con Lilith | Vincenzo Di Perna")}
  description={t("ACM DEBS 2025 study on reproducible blockchain benchmarking with Lilith, realistic workloads and controlled network topologies.", "Studio ACM DEBS 2025 sul benchmarking riproducibile delle blockchain con Lilith, carichi realistici e topologie di rete controllate.")}
  sideBarActiveItemID="research"
>
  <section class="mb-8">
    <a href={localPath("/research")} class="btn btn-sm btn-outline mb-6">
      {t("← Back to Research", "← Torna alla ricerca")}
    </a>

    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <div class="flex flex-wrap gap-2 items-center mb-3">
          <h1 class="text-4xl font-bold">
            {t("Impact of Network Topologies on Blockchain Performance", "L’effetto delle topologie di rete sulle prestazioni delle blockchain")}
          </h1>
          <span class="badge badge-secondary">ACM DEBS '25</span>
          <span class="badge badge-outline">{t("Publication", "Pubblicazione")}</span>
        </div>

        <p class="text-lg leading-relaxed opacity-90">
          {t("This work studies how the underlying network topology affects blockchain performance. Instead of treating the network as a fixed or opaque execution layer, the paper evaluates multiple blockchain systems under controlled topologies, realistic workloads, and reproducible experimental conditions.", "Lo studio esamina come la topologia di rete influenzi le prestazioni delle blockchain. Confronta più sistemi in condizioni sperimentali riproducibili, usando topologie controllate e carichi di lavoro realistici.")}
        </p>

        <div class="flex flex-wrap gap-2 mt-5">
          <span class="badge badge-outline">{t("Blockchain benchmarking", "Benchmarking delle blockchain")}</span>
          <span class="badge badge-outline">{t("Network topology", "Topologia di rete")}</span>
          <span class="badge badge-outline">Lilith</span>
          <span class="badge badge-outline">Kollaps</span>
          <span class="badge badge-outline">Diablo</span>
          <span class="badge badge-outline">{t("Reproducibility", "Riproducibilità")}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">5</p>
          <p class="opacity-80">{t("blockchain systems", "sistemi blockchain")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">5</p>
          <p class="opacity-80">{t("network topologies", "topologie di rete")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">6</p>
          <p class="opacity-80">{t("workload families", "tipi di carico di lavoro")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">1</p>
          <p class="opacity-80">{t("benchmarking framework", "framework di benchmarking")}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="context" class="card-title text-2xl">{t("Context", "Contesto")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("Blockchain systems are usually evaluated through throughput, latency, commit rate, and resource consumption. However, those measurements can change significantly depending on the network conditions under which the blockchain is executed. Public clouds are useful for realistic deployments, but they also introduce cost, opacity, and time-dependent variability. This paper addresses that problem by combining reproducible cluster-based execution with programmable network emulation.", "Le prestazioni delle blockchain si misurano in throughput, latenza, tasso di conferma e consumo di risorse. Questi valori possono cambiare molto con le condizioni di rete. Il cloud offre scenari realistici, ma i costi e la variabilità rendono difficile ripetere gli esperimenti. Lo studio esegue quindi le prove su un cluster e riproduce condizioni di rete configurabili.")}
        </p>

        <p class="leading-relaxed opacity-90 mt-3">
          {t("The central idea is simple: to compare blockchains meaningfully, the evaluator must also control the shape and behaviour of the network in which validators, clients, and gateways communicate.", "Per confrontare le blockchain occorre controllare anche la rete su cui comunicano validatori, client e gateway.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <figure class="px-6 pt-6">
        <img
          src="/research/debs/aws-heatmap-comparison.png" width="3403" height="701" decoding="async"
          alt={t("AWS latency and throughput heatmap comparison used as motivation for controlled blockchain benchmarking.", "Mappe di calore della latenza e del throughput misurati su AWS.")}
          class="rounded-xl border border-base-300 bg-base-200"
          loading="lazy"
        />
      </figure>

      <div class="card-body">
        <h2 id="network-control" class="card-title text-2xl">{t("Why network control matters", "Perché controllare la rete")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The paper starts from a practical benchmarking problem: cloud network conditions vary across regions and over time. This makes blockchain experiments difficult to reproduce if the network layer is not explicitly modelled. The heatmap motivates the need for controlled experiments that can reproduce cloud-inspired latency and throughput conditions without depending entirely on live cloud variability.", "La latenza e il throughput del cloud cambiano fra regioni e nel tempo. Le mappe mostrano l’entità di queste variazioni. Con l’emulazione possiamo riprodurre condizioni simili in laboratorio e ripetere le prove.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <figure class="px-6 pt-6">
        <img
          src="/research/debs/lilith-arch-v2.png" width="1188" height="328" decoding="async"
          alt={t("Lilith architecture and execution flow integrating topology generation, Kollaps, Docker, monitoring, Diablo, and blockchain nodes.", "Schema di Lilith: generazione della topologia, esecuzione con Docker, emulazione con Kollaps, monitoraggio e carichi di lavoro con Diablo.")}
          class="rounded-xl border border-base-300 bg-base-200"
          loading="lazy"
        />
      </figure>

      <div class="card-body">
        <h2 id="lilith-architecture" class="card-title text-2xl">{t("Lilith architecture", "Architettura di Lilith")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The work introduces Lilith as a topology-aware benchmarking framework. Lilith connects experiment parameters, topology generation, network datasets, Docker-based execution, Kollaps network emulation, monitoring and export modules, and Diablo-based blockchain workload execution. This creates a repeatable pipeline for running blockchain experiments under programmable network conditions.", "Lilith prende la configurazione dell’esperimento e genera la topologia. Esegue i nodi in Docker, emula la rete con Kollaps, genera i carichi con Diablo e raccoglie le misure. In questo modo è possibile ripetere l’intero esperimento.")}
        </p>

        <div class="card-actions mt-4">
          <a
            href={localPath("/research/lilith-benchmarking-framework")}
            class="btn btn-sm btn-outline"
          >
            {t("Open Lilith artifact page", "Vai alla scheda di Lilith")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="topologies" class="card-title text-2xl">{t("Topologies evaluated", "Topologie valutate")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The evaluation compares blockchain behaviour across five network topologies. These topologies are not presented as perfect representations of every real blockchain deployment. Instead, they are controlled network shapes used to expose how different communication structures influence performance and robustness.", "Le cinque topologie permettono di isolare l’effetto della struttura della rete sulle prestazioni e sulla capacità di reagire ai guasti.")}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-5">
          {
            topologies.map((topology) => (
              <div class="card bg-base-200/50 border border-base-300">
                <figure class="px-4 pt-4">
                  <img
                    src={topology.src}
                    alt={`${topology.name} topology used in the DEBS 2025 blockchain benchmarking paper.`}
                    class="rounded-lg bg-base-100"
                    loading="lazy"
                  />
                </figure>

                <div class="card-body p-4">
                  <h3 class="font-bold">{topology.name}</h3>
                  <p class="text-sm opacity-80">{topology.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <figure class="px-6 pt-6">
        <img
          src="/research/debs/network-load-workloads.webp" width="3600" height="4500" decoding="async"
          alt={t("Network load during blockchain workload execution across workloads and topologies.", "Traffico durante l’esecuzione dei benchmark, per diversi carichi e topologie.")}
          class="rounded-xl border border-base-300 bg-base-200"
          loading="lazy"
        />
      </figure>

      <div class="card-body">
        <h2 id="results" class="card-title text-2xl">{t("What the experiments show", "Che cosa mostrano gli esperimenti")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The experiments compare how blockchain systems behave under different workloads and network topologies. The results show that topology is not a secondary detail: the communication structure of the network can change throughput, latency, commit behaviour, and network load. The paper highlights that full mesh, hypercube, and torus-like structures can improve performance under demanding workloads, while different blockchain systems react differently to the same network conditions.", "La topologia incide su throughput, latenza, tasso di conferma e traffico. Con i carichi più impegnativi, maglia completa, ipercubo e toro possono migliorare le prestazioni. Ogni blockchain reagisce in modo diverso alle stesse condizioni.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="network-dynamics" class="card-title text-2xl">{t("Network dynamics", "Dinamiche di rete")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("Beyond static topologies, the paper also evaluates dynamic network conditions such as packet drop, bandwidth congestion, and node crash. This is important because real distributed systems do not operate in perfectly stable networks. The goal is to understand which systems remain robust and which systems are more sensitive when the network degrades.", "Abbiamo simulato perdita di pacchetti, congestione e guasti per vedere quali sistemi mantengono le prestazioni quando la rete peggiora e quali risentono maggiormente del cambiamento.")}
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mt-5">
          {
            dynamics.map((item) => (
              <div class="card bg-base-200/50 border border-base-300">
                <figure class="px-4 pt-4">
                  <img
                    src={item.src}
                    alt={`${item.title} experiment from the DEBS 2025 blockchain topology paper.`}
                    class="rounded-lg bg-base-100"
                    loading="lazy"
                  />
                </figure>

                <div class="card-body p-4">
                  <h3 class="font-bold">{item.title}</h3>
                  <p class="text-sm opacity-80">{item.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="contributions" class="card-title text-2xl">{t("Contribution", "Contributi")}</h2>

        <ul class="list-disc pl-5 space-y-2 opacity-90">
          <li>
            {t("Shows that blockchain benchmarking should explicitly account for network topology and network variability.", "Mostra che il benchmarking delle blockchain deve tenere conto della topologia e della variabilità della rete.")}
          </li>
          <li>
            {t("Evaluates Algorand, Diem, Ethereum, Quorum, and Solana under controlled topology-aware conditions.", "Valuta Algorand, Diem, Ethereum, Quorum e Solana con topologie controllate.")}
          </li>
          <li>
            {t("Uses realistic workload families including transfer transactions and smart-contract-oriented workloads.", "Usa carichi realistici, tra cui trasferimenti e operazioni con smart contract.")}
          </li>
          <li>
            {t("Introduces Lilith as a reproducible framework integrating Diablo workload execution with Kollaps network emulation.", "Presenta Lilith, che integra l’esecuzione dei carichi con Diablo e l’emulazione con Kollaps.")}
          </li>
          <li>
            {t("Connects cloud-inspired network measurements with controlled cluster-based experiments.", "Usa le misure delle reti cloud per configurare esperimenti controllati su cluster.")}
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="links" class="card-title text-2xl">{t("Links", "Collegamenti")}</h2>

        <div class="flex flex-wrap gap-3 mt-2">
          <a
            href={localPath("/research/acm-dlt-network-topologies-blockchain-performance")}
            class="btn btn-outline btn-sm"
          >
            {t("Read journal article", "Leggi l’articolo su rivista")}
          </a>

          <a
            href="https://dl.acm.org/doi/10.1145/3701717.3730540"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm"
          >
            {t("Open ACM paper", "Apri l’articolo su ACM")}
          </a>

          <a
            href="https://doi.org/10.5281/zenodo.11409100"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-sm"
          >
            {t("Open Lilith artifact", "Apri i materiali di Lilith")}
          </a>

          <a
            href={localPath("/research/lilith-benchmarking-framework")}
            class="btn btn-outline btn-sm"
          >
            {t("Read artifact page", "Vai alla scheda dello strumento")}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
