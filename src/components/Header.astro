---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLocale, inLanguage, translator } from "../i18n/locale";

const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
---
<div
  class="network-protected sticky lg:hidden top-0 z-30 flex h-16 w-full justify-center bg-opacity-90 backdrop-blur transition-all duration-100 bg-base-100 text-base-content shadow-md"
>
  <div class="navbar grid grid-cols-[auto_1fr_auto]">
    <div>
      <label for="my-drawer" class="btn btn-square btn-ghost" aria-label={t("Toggle navigation", "Apri o chiudi la navigazione")}>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-5 h-5 stroke-current"
          ><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>
    </div>
    <div class="justify-self-center">
      <a class="btn btn-ghost normal-case px-2 text-base sm:text-xl" href={inLanguage("/", locale)}>Vincenzo Di Perna</a>
    </div>
    <LanguageSwitcher />
  </div>
</div>
