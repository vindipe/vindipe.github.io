---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import NetworkBackground from "../components/NetworkBackground.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import StructuredData from "../components/StructuredData.astro";
import { ViewTransitions } from "astro:transitions";
import { getLocale, inLanguage, translator } from "../i18n/locale";
import { SITE_TITLE, SITE_DESCRIPTION, TRANSITION_API } from "../config";

const { 
  image = "/og/vincenzo-di-perna-og.png",
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  includeSidebar = true,
  sideBarActiveItemID,
  ogType = "website",
} = Astro.props;

const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} data-theme="bumblebee">
  <head>
    <BaseHead title={title} description={description} image={image} ogType={ogType} />
    <StructuredData {title} {description} />
    {TRANSITION_API && <ViewTransitions />}
  </head>

  <body>
    <a class="sr-only focus:not-sr-only focus:fixed focus:z-50 focus:bg-base-100 focus:p-3" href="#main-content">{t("Skip to content", "Vai al contenuto")}</a>
    <NetworkBackground animated={inLanguage(Astro.url.pathname, "en") === "/"} />

    <div class="relative z-[1] drawer lg:drawer-open">
      <input id="my-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content min-h-screen flex flex-col">
        <Header title={SITE_TITLE} />

        <div class="md:flex md:justify-center flex-1">
          <main id="main-content" class="p-6 pt-10 lg:max-w-[900px] max-w-[100vw]">
            <slot />
          </main>
        </div>

        <Footer />
      </div>

      {includeSidebar && <SideBar sideBarActiveItemID={sideBarActiveItemID} />}
    </div>

    <GoogleAnalytics />
  </body>
</html>
