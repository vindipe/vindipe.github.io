---
import { getLocale, inLanguage, translator } from "../../i18n/locale";
import BaseLayout from "../../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const topologies = [
  {
    name: "Fat-tree",
    src: "/research/debs/topology-fat-tree.png",
    desc: t("A layered topology often associated with data-center-like infrastructures.", "Topologia a livelli comune nelle infrastrutture dei data center."),
  },
  {
    name: "Full mesh",
    src: "/research/debs/topology-full-mesh.png",
    desc: t("A dense topology where gateways are directly interconnected.", "Topologia densa in cui i gateway sono collegati direttamente."),
  },
  {
    name: "Hypercube",
    src: "/research/debs/topology-hypercube.png",
    desc: t("A structured topology inspired by parallel and distributed computing systems.", "Topologia strutturata ispirata ai sistemi di calcolo parallelo e distribuito."),
  },
  {
    name: "Scale-free",
    src: "/research/debs/topology-scale-free.png",
    desc: t("A topology with highly connected hubs, resembling Internet-like networks.", "Topologia con nodi molto connessi, simile alla struttura di Internet."),
  },
  {
    name: "Torus",
    src: "/research/debs/topology-torus.png",
    desc: t("A wrap-around grid topology often used in high-performance computing contexts.", "Griglia con collegamenti ai bordi opposti, usata nel calcolo ad alte prestazioni."),
  },
];

const dynamics = [
  {
    title: t("Packet drop", "Perdita di pacchetti"),
    src: "/research/debs/dynamic-packet-drop.png",
    desc: t("Stress scenario used to observe how blockchain systems react when packet loss increases.", "Scenario di stress per osservare la risposta delle blockchain all’aumento della perdita di pacchetti."),
  },
  {
    title: t("Bandwidth congestion", "Congestione della banda"),
    src: "/research/debs/dynamic-bandwidth-congestion.png",
    desc: t("Stress scenario used to study the impact of constrained network capacity.", "Scenario di stress per valutare gli effetti di una capacità di rete limitata."),
  },
  {
    title: t("Node crash", "Guasto di un nodo"),
    src: "/research/debs/dynamic-node-crash.png",
    desc: t("Stress scenario used to evaluate behaviour when part of the network becomes unavailable.", "Scenario di stress per valutare il comportamento quando parte della rete non è disponibile."),
  },
];
---

<BaseLayout
  title={t("Blockchain Benchmarking with Lilith | ACM DEBS", "Benchmarking delle blockchain con Lilith | Vincenzo Di Perna")}
  description={t("ACM DEBS 2025 study on reproducible blockchain benchmarking with Lilith, realistic workloads and controlled network topologies.", "Studio ACM DEBS 2025 sul benchmarking riproducibile delle blockchain con Lilith, carichi realistici e topologie di rete controllate.")}
  sideBarActiveItemID="research"
>
  <section class="mb-8">
    <a href={localPath("/research")} class="btn btn-sm btn-outline mb-6">
      {t("← Back to Research", "← Torna alla ricerca")}
    </a>

    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <div class="flex flex-wrap gap-2 items-center mb-3">
          <h1 class="text-4xl font-bold">
            Impact of Network Topologies on Blockchain Performance
          </h1>
          <span class="badge badge-secondary">ACM DEBS '25</span>
          <span class="badge badge-outline">{t("Publication", "Pubblicazione")}</span>
        </div>

        <p class="text-lg leading-relaxed opacity-90">
          {t("This work studies how the underlying network topology affects blockchain performance. Instead of treating the network as a fixed or opaque execution layer, the paper evaluates multiple blockchain systems under controlled topologies, realistic workloads, and reproducible experimental conditions.", "Lo studio esamina come la topologia di rete influenzi le prestazioni delle blockchain. Confronta più sistemi in condizioni sperimentali riproducibili, usando topologie controllate e carichi di lavoro realistici.")}
        </p>

        <div class="flex flex-wrap gap-2 mt-5">
          <span class="badge badge-outline">{t("Blockchain benchmarking", "Benchmarking delle blockchain")}</span>
          <span class="badge badge-outline">{t("Network topology", "Topologia di rete")}</span>
          <span class="badge badge-outline">Lilith</span>
          <span class="badge badge-outline">Kollaps</span>
          <span class="badge badge-outline">Diablo</span>
          <span class="badge badge-outline">{t("Reproducibility", "Riproducibilità")}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">5</p>
          <p class="opacity-80">{t("blockchain systems", "sistemi blockchain")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">5</p>
          <p class="opacity-80">{t("network topologies", "topologie di rete")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">6</p>
          <p class="opacity-80">{t("workload families", "famiglie di carichi")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">1</p>
          <p class="opacity-80">{t("benchmarking framework", "framework di benchmarking")}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Context", "Contesto")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("Blockchain systems are usually evaluated through throughput, latency, commit rate, and resource consumption. However, those measurements can change significantly depending on the network conditions under which the blockchain is executed. Public clouds are useful for realistic deployments, but they also introduce cost, opacity, and time-dependent variability. This paper addresses that problem by combining reproducible cluster-based execution with programmable network emulation.", "Le blockchain si valutano spesso tramite throughput, latenza, tasso di conferma e consumo di risorse. Queste misure possono variare molto con le condizioni di rete. Il cloud pubblico offre deployment realistici, ma introduce costi, scarsa visibilità e variabilità nel tempo. Lo studio affronta il problema combinando esecuzione riproducibile su cluster ed emulazione di rete programmabile.")}
        </p>

        <p class="leading-relaxed opacity-90 mt-3">
          {t("The central idea is simple: to compare blockchains meaningfully, the evaluator must also control the shape and behaviour of the network in which validators, clients, and gateways communicate.", "Per confrontare le blockchain in modo significativo occorre controllare anche la forma e il comportamento della rete su cui comunicano validatori, client e gateway.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <figure class="px-6 pt-6">
        <img
          src="/research/debs/aws-heatmap-comparison.png"
          alt={t("AWS latency and throughput heatmap comparison used as motivation for controlled blockchain benchmarking.", "Mappe di calore di latenza e throughput su AWS, usate per motivare il benchmarking in condizioni controllate.")}
          class="rounded-xl border border-base-300 bg-base-200"
          loading="lazy"
        />
      </figure>

      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Why network control matters", "Perché controllare la rete")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The paper starts from a practical benchmarking problem: cloud network conditions vary across regions and over time. This makes blockchain experiments difficult to reproduce if the network layer is not explicitly modelled. The heatmap motivates the need for controlled experiments that can reproduce cloud-inspired latency and throughput conditions without depending entirely on live cloud variability.", "Nel cloud le condizioni di rete cambiano tra regioni e nel tempo. Senza un modello esplicito della rete, riprodurre un esperimento su blockchain è difficile. Le mappe mostrano perché servano esperimenti controllati capaci di riprodurre latenze e throughput ispirati al cloud senza dipendere interamente dalle condizioni del momento.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <figure class="px-6 pt-6">
        <img
          src="/research/debs/lilith-arch-v2.png"
          alt={t("Lilith architecture and execution flow integrating topology generation, Kollaps, Docker, monitoring, Diablo, and blockchain nodes.", "Architettura e flusso di Lilith, con generazione delle topologie, Kollaps, Docker, monitoraggio, Diablo e nodi blockchain.")}
          class="rounded-xl border border-base-300 bg-base-200"
          loading="lazy"
        />
      </figure>

      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Lilith architecture", "Architettura di Lilith")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The work introduces Lilith as a topology-aware benchmarking framework. Lilith connects experiment parameters, topology generation, network datasets, Docker-based execution, Kollaps network emulation, monitoring and export modules, and Diablo-based blockchain workload execution. This creates a repeatable pipeline for running blockchain experiments under programmable network conditions.", "Lilith è un framework di benchmarking che tiene conto della topologia di rete. Collega parametri sperimentali, generazione delle topologie, dataset di rete, Docker, emulazione con Kollaps, moduli di monitoraggio ed esportazione e carichi blockchain eseguiti con Diablo. L’insieme permette di ripetere gli esperimenti in condizioni di rete programmabili.")}
        </p>

        <div class="card-actions mt-4">
          <a
            href={localPath("/research/lilith-benchmarking-framework")}
            class="btn btn-sm btn-outline"
          >
            {t("Open Lilith artifact page", "Vai alla scheda di Lilith")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Topologies evaluated", "Topologie valutate")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The evaluation compares blockchain behaviour across five network topologies. These topologies are not presented as perfect representations of every real blockchain deployment. Instead, they are controlled network shapes used to expose how different communication structures influence performance and robustness.", "La valutazione confronta il comportamento delle blockchain in cinque topologie. Sono strutture di rete controllate che permettono di osservare come diverse forme di comunicazione influenzino prestazioni e robustezza.")}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mt-5">
          {
            topologies.map((topology) => (
              <div class="card bg-base-200/50 border border-base-300">
                <figure class="px-4 pt-4">
                  <img
                    src={topology.src}
                    alt={`${topology.name} topology used in the DEBS 2025 blockchain benchmarking paper.`}
                    class="rounded-lg bg-base-100"
                    loading="lazy"
                  />
                </figure>

                <div class="card-body p-4">
                  <h3 class="font-bold">{topology.name}</h3>
                  <p class="text-sm opacity-80">{topology.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <figure class="px-6 pt-6">
        <img
          src="/research/debs/network-load-workloads.png"
          alt={t("Network load during blockchain workload execution across workloads and topologies.", "Traffico durante l’esecuzione dei benchmark, per diversi carichi e topologie.")}
          class="rounded-xl border border-base-300 bg-base-200"
          loading="lazy"
        />
      </figure>

      <div class="card-body">
        <h2 class="card-title text-2xl">{t("What the experiments show", "Che cosa mostrano gli esperimenti")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The experiments compare how blockchain systems behave under different workloads and network topologies. The results show that topology is not a secondary detail: the communication structure of the network can change throughput, latency, commit behaviour, and network load. The paper highlights that full mesh, hypercube, and torus-like structures can improve performance under demanding workloads, while different blockchain systems react differently to the same network conditions.", "La struttura della rete può cambiare throughput, latenza, conferma delle transazioni e traffico. In carichi impegnativi, maglia completa, ipercubo e topologie simili al toro possono migliorare le prestazioni. Le blockchain valutate reagiscono in modo diverso anche nelle stesse condizioni.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Network dynamics", "Dinamiche di rete")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("Beyond static topologies, the paper also evaluates dynamic network conditions such as packet drop, bandwidth congestion, and node crash. This is important because real distributed systems do not operate in perfectly stable networks. The goal is to understand which systems remain robust and which systems are more sensitive when the network degrades.", "Lo studio valuta anche condizioni dinamiche come perdita di pacchetti, congestione della banda e guasto dei nodi. Lo scopo è capire quali sistemi restano robusti quando la rete degrada e quali risentono maggiormente dei cambiamenti.")}
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mt-5">
          {
            dynamics.map((item) => (
              <div class="card bg-base-200/50 border border-base-300">
                <figure class="px-4 pt-4">
                  <img
                    src={item.src}
                    alt={`${item.title} experiment from the DEBS 2025 blockchain topology paper.`}
                    class="rounded-lg bg-base-100"
                    loading="lazy"
                  />
                </figure>

                <div class="card-body p-4">
                  <h3 class="font-bold">{item.title}</h3>
                  <p class="text-sm opacity-80">{item.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Contribution", "Contributi")}</h2>

        <ul class="list-disc pl-5 space-y-2 opacity-90">
          <li>
            {t("Shows that blockchain benchmarking should explicitly account for network topology and network variability.", "Mostra che il benchmarking delle blockchain deve tenere conto della topologia e della variabilità della rete.")}
          </li>
          <li>
            {t("Evaluates Algorand, Diem, Ethereum, Quorum, and Solana under controlled topology-aware conditions.", "Valuta Algorand, Diem, Ethereum, Quorum e Solana con topologie controllate.")}
          </li>
          <li>
            {t("Uses realistic workload families including transfer transactions and smart-contract-oriented workloads.", "Usa carichi realistici, tra cui trasferimenti e operazioni con smart contract.")}
          </li>
          <li>
            {t("Introduces Lilith as a reproducible framework integrating Diablo workload execution with Kollaps network emulation.", "Presenta Lilith, che integra l’esecuzione dei carichi con Diablo e l’emulazione con Kollaps.")}
          </li>
          <li>
            {t("Connects cloud-inspired network measurements with controlled cluster-based experiments.", "Collega misure di rete ispirate al cloud a esperimenti controllati su cluster.")}
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Links", "Collegamenti")}</h2>

        <div class="flex flex-wrap gap-3 mt-2">
          <a
            href={localPath("/research/acm-dlt-network-topologies-blockchain-performance")}
            class="btn btn-outline btn-sm"
          >
            {t("Read journal article", "Leggi l’articolo su rivista")}
          </a>

          <a
            href="https://dl.acm.org/doi/10.1145/3701717.3730540"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm"
          >
            {t("Open ACM paper", "Apri l’articolo su ACM")}
          </a>

          <a
            href="https://doi.org/10.5281/zenodo.11409100"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-sm"
          >
            {t("Open Lilith artifact", "Apri i materiali di Lilith")}
          </a>

          <a
            href={localPath("/research/lilith-benchmarking-framework")}
            class="btn btn-outline btn-sm"
          >
            {t("Read artifact page", "Vai alla scheda dello strumento")}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
