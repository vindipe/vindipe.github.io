---
import { getLocale, inLanguage, translator } from "../../i18n/locale";
import BaseLayout from "../../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const entropyResults = [
  {
    title: t("Unweighted EB-index - Set1", "EB-index senza pesi – Set1"),
    src: "/research/dlt25/entropy-set1.png",
    desc: t("Set1 combines user activity with market-oriented indicators, showing how balance evolves across assets over time.", "Set1 combina indicatori di attività e di mercato per confrontare come cambia nel tempo l’equilibrio economico delle criptovalute."),
  },
  {
    title: t("Weighted EB-index - Set1", "EB-index ponderato – Set1"),
    src: "/research/dlt25/weighted-entropy-set1.png",
    desc: t("The weighted version makes the index sensitive not only to balance, but also to the relative strength of the selected attributes.", "La versione ponderata considera l’equilibrio fra gli indicatori e il peso assegnato a ciascuno."),
  },
  {
    title: t("Unweighted EB-index - Set2", "EB-index senza pesi – Set2"),
    src: "/research/dlt25/entropy-set2.png",
    desc: t("Set2 focuses on dynamic qualities such as participation, transfer size, turnover, active supply, and wealth distribution.", "Set2 osserva caratteristiche dinamiche come partecipazione, importo dei trasferimenti, turnover, offerta attiva e distribuzione della ricchezza."),
  },
  {
    title: t("Weighted EB-index - Set2", "EB-index ponderato – Set2"),
    src: "/research/dlt25/weighted-entropy-set2.png",
    desc: t("The weighted version changes the interpretation of the results by incorporating attribute magnitude into the entropy score.", "Nel calcolo ponderato, il contributo di ciascun indicatore all’entropia dipende anche dal peso assegnato."),
  },
];

const probabilityDistributions = [
  {
    asset: "Bitcoin",
    set: "Set1",
    src: "/research/dlt25/prob-btc-set1.png",
  },
  {
    asset: "Bitcoin",
    set: "Set2",
    src: "/research/dlt25/prob-btc-set2.png",
  },
  {
    asset: "Ethereum",
    set: "Set1",
    src: "/research/dlt25/prob-eth-set1.png",
  },
  {
    asset: "Ethereum",
    set: "Set2",
    src: "/research/dlt25/prob-eth-set2.png",
  },
  {
    asset: "USD Coin",
    set: "Set1",
    src: "/research/dlt25/prob-usdc-set1.png",
  },
  {
    asset: "USD Coin",
    set: "Set2",
    src: "/research/dlt25/prob-usdc-set2.png",
  },
  {
    asset: "Ripple",
    set: "Set1",
    src: "/research/dlt25/prob-xrp-set1.png",
  },
  {
    asset: "Ripple",
    set: "Set2",
    src: "/research/dlt25/prob-xrp-set2.png",
  },
];

const qualitiesSet1 = [
  t("Participation", "Partecipazione"),
  t("Mean transfers per active address", "Numero medio di trasferimenti per indirizzo attivo"),
  t("Mean transfer per market capitalization", "Importo medio trasferito in rapporto alla capitalizzazione di mercato"),
  t("Market capitalization", "Capitalizzazione di mercato"),
];

const qualitiesSet2 = [
  t("Participation", "Partecipazione"),
  t("Mean transfer size", "Importo medio dei trasferimenti"),
  t("Mean transfers per active address", "Numero medio di trasferimenti per indirizzo attivo"),
  t("Active supply turnover rate", "Tasso di rotazione dell’offerta attiva"),
  t("Active supply ratio", "Quota di offerta attiva"),
  t("Wealth distribution", "Distribuzione della ricchezza"),
];

const findings = [
  t("The proposed EB-index is designed to capture balance across selected economic qualities rather than relying on a single metric such as price, capitalization, throughput, or energy.", "L’EB-index riunisce più indicatori per misurare quanto siano equilibrate le caratteristiche economiche di una criptovaluta."),
  t("The framework is customizable: researchers can select different attributes and weights depending on the economic behaviour they want to study.", "Chi conduce lo studio può scegliere attributi e pesi in base al comportamento economico che vuole analizzare."),
  t("Set1 captures a compact view of activity and market-related behaviour, while Set2 focuses more deeply on user participation, transfer dynamics, supply usage, and wealth distribution.", "Set1 sintetizza attività e dinamiche di mercato. Set2 approfondisce partecipazione, trasferimenti, uso dell’offerta e distribuzione della ricchezza."),
  t("The weighted version of the index changes the interpretation by rewarding not only balance, but also stronger normalized attribute values.", "La versione ponderata tiene conto anche dei valori normalizzati più alti, oltre all’equilibrio tra gli attributi."),
  t("The work should be read as a methodological framework, not as investment advice or as a final ranking of cryptocurrencies.", "Lo studio propone un metodo di analisi. Non offre consigli di investimento né una classifica definitiva delle criptovalute."),
];
---

<BaseLayout
  title={t("Entropy and Cryptocurrency Efficiency | Vincenzo Di Perna", "Entropia ed efficienza economica delle criptovalute | Vincenzo Di Perna")}
  description={t("DLT 2025 research on the Entropy Balance index for evaluating cryptocurrency economic efficiency with Shannon entropy and on-chain data.", "Ricerca DLT 2025 sull’Entropy Balance index, che valuta l’efficienza economica delle criptovalute con entropia di Shannon e dati on-chain.")}
  sideBarActiveItemID="research"
>
  <section class="mb-8">
    <a href={localPath("/research")} class="btn btn-sm btn-outline mb-6">
      {t("← Back to Research", "← Torna alla ricerca")}
    </a>

    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <div class="flex flex-wrap gap-2 items-center mb-3">
          <h1 class="text-4xl font-bold">
            {t("An Entropy-Based Approach to Evaluating the Economic Efficiency of Cryptocurrencies", "Misurare l’efficienza economica delle criptovalute con l’entropia")}
          </h1>
          <span class="badge badge-secondary">DLT '25</span>
          <span class="badge badge-outline">{t("Publication", "Pubblicazione")}</span>
        </div>

        <p class="text-lg leading-relaxed opacity-90">
          {t("This work introduces an entropy-based framework for evaluating the economic efficiency of cryptocurrencies. Instead of measuring only price, market capitalization, throughput, or energy consumption, the paper proposes a composite index that captures how well multiple economic qualities are balanced inside a cryptoasset economy.", "Lo studio propone un indice che usa l’entropia per misurare l’equilibrio fra più caratteristiche economiche di una criptovaluta. Permette di osservare aspetti che una singola misura, come il prezzo o la capitalizzazione, lascerebbe fuori.")}
        </p>

        <div class="flex flex-wrap gap-2 mt-5">
          <span class="badge badge-outline">{t("Cryptocurrency efficiency", "Efficienza delle criptovalute")}</span>
          <span class="badge badge-outline">{t("Entropy Balance index", "Indice Entropy Balance")}</span>
          <span class="badge badge-outline">{t("Shannon entropy", "Entropia di Shannon")}</span>
          <span class="badge badge-outline">Coin Metrics</span>
          <span class="badge badge-outline">{t("On-chain data", "Dati on-chain")}</span>
          <span class="badge badge-outline">{t("Economic index", "Indice economico")}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">6</p>
          <p class="opacity-80">cryptoassets</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">2</p>
          <p class="opacity-80">{t("attribute sets", "insiemi di attributi")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">2010-2025</p>
          <p class="opacity-80">{t("analysis period", "periodo di analisi")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">EB</p>
          <p class="opacity-80">{t("Entropy Balance index", "Indice Entropy Balance")}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Context", "Contesto")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("Blockchain efficiency is often discussed in terms of transactions per second, latency, scalability, or energy consumption. Cryptocurrencies, however, are also economic systems: they have supply dynamics, user participation, transfer activity, wealth concentration, market value, and different forms of asset usage.", "Le misure tecniche di una blockchain includono transazioni al secondo, latenza, scalabilità e consumi. Per studiare le criptovalute come sistemi economici servono anche dati su offerta, partecipazione, trasferimenti, concentrazione della ricchezza e valore di mercato.")}
        </p>

        <p class="leading-relaxed opacity-90 mt-3">
          {t("This paper focuses on that economic dimension. The central question is how to build a coherent index that can aggregate multiple on-chain and market-related attributes without reducing the analysis to one isolated metric.", "L’articolo studia come sintetizzare questi dati in una misura e continuare a vedere il contributo di ogni indicatore.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("The EB-index idea", "Come funziona l’EB-index")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The proposed Entropy Balance index uses Shannon entropy to measure how balanced a selected set of economic qualities is. Each quality is first normalized, then transformed into a probability distribution. Entropy is then used to quantify whether the selected qualities are concentrated around one dominant dimension or more evenly balanced.", "L’EB-index usa l’entropia di Shannon per misurare quanto siano equilibrati gli indicatori scelti. Dopo la normalizzazione, ogni indicatore rappresenta una quota del totale. L’entropia indica se una quota prevale sulle altre o se i valori sono distribuiti in modo uniforme.")}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-5">
          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("Normalize", "Normalizzazione")}</h3>
              <p class="text-sm opacity-80">
                {t("Economic qualities with different scales are mapped into a comparable interval.", "Le caratteristiche economiche su scale diverse vengono riportate a un intervallo comune.")}
              </p>
            </div>
          </div>

          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("Convert to distribution", "Come si ottiene la distribuzione di probabilità")}</h3>
              <p class="text-sm opacity-80">
                {t("The normalized qualities are converted into a probability distribution over the selected attributes.", "Ogni valore normalizzato viene diviso per la somma dei valori selezionati, così da ottenere una distribuzione di probabilità.")}
              </p>
            </div>
          </div>

          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("Measure balance", "Misura dell’equilibrio")}</h3>
              <p class="text-sm opacity-80">
                {t("Shannon entropy measures whether the qualities are balanced or concentrated around a few dominant dimensions.", "L’entropia di Shannon misura se le caratteristiche sono bilanciate o se il peso si concentra su poche dimensioni.")}
              </p>
            </div>
          </div>
        </div>

        <div class="mockup-code mt-5 text-sm">
          <pre><code>pᵢ = rᵢ / Σ rᵢ</code></pre>
          <pre><code>H(P) = - Σ pᵢ log(pᵢ)</code></pre>
          <pre><code>Weighted version: H(P; W) = - Σ wᵢ pᵢ log(pᵢ)</code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Data and attribute sets", "Dati e insiemi di attributi")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The illustrative evaluation uses on-chain data from Coin Metrics and compares six major cryptoassets: Bitcoin, Ethereum, Ripple, USD Coin, Dogecoin, and Cardano. The paper defines two different sets of attributes to show that the framework can be adapted to different interpretations of economic efficiency.", "L’esempio usa dati on-chain di Coin Metrics e confronta sei cryptoasset: Bitcoin, Ethereum, Ripple, USD Coin, Dogecoin e Cardano. Due insiemi di attributi mostrano come il metodo si possa adattare a interpretazioni diverse dell’efficienza economica.")}
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-5">
          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("Set1 - compact activity and market view", "Set1 – Attività e mercato, in sintesi")}</h3>

              <ul class="list-disc pl-5 space-y-1 text-sm opacity-80">
                {qualitiesSet1.map((quality) => <li>{quality}</li>)}
              </ul>
            </div>
          </div>

          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("Set2 - dynamic network behaviour", "Set2 – Dinamiche della rete")}</h3>

              <ul class="list-disc pl-5 space-y-1 text-sm opacity-80">
                {qualitiesSet2.map((quality) => <li>{quality}</li>)}
              </ul>
            </div>
          </div>
        </div>

        <p class="leading-relaxed opacity-90 mt-5">
          {t("This distinction is important: the EB-index does not impose a single universal definition of economic efficiency. It provides a formal way to combine the qualities selected by the researcher.", "L’EB-index rende esplicita la scelta degli indicatori. Chi conduce l’analisi può quindi verificare come cambiano i risultati quando adotta una definizione diversa di efficienza economica.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Entropy results", "Risultati dell’analisi dell’entropia")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The four plots below compare unweighted and weighted entropy for the two attribute sets. The unweighted version highlights balance among the selected qualities. The weighted version also accounts for the relative strength of the normalized attributes, changing the interpretation from pure balance to balance plus magnitude.", "I quattro grafici confrontano entropia semplice e ponderata per i due insiemi. La prima evidenzia l’equilibrio fra le caratteristiche selezionate. La seconda considera anche l’ampiezza relativa degli attributi normalizzati.")}
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-5">
          {
            entropyResults.map((item) => (
              <div class="card bg-base-200/50 border border-base-300">
                <figure class="px-4 pt-4">
                  <img
                    src={item.src}
                    alt={`${item.title} for Bitcoin, Ethereum, Ripple, USD Coin, Dogecoin, and Cardano.`}
                    class="rounded-lg bg-base-100"
                    loading="lazy"
                  />
                </figure>

                <div class="card-body p-4">
                  <h3 class="font-bold">{item.title}</h3>
                  <p class="text-sm opacity-80">{item.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Representative attribute distributions", "Distribuzioni rappresentative degli attributi")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The probability-distribution plots show how the selected qualities contribute to each asset's entropy score. They help explain why two cryptoassets can obtain similar entropy values for different internal reasons, or why the same asset can behave differently across Set1 and Set2.", "I grafici mostrano il contributo di ogni indicatore al punteggio. Due criptovalute possono ottenere punteggi simili per ragioni diverse, e la stessa criptovaluta può cambiare posizione fra Set1 e Set2.")}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-5">
          {
            probabilityDistributions.map((item) => (
              <div class="card bg-base-200/50 border border-base-300">
                <figure class="px-4 pt-4">
                  <img
                    src={item.src}
                    alt={`${item.asset} probability distribution for ${item.set} in the DLT 2025 EB-index paper.`}
                    class="rounded-lg bg-base-100"
                    loading="lazy"
                  />
                </figure>

                <div class="card-body p-4">
                  <h3 class="font-bold">{item.asset}</h3>
                  <p class="text-sm opacity-80">{item.set}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Main contribution", "Contributo principale")}</h2>

        <ul class="list-disc pl-5 space-y-2 opacity-90">
          {findings.map((finding) => <li>{finding}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Relationship with my broader research", "Come si collega alle mie altre ricerche")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("This paper extends my blockchain evaluation work beyond protocol-level performance and energy analysis. While the DEBS and ICBC works study how blockchain systems behave under different network conditions, this work moves to the economic layer and asks how the internal behaviour of cryptoasset economies can be measured through a transparent, customizable, and theoretically grounded index.", "Negli studi DEBS e ICBC ho esaminato prestazioni e consumi delle blockchain al variare della rete. Qui applico un’idea simile alla dimensione economica: rendo esplicito quali indicatori contano e come vengono combinati.")}
        </p>

        <div class="card-actions mt-4">
          <a
            href={localPath("/research/topology-aware-blockchain-benchmarking")}
            class="btn btn-sm btn-outline"
          >
            {t("Related DEBS paper", "Articolo DEBS correlato")}
          </a>

          <a
            href={localPath("/research/performance-energy-economic-efficiency")}
            class="btn btn-sm btn-outline"
          >
            {t("Related ICBC paper", "Articolo ICBC correlato")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <div class="flex flex-wrap gap-3 items-start justify-between">
          <div class="max-w-3xl">
            <h2 class="card-title text-2xl">{t("Try the EB-index interactively", "Prova l’EB-index")}</h2>

            <p class="leading-relaxed opacity-90 mt-2">
              {t("The CryptoEntropy Explorer turns the paper into a small interactive lab. Users can toggle cryptoassets, choose one of the paper attribute sets, build their own custom set from the available attributes, assign utility weights, and immediately see how the EB-index changes over time.", "Con CryptoEntropy Explorer puoi scegliere le criptovalute, usare gli indicatori dello studio o selezionarne altri, impostare i pesi e osservare l’andamento dell’indice.")}
            </p>
          </div>

          <a
            href={localPath("/projects/cryptoentropy-explorer")}
            class="btn btn-primary btn-sm mt-1"
          >
            {t("Open CryptoEntropy Explorer", "Apri CryptoEntropy Explorer")}
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-5">
          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("Custom attribute sets", "Insiemi di attributi personalizzati")}</h3>
              <p class="text-sm opacity-80">
                {t("Start from Set1, Set2, Set3, or create a new set by selecting the economic attributes you want to evaluate.", "Parti da Set1, Set2 o Set3, oppure crea un insieme scegliendo gli attributi economici da valutare.")}
              </p>
            </div>
          </div>

          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("User-defined weights", "Pesi personalizzati")}</h3>
              <p class="text-sm opacity-80">
                {t("Make the assumptions explicit by giving more or less importance to activity, market, wealth, supply, or fee-related dimensions.", "Rendi esplicite le tue ipotesi dando più o meno importanza ad attività, mercato, ricchezza, offerta o commissioni.")}
              </p>
            </div>
          </div>

          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("Shareable experiments", "Esperimenti condivisibili")}</h3>
              <p class="text-sm opacity-80">
                {t("The current Explorer configuration is stored in the URL, so a specific analytical question can be copied, reopened, or shared.", "Il link conserva criptovalute, indicatori e pesi selezionati. Puoi usarlo per riaprire o condividere lo stesso confronto.")}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Links and reproducibility material", "Collegamenti e materiali per la riproducibilità")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The paper is accompanied by a public GitHub repository containing the normalized and entropy-derived datasets, documentation, citation metadata, and a plotting script for reproducing the main figures.", "Il repository pubblico su GitHub contiene i dataset normalizzati e derivati dall’entropia, la documentazione, i metadati per la citazione e lo script per riprodurre i grafici principali.")}
        </p>

        <div class="flex flex-wrap gap-3 mt-4">
          <a
            href="https://ceur-ws.org/Vol-4105/paper09.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm"
          >
            {t("Open CEUR-WS paper", "Apri l’articolo su CEUR-WS")}
          </a>

          <a
            href="https://github.com/vindipe/cryptoentropy-economic-efficiency"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-sm"
          >
            {t("Open GitHub repository", "Apri il repository GitHub")}
          </a>

          <a
            href="https://doi.org/10.5281/zenodo.15743397"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline btn-sm"
          >
            {t("Open Zenodo dataset", "Apri il dataset su Zenodo")}
          </a>

          <a
            href={localPath("/projects/cryptoentropy-explorer")}
            class="btn btn-outline btn-sm"
          >
            {t("Explore dashboard", "Esplora la dashboard")}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>