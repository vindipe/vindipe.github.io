---
import { translator } from "../../../i18n/locale";

const t = translator(Astro.url.pathname);
const { labelledBy } = Astro.props;
---

<section id="wallet-keys-lab" aria-labelledby={labelledBy} class="card">
  <div class="card-body p-3 sm:p-4">
    <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1fr] gap-4">
      <div class="grid gap-3">
        <button class="btn btn-primary" data-wallet-action="generate">
          {t("Generate toy wallet", "Crea un wallet di prova")}
        </button>

        <label class="form-control">
          <span class="label-text font-semibold">{t("Transaction message", "Messaggio della transazione")}</span>
          <textarea
            class="textarea textarea-bordered min-h-24"
            data-wallet-message
          >{t("Send 10 TOK from Alice to Bob", "Invia 10 TOK da Alice a Bob")}</textarea>
        </label>

        <div class="flex flex-wrap gap-2">
          <button class="btn btn-outline" data-wallet-action="sign">
            {t("Sign transaction", "Firma la transazione")}
          </button>

          <button class="btn btn-outline" data-wallet-action="verify">
            {t("Verify signature", "Verifica la firma")}
          </button>

          <button class="btn btn-outline" data-wallet-action="tamper">
            {t("Tamper message", "Modifica il messaggio")}
          </button>
        </div>
      </div>

      <div class="grid gap-3">
        <div class="rounded-xl bg-base-200 border border-base-300 p-4">
          <p class="font-semibold mb-1">{t("Wallet identity", "Identità del wallet")}</p>
          <p class="text-sm opacity-80">
            {t("Address:", "Indirizzo")}
            <span class="font-mono break-all" data-wallet-address>-</span>
          </p>
          <p class="text-sm opacity-80">
            {t("Public identity:", "Identità pubblica")}
            <span class="font-mono break-all" data-wallet-public>-</span>
          </p>
        </div>

        <div class="rounded-xl bg-base-200 border border-base-300 p-4">
          <p class="font-semibold mb-1">{t("Signature", "Firma")}</p>
          <p class="font-mono text-xs break-all opacity-80" data-wallet-signature>
            {t("Generate a wallet and sign a transaction.", "Genera un wallet e firma una transazione.")}
          </p>
        </div>

        <div class="rounded-xl bg-base-200 border border-base-300 p-4">
          <p class="font-semibold mb-1">{t("Status", "Stato")}</p>
          <p class="text-sm opacity-80" data-wallet-status>
            {t("A wallet authorizes actions by signing messages.", "Un wallet autorizza le operazioni firmando messaggi.")}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const isItalian = () => document.documentElement.lang === "it";
  const translate = (english, italian) => isItalian() ? italian : english;

  function initWalletKeysLab() {
    const root = document.querySelector("#wallet-keys-lab");

    if (!root || root.dataset.initialized === "true") {
      return;
    }

    root.dataset.initialized = "true";

    const messageInput = root.querySelector("[data-wallet-message]");
    const addressOutput = root.querySelector("[data-wallet-address]");
    const publicOutput = root.querySelector("[data-wallet-public]");
    const signatureOutput = root.querySelector("[data-wallet-signature]");
    const status = root.querySelector("[data-wallet-status]");

    let wallet = null;
    let signature = null;
    let signedMessage = null;

    async function sha256(text) {
      const encoded = new TextEncoder().encode(text);
      const digest = await crypto.subtle.digest("SHA-256", encoded);

      return Array.from(new Uint8Array(digest))
        .map((byte) => byte.toString(16).padStart(2, "0"))
        .join("");
    }

    async function generateWallet() {
      const seed = crypto.getRandomValues(new Uint32Array(4)).join("-");
      const publicIdentity = await sha256(`public:${seed}`);
      const address = `0x${publicIdentity.slice(0, 40)}`;

      wallet = {
        seed,
        publicIdentity,
        address,
      };

      signature = null;
      signedMessage = null;

      addressOutput.textContent = address;
      publicOutput.textContent = publicIdentity.slice(0, 32) + "...";
      signatureOutput.textContent = translate("No signature yet.", "Nessuna firma generata.");
      status.textContent =
        translate("Toy wallet generated. In real systems, the private key must remain secret.", "Wallet di prova creato. Quando usi un wallet reale, tieni segreta la chiave privata.");
    }

    async function signMessage() {
      if (!wallet) {
        await generateWallet();
      }

      signedMessage = messageInput.value;
      signature = await sha256(`${wallet.seed}|${signedMessage}`);

      signatureOutput.textContent = signature;
      status.textContent =
        translate("Transaction signed. The signature is bound to this exact message.", "Transazione firmata. La firma vale per il messaggio che hai appena firmato.");
    }

    async function verifySignature() {
      if (!wallet || !signature || !signedMessage) {
        status.textContent = translate("Nothing to verify yet. Generate a wallet and sign a transaction first.", "Genera un wallet e firma una transazione prima di verificarla.");
        return;
      }

      const expected = await sha256(`${wallet.seed}|${messageInput.value}`);

      if (expected === signature) {
        status.textContent =
          translate("Signature verified: the message matches the signed transaction.", "Firma valida: il messaggio corrisponde alla transazione firmata.");
      } else {
        status.textContent =
          translate("Verification failed: the message changed after signing.", "Verifica fallita: il messaggio è cambiato dopo la firma.");
      }
    }

    function tamperMessage() {
      messageInput.value = `${messageInput.value} [tampered]`;
      status.textContent =
        translate("Message changed. Try verifying the old signature again.", "Messaggio modificato. Prova a verificare di nuovo la firma precedente.");
    }

    root
      .querySelector('[data-wallet-action="generate"]')
      .addEventListener("click", generateWallet);

    root
      .querySelector('[data-wallet-action="sign"]')
      .addEventListener("click", signMessage);

    root
      .querySelector('[data-wallet-action="verify"]')
      .addEventListener("click", verifySignature);

    root
      .querySelector('[data-wallet-action="tamper"]')
      .addEventListener("click", tamperMessage);

    generateWallet();
  }

  initWalletKeysLab();

  if (!window.__walletKeysLabPageLoadRegistered) {
    window.__walletKeysLabPageLoadRegistered = true;
    document.addEventListener("astro:page-load", initWalletKeysLab);
  }
</script>