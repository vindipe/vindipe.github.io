---
import { SITE_DESCRIPTION, SITE_TITLE } from "../config";
import { getLocale, inLanguage, translator } from "../i18n/locale";

const site = Astro.site ?? new URL("https://vindipe.github.io/");
const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
const { title, description: pageDescription } = Astro.props;
const home = inLanguage(Astro.url.pathname, "en") === "/";
const canonicalURL = new URL(inLanguage(Astro.url.pathname, locale), site).toString();
const description = t(SITE_DESCRIPTION, "Vincenzo Di Perna è un ingegnere del software con un dottorato in blockchain. Ha sviluppato strumenti per valutare i sistemi distribuiti e con CIRCULA studierà la scadenza e il rinnovo delle risorse digitali.");

const personId = new URL("/#person", site).toString();
const websiteId = new URL("/#website", site).toString();

const pageId = canonicalURL + "#page";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      "name": "Vincenzo Di Perna",
      "url": site.toString(),
      "image": new URL("/profile.webp", site).toString(),
      "jobTitle": t("Research Software Engineer", "Ingegnere del software"),
      "description": description,
      "knowsAbout": [
        "Expiry-aware blockchain design",
        "Blockchain benchmarking",
        "Distributed systems",
        "Digital assets",
        "DLT",
        "Reproducible experimentation",
        "Network emulation",
        "Protocol analytics",
        "Energy-aware blockchain evaluation",
        "Economic efficiency of cryptocurrencies"
      ],
      "sameAs": [
        "https://github.com/vindipe",
        "https://www.linkedin.com/in/vincenzo-di-perna/",
        "https://orcid.org/0009-0003-8834-9900"
      ],
      "mainEntityOfPage": new URL("/#page", site).toString()
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      "name": SITE_TITLE,
      "url": site.toString(),
      "description": description,
      "publisher": {
        "@id": personId
      },
      "inLanguage": ["en", "it"]
    },
    {
      "@type": home ? "ProfilePage" : "WebPage",
      "@id": pageId,
      "url": canonicalURL,
      "name": title,
      "description": pageDescription,
      "inLanguage": locale,
      "isPartOf": { "@id": websiteId },
      ...(home ? { "mainEntity": { "@id": personId } } : {})
    }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
