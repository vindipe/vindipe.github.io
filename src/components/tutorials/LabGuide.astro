---
import { translator } from "../../i18n/locale";

const t = translator(Astro.url.pathname);
const { context, howToPlay, observe, nextStep } = Astro.props;
const steps = [
  [t("Where it appears", "A che cosa serve"), context],
  [t("How to use it", "Come fare la prova"), howToPlay],
  [t("What to observe", "Che cosa osservare"), observe],
  [t("What to try next", "Che cosa provare dopo"), nextStep],
];
---

<details class="tutorial-disclosure mx-3 mb-3 rounded-lg border border-base-300 bg-base-200 sm:mx-4 sm:mb-4">
  <summary class="flex min-h-11 items-center justify-between gap-2 rounded-lg px-3 text-sm font-semibold hover:bg-base-300">
    {t("Lab guide", "Guida al laboratorio")}
    <span class="tutorial-disclosure-icon" aria-hidden="true"></span>
  </summary>
  <dl class="tutorial-disclosure-content grid gap-3 px-3 pb-3 text-sm leading-relaxed sm:grid-cols-2">
    {steps.map(([label, text]) => (
      <div>
        <dt class="font-semibold">{label}</dt>
        <dd>{text}</dd>
      </div>
    ))}
  </dl>
</details>
