---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);
---

<BaseLayout
  title={t("Blockchain Projects and Tools | Vincenzo Di Perna", "Progetti blockchain e strumenti di ricerca | Vincenzo Di Perna")}
  description={t("Explore blockchain research software, reproducibility artifacts, experimental pipelines and interactive dashboards by Vincenzo Di Perna.", "Software, dati e strumenti interattivi per studiare le blockchain e riprodurre gli esperimenti.")}
  sideBarActiveItemID="projects"
>
  <section class="mb-10">
    <h1 class="text-4xl font-bold mb-4">{t("Projects and Tools", "Progetti e strumenti")}</h1>

    <p class="text-lg leading-relaxed opacity-90">
      {t("A selection of research artifacts, software tools, datasets, analysis pipelines, and exploratory projects around blockchain systems, distributed infrastructures, digital assets, benchmarking, reproducible experimentation, real-world assets, and fairer value distribution.", "Qui trovi il software, i dati e gli strumenti nati dai miei esperimenti sulle blockchain, oltre ai temi che sto esplorando, come la tokenizzazione di beni reali e la distribuzione del valore.")}
    </p>
  </section>

  <section class="mb-12"><h2 id="research-projects" class="text-3xl font-bold mb-5">{t("Research projects", "Progetti di ricerca")}</h2>
    <article class="network-protected card bg-base-100 shadow-md"><div class="card-body">
  <div class="flex flex-wrap items-center gap-2"><h3 class="card-title">{t("CIRCULA - Expiry-Aware System Design for Blockchains", "CIRCULA – Scadenza e rinnovo delle risorse nelle blockchain")}</h3><span class="badge badge-primary">{t("Expected start · 1 February 2027", "Avvio previsto · 1° febbraio 2027")}</span></div>
  <p>{t("What if digital resources had an explicit lifetime? CIRCULA will investigate expiry and renewal in blockchain systems through formal semantics, prototypes and controlled evaluation. The project is funded by the SNSF and hosted at the University of Neuchâtel.", "Che cosa succede quando una risorsa digitale ha una data di scadenza? CIRCULA studierà come rappresentare e verificare scadenza e rinnovo con modelli formali, prototipi ed esperimenti controllati. Il progetto è ospitato dall’Università di Neuchâtel e finanziato dal Fondo nazionale svizzero.")}</p>
  
  <div class="card-actions mt-3"><a class="btn btn-sm btn-primary" href={localPath("/research/circula")}>{t("Explore CIRCULA", "Scopri CIRCULA")}</a><a class="btn btn-sm btn-outline" href="https://circula.unine.ch/" target="_blank" rel="noopener noreferrer">{t("Project website", "Sito del progetto")}</a></div>
</div></article>
  </section>

  <section class="mb-12">
    <div class="flex flex-wrap items-center gap-2 mb-2">
      <h2 id="research-tools" class="text-3xl flex-1 min-w-[12rem] font-bold">{t("Research Tools and Artifacts", "Strumenti e materiali di ricerca")}</h2>
      <span class="badge badge-success shrink-0 whitespace-nowrap">{t("Available", "Disponibile")}</span>
    </div>

    <p class="mb-5 opacity-80">
      {t("Public software and reproducibility artifacts developed from my PhD research on blockchain benchmarking, network topologies, experimental control, and data-driven protocol evaluation.", "Codice e dati per riprodurre gli esperimenti del mio dottorato e confrontare il comportamento dei protocolli blockchain in diverse condizioni di rete.")}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body h-full">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="card-title">
              {t("Lilith - Topology-Aware Blockchain Benchmarking", "Lilith – Benchmark delle blockchain in condizioni di rete controllate")}
            </h3>
            <span class="badge badge-success">{t("Public GitHub repo", "Repository pubblico su GitHub")}</span>
          </div>

          <p>
            {t("A research-oriented benchmarking framework for evaluating blockchain systems under controlled network topologies, realistic workloads, reproducible execution assumptions, and topology-aware experimental conditions.", "Lilith permette di confrontare diverse blockchain con topologie controllate e carichi di lavoro realistici, ripetendo gli esperimenti nelle stesse condizioni.")}
          </p>

          <div class="mt-auto pt-4 space-y-3">
            <div class="flex flex-wrap gap-2">
              <span class="badge badge-outline">Benchmarking</span>
              <span class="badge badge-outline">{t("Network emulation", "Emulazione di rete")}</span>
              <span class="badge badge-outline">{t("Reproducibility", "Riproducibilità")}</span>
              <span class="badge badge-outline">Git LFS</span>
            </div>

            <div class="card-actions justify-end">
              <a
                class="btn btn-sm btn-outline"
                href={localPath("/research/lilith-benchmarking-framework")}
              >
                {t("Read artifact page", "Scheda dello strumento")}
              </a>

              <a
                class="btn btn-sm btn-primary"
                href="https://github.com/vindipe/lilith"
                target="_blank"
                rel="noopener noreferrer"
              >
                {t("Open repository", "Apri il repository")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <div class="flex flex-wrap items-center gap-2 mb-2">
      <h2 id="interactive-tools" class="text-3xl flex-1 min-w-[12rem] font-bold">{t("Interactive Research Tools", "Strumenti di ricerca interattivi")}</h2>
      <span class="badge badge-success shrink-0 whitespace-nowrap">{t("Available", "Disponibile")}</span>
    </div>

    <p class="mb-5 opacity-80">
      {t("Small web tools that turn my research artifacts into interactive demos, making methods, datasets, and evaluation logic easier to explore directly from the browser.", "Prova i metodi di valutazione e consulta i dati direttamente nel browser.")}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body h-full">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="card-title">CryptoEntropy Explorer</h3>
            <span class="badge badge-success">{t("Available", "Disponibile")}</span>
          </div>

          <p>
            {t("An interactive EB-index playground for exploring normalized and entropy-derived cryptocurrency datasets. Users can toggle assets, choose attribute sets, assign custom utility weights, and recompute the index live in the browser.", "CryptoEntropy Explorer permette di confrontare criptovalute con l’EB-index. Scegli le valute e gli indicatori economici, imposta i pesi e guarda come cambia il punteggio.")}
          </p>

          <div class="mt-auto pt-4 space-y-3">
            <div class="flex flex-wrap gap-2">
              <span class="badge badge-outline">EB-index</span>
              <span class="badge badge-outline">Dashboard</span>
              <span class="badge badge-outline">{t("Coin Metrics-derived", "Dati Coin Metrics")}</span>
              <span class="badge badge-outline">DLT '25</span>
            </div>

            <div class="card-actions justify-end">
              <a
                class="btn btn-sm btn-outline"
                href={localPath("/research/entropy-based-economic-efficiency")}
              >
                {t("Read research page", "Approfondisci la ricerca")}
              </a>

              <a
                class="btn btn-sm btn-primary"
                href={localPath("/projects/cryptoentropy-explorer")}
              >
                {t("Open dashboard", "Apri lo strumento")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <div class="flex flex-wrap items-center gap-2 mb-2">
      <h2 id="practical-projects" class="text-3xl flex-1 min-w-[12rem] font-bold">{t("Practical Projects", "Prototipi e altri progetti")}</h2>
      <span class="badge badge-warning shrink-0 whitespace-nowrap">{t("Projects", "Progetti")}</span
      >
    </div>

    <p class="mb-5 opacity-80">
      {t("A growing collection of practical repositories, exercises, prototypes, and hands-on technical experiences developed to strengthen engineering skills, document learning paths, and demonstrate applied work across different technologies.", "Prototipi, esercizi e codice nati per sperimentare con tecnologie diverse e documentare le soluzioni adottate.")}
    </p>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <div class="network-protected card bg-base-100 shadow-md">
    <div class="card-body h-full">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="card-title">{t("Restaurant Solid Blockchain Prototype", "Prototipo per la ristorazione con Solid e blockchain")}</h3>
        <span class="badge badge-success">{t("Available", "Disponibile")}</span>
      </div>

      <p>
        {t("A legacy MSc thesis prototype modernized into a reproducible local demo, combining a restaurant ordering workflow, Solid Pods concepts, mock blockchain payment verification, PDF bill generation, and safe Solid rebuild tooling.", "La demo della mia tesi magistrale riproduce un ordine al ristorante. Gestisce i dati con Solid Pods, simula la verifica di un pagamento su blockchain e genera il conto in PDF. Il repository spiega come ricreare l’ambiente in locale.")}
      </p>

      <div class="mt-auto pt-4 space-y-3">
        <div class="flex flex-wrap gap-2">
          <span class="badge badge-outline">Node.js</span>
          <span class="badge badge-outline">Solid Pods</span>
          <span class="badge badge-outline">{t("Mock payment", "Pagamento simulato")}</span>
          <span class="badge badge-outline">{t("PDF bills", "Conti in PDF")}</span>
        </div>

        <div class="card-actions justify-end">
          <a
            class="btn btn-sm btn-outline"
            href={localPath("/research/decentralized-accounting-system")}
          >
            {t("Read thesis page", "Vai alla tesi")}
          </a>

          <a
            class="btn btn-sm btn-primary"
            href="https://github.com/vindipe/restaurant-solid-blockchain-prototype"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t("Open repository", "Apri il repository")}
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
  </section>
  <section class="mb-12" aria-labelledby="research-interests">
    <h2 id="research-interests" class="text-3xl font-bold mb-5">{t("Research interests", "Interessi di ricerca")}</h2>
    <p class="mb-5 opacity-80">{t("Areas I am interested in exploring alongside my projects and tools.", "Altri temi che mi interessa studiare.")}</p>

    <div class="mb-8">
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <h3 class="text-2xl flex-1 min-w-[12rem] font-bold">{t("Countering Wealth Concentration", "Ridurre la concentrazione della ricchezza")}</h3>
        <span class="badge badge-warning shrink-0 whitespace-nowrap">{t("Research interest", "Tema di ricerca")}</span
        >
      </div>

      <p class="mb-5 opacity-80">
        {t("Exploratory work on how blockchain systems, digital assets, incentive mechanisms, and decentralized infrastructures can be designed or evaluated to reduce excessive concentration of value, ownership, governance power, and access to economic opportunities.", "Vorrei capire se blockchain, asset digitali e incentivi possano distribuire più ampiamente proprietà, valore e potere decisionale, rendendo più accessibili le opportunità economiche.")}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="network-protected card bg-base-100 shadow-md">
          <div class="card-body">
            <div class="flex flex-wrap items-center gap-2">
              <h4 class="card-title text-lg">{t("Wealth concentration analysis toolkit", "Strumenti per analizzare la concentrazione della ricchezza")}</h4>
              <span class="badge badge-warning">{t("Interest", "Da approfondire")}</span>
            </div>

            <p>
              {t("A planned set of data-analysis workflows for studying concentration patterns in token ownership, protocol governance, and digital-asset ecosystems.", "Strumenti di analisi per capire in quali mani si concentrano i token e il potere decisionale nei protocolli e negli ecosistemi di asset digitali.")}
            </p>

            <div class="card-actions justify-end mt-4">
              <span class="badge badge-outline">{t("Token distribution", "Distribuzione dei token")}</span>
              <span class="badge badge-outline">Governance</span>
              <span class="badge badge-outline">{t("Analytics", "Analisi dei dati")}</span>
            </div>
          </div>
        </div>

        <div class="network-protected card bg-base-100 shadow-md">
          <div class="card-body">
            <div class="flex flex-wrap items-center gap-2">
              <h4 class="card-title text-lg">{t("Fair value distribution models", "Modelli per distribuire il valore in modo più equo")}</h4>
              <span class="badge badge-warning">{t("Interest", "Da approfondire")}</span>
            </div>

            <p>
              {t("Conceptual and experimental work on mechanisms that could support broader participation, fairer access, and less extractive forms of digital value creation.", "Studio di meccanismi che allarghino la partecipazione e l’accesso e distribuiscano in modo più equo il valore generato.")}
            </p>

            <div class="card-actions justify-end mt-4">
              <span class="badge badge-outline">{t("Mechanism design", "Progettazione degli incentivi")}</span>
              <span class="badge badge-outline">{t("Digital assets", "Asset digitali")}</span>
              <span class="badge badge-outline">{t("Economic fairness", "Equità economica")}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div>
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <h3 class="text-2xl flex-1 min-w-[12rem] font-bold">{t("Real-World Assets - RWA", "Beni e attività del mondo reale (RWA)")}</h3>
        <span class="badge badge-warning shrink-0 whitespace-nowrap">{t("Research interest", "Tema di ricerca")}</span
        >
      </div>

      <p class="mb-5 opacity-80">
        {t("Early-stage work on the representation, evaluation, and possible tokenization of real-world assets within blockchain-based infrastructures, with attention to ownership, verification, governance, market structure, and practical deployment constraints.", "Come si possono rappresentare, valutare e tokenizzare beni e attività del mondo reale su una blockchain? La ricerca riguarda proprietà, verifica, governance, struttura dei mercati e ostacoli all’adozione.")}
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="network-protected card bg-base-100 shadow-md">
          <div class="card-body">
            <div class="flex flex-wrap items-center gap-2">
              <h4 class="card-title text-lg">{t("RWA system design notes", "Progettazione di sistemi per gli RWA")}</h4>
              <span class="badge badge-warning">{t("Interest", "Da approfondire")}</span>
            </div>

            <p>
              {t("A developing research and engineering track focused on how physical or off-chain assets can be represented, verified, transferred, and governed through digital-asset infrastructures.", "Studio di come rappresentare, verificare e trasferire beni fisici o attività fuori dalla blockchain, e di come stabilire chi può gestirli.")}
            </p>

            <div class="card-actions justify-end mt-4">
              <span class="badge badge-outline">{t("Asset tokenization", "Tokenizzazione degli asset")}</span>
              <span class="badge badge-outline">{t("Verification", "Verifica")}</span>
              <span class="badge badge-outline">Governance</span>
            </div>
          </div>
        </div>

        <div class="network-protected card bg-base-100 shadow-md">
          <div class="card-body">
            <div class="flex flex-wrap items-center gap-2">
              <h4 class="card-title text-lg">{t("RWA benchmarking perspective", "Benchmarking delle piattaforme RWA")}</h4>
              <span class="badge badge-warning">{t("Interest", "Da approfondire")}</span>
            </div>

            <p>
              {t("A planned evaluation angle connecting RWA platforms with system performance, operational assumptions, transaction costs, settlement behavior, and infrastructure reliability.", "Valutazione delle piattaforme RWA in base a prestazioni, condizioni operative, costi e regolamento delle transazioni e affidabilità dell’infrastruttura.")}
            </p>

            <div class="card-actions justify-end mt-4">
              <span class="badge badge-outline">Benchmarking</span>
              <span class="badge badge-outline">{t("Settlement", "Regolamento")}</span>
              <span class="badge badge-outline">{t("Infrastructure", "Infrastrutture")}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
