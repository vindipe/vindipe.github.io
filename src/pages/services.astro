---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
const language = locale === "it" ? "it-IT" : "en-US";

const skills = [
  {
    name: t("Web development", "Sviluppo web"),
    detail: t("Interfaces, responsive layouts and deployment.", "Interfacce, layout per mobile e desktop, messa online."),
  },
  {
    name: t("Programming and automation", "Programmazione e automazione"),
    detail: t("Scripts, integrations and AI tools.", "Script, integrazione tra strumenti e uso dell’IA."),
  },
  {
    name: t("Experiments and data analysis", "Sperimentazione e analisi dei dati"),
    detail: t("Test design, measurement and interpretation.", "Progettazione dei test, misurazione e lettura dei risultati."),
  },
  {
    name: t("Teaching and mentoring", "Formazione e affiancamento"),
    detail: t("Technical explanations, hands-on exercises and code review.", "Spiegazioni tecniche, esercizi pratici e revisione del codice."),
  },
];

const services = [
  {
    id: "consulting",
    name: t("Technical consulting", "Consulenza tecnica"),
    detail: t("Evaluate a technology choice or work through a specific problem.", "Valutare una scelta tecnica o affrontare un problema concreto."),
    rates: { EUR: 55, USD: 65 },
  },
  {
    id: "mentoring",
    name: "Mentoring",
    detail: t("Plan your next steps and get feedback as you build your own project.", "Impostare i prossimi passi e ricevere un riscontro mentre lavori al tuo progetto."),
    rates: { EUR: 45, USD: 50 },
  },
  {
    id: "tutoring",
    name: t("Tutoring", "Tutoraggio"),
    detail: t("One-to-one lessons in programming, AI tools or blockchain.", "Lezioni individuali su programmazione, strumenti di IA o blockchain."),
    rates: { EUR: 35, USD: 40 },
  },
  {
    id: "website",
    name: t("Website development", "Realizzazione di siti web"),
    detail: t("Build a website, add a page or improve an existing site.", "Creare un sito, aggiungere una pagina o migliorare un sito esistente."),
    rates: { EUR: 50, USD: 60 },
  },
];

const currencies = ["EUR", "USD"] as const;
const formatRate = new Intl.NumberFormat(language, {
  style: "currency", currency: "EUR", currencyDisplay: "narrowSymbol", maximumFractionDigits: 0,
});
const appointmentHours = [[9, 12], [14, 17]];
const slots = appointmentHours.map(([start, end]) => (
  Array.from({ length: (end - start) * 2 }, (_, index) => {
    const hour = String(start + Math.floor(index / 2)).padStart(2, "0");
    return `${hour}:${index % 2 === 0 ? "00" : "30"}`;
  })
));
const email = "vincenzopaolo.diperna@outlook.com";
const generalTopic = t("Discuss a project", "Parlare di un progetto");
---

<BaseLayout
  title={t("Digital Studio | Independent services | Vincenzo Di Perna", "Digital Studio | Servizi indipendenti | Vincenzo Di Perna")}
  description={t(
    "Independent technical consulting, mentoring, tutoring and web development. Explore hourly rates and request a free 30-minute call.",
    "Consulenza tecnica, mentoring, tutoraggio e sviluppo web come attività indipendente. Consulta le tariffe orarie e richiedi un colloquio gratuito di 30 minuti."
  )}
  sideBarActiveItemID="services"
>
  <digital-studio class="studio" data-language={language} data-email={email} data-general-topic={generalTopic}>
    <header class="studio-header">
      <h1>Digital Studio</h1>
      <p class="studio-lead">{t(
        "I offer technical consulting, mentoring, tutoring and web development independently of my job and academic research.",
        "Offro consulenza tecnica, mentoring, tutoraggio e sviluppo web come attività indipendente dal mio lavoro e dalla mia ricerca accademica."
      )}</p>
      <p class="studio-note">{t(
        "Before taking on a project, I check that it is compatible with my professional commitments, including confidentiality and any potential conflicts of interest.",
        "Prima di accettare un incarico, verifico che sia compatibile con i miei impegni professionali e con gli obblighi di riservatezza, e valuto eventuali conflitti di interesse."
      )}</p>
    </header>

    <section class="studio-section" aria-labelledby="skills">
      <h2 id="skills">{t("What I can help with", "Le competenze che metto a disposizione")}</h2>
      <dl class="skill-list">
        {skills.map(({ name, detail }) => (
          <div>
            <dt>{name}</dt>
            <dd>{detail}</dd>
          </div>
        ))}
      </dl>
      <p>{t(
        "You can hire me for a single skill or combine several for a specific outcome. A website brings together design, development and deployment. An experiment can bring together test design, automation and data analysis.",
        "Puoi richiedere una singola competenza oppure combinarne più di una per ottenere un risultato. Un sito mette insieme progettazione, sviluppo e pubblicazione. Un esperimento può richiedere la definizione dei test, la loro automazione e l’analisi dei risultati."
      )}</p>
    </section>

    <section class="studio-section" aria-labelledby="rates">
      <h2 id="rates">{t("Services and hourly rates", "Servizi e tariffe orarie")}</h2>
      <p>{t(
        "Rates vary by activity. Select a service to include it in your appointment request.",
        "La tariffa varia a seconda dell’attività. Seleziona un servizio per indicarlo nella richiesta di appuntamento."
      )}</p>
      <div class="rate-heading">
        <span>{t("Indicative hourly rates", "Tariffe orarie indicative")}</span>
        <fieldset class="currency-switch">
          <legend class="sr-only">{t("Currency", "Valuta")}</legend>
          {currencies.map((currency) => (
            <label>
              <input class="sr-only" type="radio" name="studio-currency" value={currency} checked={currency === "EUR"} />
              <span>{currency}</span>
            </label>
          ))}
        </fieldset>
      </div>
      <fieldset class="service-list">
        <legend class="sr-only">{t("Choose a service", "Scegli un servizio")}</legend>
        {services.map((service) => (
          <label class="service-row">
            <input type="radio" name="studio-service" value={service.id} data-name={service.name} />
            <span class="service-text">
              <strong>{service.name}</strong>
              <span>{service.detail}</span>
            </span>
            <span class="rate-cell">
              <strong data-rate data-eur={service.rates.EUR} data-usd={service.rates.USD}>{formatRate.format(service.rates.EUR)}</strong>
              <span>{t("/ hour", "/ ora")}</span>
            </span>
          </label>
        ))}
      </fieldset>
    </section>

    <section class="studio-section pricing" aria-labelledby="pricing">
      <h2 id="pricing">{t("By the hour or by the project?", "A ore o a progetto?")}</h2>
      <p>{t(
        "With hourly billing, we agree on the rate, estimated hours and spending limit up front. You pay for the time actually spent. If the scope changes, we discuss any additional work before I go ahead.",
        "Con la tariffa oraria concordiamo prima la tariffa, una stima delle ore e il limite di spesa. Paghi il tempo effettivamente impiegato. Se il lavoro cambia, concordiamo le attività aggiuntive prima di procedere."
      )}</p>
      <div class="pricing-example">
        <h3>{t("Example: a simple website", "Esempio: un sito web semplice")}</h3>
        <p>{t(
          "Say you receive a fixed quote of €500. If I can deliver the same scope in one hour at €50/hour, you pay €50, or 90% less in this example. The final cost depends on the hours the work actually takes.",
          "Supponiamo che tu riceva un preventivo fisso di 500 €. Se posso fare lo stesso lavoro in un’ora a 50 €/ora, paghi 50 €, cioè il 90% in meno in questo esempio. Il costo finale dipende dal tempo che il lavoro richiede."
        )}</p>
      </div>
      <p>{t(
        "For work with clearly defined deliverables, I can also quote a fixed total for the agreed scope. We can compare that total with the estimated hourly cost before choosing.",
        "Per un lavoro con risultati ben definiti posso anche proporti un prezzo fisso per le attività concordate. Prima di scegliere, possiamo confrontarlo con il costo orario stimato."
      )}</p>
    </section>

    <section class="studio-section studio-booking" aria-labelledby="appointment">
      <div>
        <h2 id="appointment">{t("A free 30-minute call", "Un colloquio gratuito di 30 minuti")}</h2>
        <p>{t(
          "Tell me what you have in mind. We’ll discuss the work and how to price it.",
          "Raccontami cosa ti serve. Vediamo insieme cosa c’è da fare e come stimare il costo."
        )}</p>
      </div>
      <button class="btn btn-primary studio-cta" type="button" data-open-booking aria-haspopup="dialog" hidden>
        {t("Book an appointment", "Prenota un appuntamento")}
      </button>
      <noscript><a href={inLanguage("/contact/", locale)}>{t("Request an appointment by email", "Richiedi un appuntamento via email")}</a></noscript>
    </section>

    <dialog class="booking-dialog" aria-labelledby="booking-title" aria-describedby="booking-note">
      <div class="booking-header">
        <h3 id="booking-title">{t("Request a free appointment", "Richiedi un appuntamento gratuito")}</h3>
        <form method="dialog">
          <button class="btn btn-ghost btn-circle btn-sm" aria-label={t("Close", "Chiudi")}>×</button>
        </form>
      </div>
      <p class="booking-summary" data-booking-summary>{generalTopic}</p>
      <p id="booking-note">{t(
        "Choose a time for your free 30-minute call. I’ll confirm the appointment by email.",
        "Scegli un orario per il colloquio gratuito di 30 minuti. Ti confermerò l’appuntamento via email."
      )}</p>

      <form class="booking-form" data-booking-form data-subject={t("Digital Studio · Free appointment request", "Digital Studio · Richiesta appuntamento gratuito")}>
        <label class="booking-date">
          {t("Preferred date", "Data preferita")}
          <input class="input input-bordered" type="date" name="date" required />
        </label>
        <fieldset class="booking-times" aria-describedby="booking-timezone" disabled>
          <legend>{t("Start time", "Ora di inizio")}</legend>
          <p id="booking-timezone">{t(
            "Italy time (Europe/Rome) · 09:00–12:00 and 14:00–17:00",
            "Ora italiana (Europe/Rome) · 09:00–12:00 e 14:00–17:00"
          )}</p>
          {slots.map((times, index) => (
            <div class="slot-group" role="group" aria-label={index === 0 ? t("Morning", "Mattina") : t("Afternoon", "Pomeriggio")}>
              {times.map((time) => (
                <label class="slot">
                  <input type="radio" class="sr-only" name="time" value={time} required />
                  <span>{time}</span>
                </label>
              ))}
            </div>
          ))}
        </fieldset>
        <p class="studio-note" data-no-times hidden>{t(
          "Choose another date to see more times.",
          "Scegli un’altra data per vedere altri orari."
        )}</p>
        <button class="btn btn-primary" type="submit">{t("Open email", "Apri email")}</button>
      </form>
    </dialog>
  </digital-studio>
</BaseLayout>

<script>
  const romeClock = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Rome",
    year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
  });

  class DigitalStudio extends HTMLElement {
    #initialized = false;

    connectedCallback() {
      if (this.#initialized) return;
      this.#initialized = true;

      const dialog = this.querySelector("dialog")!;
      const summary = dialog.querySelector<HTMLElement>("[data-booking-summary]")!;
      const form = dialog.querySelector<HTMLFormElement>("[data-booking-form]")!;
      const date = form.querySelector<HTMLInputElement>('[name="date"]')!;
      const timeGroup = form.querySelector<HTMLFieldSetElement>(".booking-times")!;
      const times = [...timeGroup.querySelectorAll<HTMLInputElement>('[name="time"]')];
      const noTimes = form.querySelector<HTMLElement>("[data-no-times]")!;
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const italian = this.dataset.language === "it-IT";

      const updateRates = () => {
        const currency = this.querySelector<HTMLInputElement>('[name="studio-currency"]:checked')!.value;
        const format = new Intl.NumberFormat(this.dataset.language, {
          style: "currency", currency, currencyDisplay: "narrowSymbol", maximumFractionDigits: 0,
        });
        for (const price of this.querySelectorAll<HTMLElement>("[data-rate]")) {
          price.textContent = format.format(Number(price.dataset[currency.toLowerCase()]));
        }
      };

      const updateTimes = () => {
        const parts = Object.fromEntries(romeClock.formatToParts(new Date()).map(({ type, value }) => [type, value]));
        const today = `${parts.year}-${parts.month}-${parts.day}`;
        const now = `${parts.hour}:${parts.minute}`;

        date.min = today;
        timeGroup.disabled = !date.value || !date.validity.valid;
        for (const time of times) {
          time.disabled = date.value === today && time.value <= now;
          if (time.disabled) time.checked = false;
        }
        const noneAvailable = times.every((time) => time.disabled);
        noTimes.hidden = !noneAvailable;
        submitButton.disabled = timeGroup.disabled || noneAvailable;
      };

      for (const input of this.querySelectorAll('[name="studio-currency"]')) {
        input.addEventListener("change", updateRates);
      }
      updateRates();

      const bookingButton = this.querySelector<HTMLButtonElement>("[data-open-booking]")!;
      bookingButton.hidden = false;
      bookingButton.addEventListener("click", () => {
        const service = this.querySelector<HTMLInputElement>('[name="studio-service"]:checked');
        summary.textContent = service?.dataset.name ?? this.dataset.generalTopic!;
        updateTimes();
        dialog.showModal();
      });

      date.addEventListener("change", updateTimes);
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        updateTimes();
        const time = times.find((slot) => slot.checked && !slot.disabled);
        if (!form.reportValidity() || !time) return;

        const body = italian
          ? `Ciao Vincenzo,\n\nvorrei richiedere un colloquio gratuito di 30 minuti.\nArgomento: ${summary.textContent}.\nData e ora preferite: ${date.value}, ${time.value} (Europe/Rome).\n\nIl mio progetto:\n\nGrazie!`
          : `Hi Vincenzo,\n\nI’d like to request a free 30-minute call.\nTopic: ${summary.textContent}.\nPreferred date and time: ${date.value}, ${time.value} (Europe/Rome).\n\nAbout my project:\n\nThank you!`;
        location.href = `mailto:${this.dataset.email}?subject=${encodeURIComponent(form.dataset.subject!)}&body=${encodeURIComponent(body)}`;
      });
    }
  }

  customElements.define("digital-studio", DigitalStudio);
</script>

<style>
  .studio {
    display: block;
    width: min(48rem, 100%);
    margin-inline: auto;
    padding: clamp(1.1rem, 3.5vw, 2.5rem);
    border: 1px solid #e4e2d9;
    border-radius: 0.375rem;
    background: #fff;
    color: #282723;
  }

  .studio-header h1 {
    margin-bottom: 0.75rem;
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.12;
    letter-spacing: -0.045em;
    font-weight: 750;
  }

  .studio p, .studio dd { text-align: start; }
  .studio-lead { max-width: 40rem; font-size: 1.12rem; line-height: 1.6; }
  .studio-note { margin-top: 0.6rem; font-size: 0.92rem; color: #5c5850; }

  .studio-section {
    margin-top: clamp(1.55rem, 4vw, 2.4rem);
    padding-top: clamp(1.15rem, 3vw, 1.65rem);
    border-top: 1px solid #e2ded4;
  }

  .studio-section h2 {
    margin-bottom: 0.45rem;
    font-size: 1.35rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.024em;
  }

  .skill-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.25rem;
    margin: 0.85rem 0 1rem;
  }

  .skill-list dt { font-weight: 700; }
  .skill-list dd { color: #5c5850; font-size: 0.94rem; }

  .rate-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid #d5d0c3;
    font-weight: 650;
  }

  .currency-switch { display: inline-flex; gap: 0.15rem; }
  .currency-switch span, .slot span {
    display: block;
    padding: 0.4rem 0.55rem;
    border-radius: 0.25rem;
    text-align: center;
    font-size: 0.87rem;
    font-weight: 650;
    cursor: pointer;
  }

  .currency-switch input:checked + span, .slot input:checked + span {
    background: #fff0b5;
    color: #3d2d07;
  }

  .currency-switch input:focus-visible + span, .slot input:focus-visible + span {
    outline: 2px solid #805000;
    outline-offset: 2px;
  }

  .service-list { min-width: 0; }
  .service-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.65rem;
    padding: 0.72rem 0.4rem;
    border-bottom: 1px solid #e2ded4;
    cursor: pointer;
  }

  .service-row:hover, .service-row:has(input:checked) { background: #fbf8ed; }
  .service-row input { width: 1rem; height: 1rem; margin-top: 0.22rem; accent-color: #805000; }
  .service-text > span { display: block; color: #5c5850; font-size: 0.94rem; }
  .rate-cell { text-align: end; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rate-cell > span { font-size: 0.85rem; color: #5c5850; }

  .pricing-example {
    margin: 0.9rem 0;
    padding: 0.75rem 0.9rem;
    border-inline-start: 3px solid #b18028;
    background: #faf7ef;
  }

  .pricing-example h3 { margin-bottom: 0.25rem; font-weight: 700; }

  .studio-booking {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem 1rem;
    flex-wrap: wrap;
  }

  .studio-cta[hidden] { display: none; }

  .booking-dialog {
    width: min(33rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: clamp(1rem, 4vw, 1.65rem);
    border: 1px solid #e2ded4;
    border-radius: 0.5rem;
    background: #fff;
    color: #282723;
  }

  .booking-dialog::backdrop { background: #22221ea3; }
  .booking-header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .booking-header h3 { font-size: 1.3rem; line-height: 1.25; font-weight: 700; }
  .booking-header button { font-size: 1.3rem; }
  .booking-summary { margin: 0.35rem 0 0.4rem; font-weight: 650; }
  .booking-form { display: grid; gap: 0.75rem; margin-top: 0.9rem; }
  .booking-date { display: grid; gap: 0.3rem; font-weight: 650; }
  .booking-date input { width: min(100%, 13rem); min-width: 0; font-weight: 400; }
  .booking-times { min-width: 0; }
  .booking-times legend { font-weight: 650; }
  #booking-timezone { margin: 0.2rem 0 0.55rem; font-size: 0.85rem; color: #5c5850; }
  .slot-group { display: grid; grid-template-columns: repeat(auto-fit, minmax(3.65rem, 1fr)); gap: 0.35rem; }
  .slot-group + .slot-group { margin-top: 0.35rem; }
  .slot span { padding-inline: 0.25rem; border: 1px solid #d5d0c3; }
  .slot input:disabled + span, .booking-times:disabled .slot span { opacity: 0.45; cursor: default; }
  .booking-form > button { justify-self: start; }

  @media (max-width: 34rem) {
    .skill-list { grid-template-columns: 1fr; }
    .service-row { gap: 0.5rem; }
    .rate-cell > span { display: block; }
  }
</style>
