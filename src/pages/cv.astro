---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const publications = [
  {
    title:
      "The Impact of Network Topology on Performance Metrics and Energy Consumption for Blockchains: Towards Repeatable Benchmarking",
    badge: t("ACM DLT journal", "Rivista ACM DLT"),
    authors:
      t("Vincenzo P. Di Perna, Valerio Schiavoni, Miguel Matos, Francesco Fabris, and Marco Bernardo.", "Vincenzo P. Di Perna, Valerio Schiavoni, Miguel Matos, Francesco Fabris e Marco Bernardo."),
    venue:
      t("ACM Distributed Ledger Technologies: Research and Practice journal, 2026.", "Rivista ACM Distributed Ledger Technologies: Research and Practice, 2026."),
    links: [
      {
        label: t("Research page", "Scheda dello studio"),
        href: "/research/acm-dlt-network-topologies-blockchain-performance",
        primary: true,
      },
      {
        label: t("DOI / Paper", "Leggi l’articolo (DOI)"),
        href: "https://dl.acm.org/doi/10.1145/3828757",
        external: true,
      },
    ],
  },
  {
    title: "Dynamic Taxonomy: A Bridge from DeFi to TradFi",
    badge: "SSRN / CCAF",
    authors:
      t("Iqbal Mabruri, Carles Cerqueda, Christopher Jack, Alexis Lui, Yue Wu, Wenbin Wu, Vincenzo P. Di Perna, Keith Bear, and Bryan Zheng Zhang.", "Iqbal Mabruri, Carles Cerqueda, Christopher Jack, Alexis Lui, Yue Wu, Wenbin Wu, Vincenzo P. Di Perna, Keith Bear e Bryan Zheng Zhang."),
    venue:
      t("SSRN working paper developed in collaboration with the Cambridge Centre for Alternative Finance (CCAF).", "Documento di lavoro disponibile su SSRN, realizzato con il Cambridge Centre for Alternative Finance (CCAF)."),
    links: [
      {
        label: t("Research page", "Scheda dello studio"),
        href: "/research/dynamic-taxonomy-defi-tradfi",
        primary: true,
      },
      {
        label: "SSRN",
        href: "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5034378",
        external: true,
      },
      {
        label: t("CCAF experience", "Esperienza al CCAF"),
        href: "/research/ccaf-experience",
      },
    ],
  },
  {
    title:
      "An Entropy-Based Approach to Evaluating the Economic Efficiency of Cryptocurrencies",
    badge: "DLT '25",
    authors:
      t("Vincenzo P. Di Perna, Michele Foderaro, Francesco Fabris, and Marco Bernardo.", "Vincenzo P. Di Perna, Michele Foderaro, Francesco Fabris e Marco Bernardo."),
    venue:
      "Distributed Ledger Technology Workshop, CEUR Workshop Proceedings, Vol. 4105, 2025.",
    links: [
      {
        label: t("Research page", "Scheda dello studio"),
        href: "/research/entropy-based-economic-efficiency",
        primary: true,
      },
      {
        label: t("CEUR paper", "Articolo su CEUR"),
        href: "https://ceur-ws.org/Vol-4105/paper09.pdf",
        external: true,
      },
    ],
  },
  {
    title:
      "Blockchain Energy Consumption: Unveiling the Impact of Network Topologies",
    badge: "IEEE ICBC '25",
    authors:
      t("Vincenzo P. Di Perna, Valerio Schiavoni, Francesco Fabris, and Marco Bernardo.", "Vincenzo P. Di Perna, Valerio Schiavoni, Francesco Fabris e Marco Bernardo."),
    venue:
      t("Proceedings of the 2025 IEEE International Conference on Blockchain and Cryptocurrency.", "Atti della IEEE International Conference on Blockchain and Cryptocurrency, 2025."),
    links: [
      {
        label: t("Research page", "Scheda dello studio"),
        href: "/research/performance-energy-economic-efficiency",
        primary: true,
      },
      {
        label: "IEEE Xplore",
        href: "https://ieeexplore.ieee.org/document/11114569",
        external: true,
      },
    ],
  },
  {
    title: "Impact of Network Topologies on Blockchain Performance",
    badge: "ACM DEBS '25",
    authors:
      t("Vincenzo P. Di Perna, Marco Bernardo, Francesco Fabris, Sebastião Amaro, Miguel Matos, and Valerio Schiavoni.", "Vincenzo P. Di Perna, Marco Bernardo, Francesco Fabris, Sebastião Amaro, Miguel Matos e Valerio Schiavoni."),
    venue:
      t("Proceedings of the 19th ACM International Conference on Distributed and Event-Based Systems, 2025.", "Atti della 19ª ACM International Conference on Distributed and Event-Based Systems, 2025."),
    links: [
      {
        label: t("Research page", "Scheda dello studio"),
        href: "/research/topology-aware-blockchain-benchmarking",
        primary: true,
      },
      {
        label: t("DOI / Paper", "Leggi l’articolo (DOI)"),
        href: "https://dl.acm.org/doi/10.1145/3701717.3730540",
        external: true,
      },
    ],
  },
];
---

<BaseLayout
  title={t("CV | Research Software Engineer | Vincenzo Di Perna", "Curriculum | Vincenzo Di Perna")}
  description={t("Vincenzo Di Perna’s CV covers distributed systems, blockchain research, reproducible experiments, publications and software engineering.", "Il curriculum di Vincenzo Di Perna: ricerca e ingegneria del software, sistemi distribuiti, blockchain e sperimentazione riproducibile.")}
  sideBarActiveItemID="cv"
>
  <section class="mb-10">
    <h1 class="text-4xl font-bold mb-4">CV</h1>

    <p class="text-lg leading-relaxed opacity-90">
      {t("I am a Research Software Engineer with a PhD in blockchain. I have worked on distributed systems, experimental evaluation of blockchain protocols and digital asset data analysis.", "Sono un ingegnere del software con un dottorato (PhD) in blockchain. Ho lavorato su sistemi distribuiti, valutazione sperimentale dei protocolli blockchain e analisi dei dati sugli asset digitali.")}
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        class="btn btn-primary"
        href={t("/cv/Vincenzo_Di_Perna_CV_2026.pdf?v=20260901", "/cv/Vincenzo_Di_Perna_CV_IT.pdf")}
        target="_blank"
        rel="noopener noreferrer"
      >
        {t("Download CV", "Scarica il CV")}
      </a>

      <a
        class="btn btn-outline"
        href="https://github.com/vindipe"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>

      <a
        class="btn btn-outline"
        href="https://www.linkedin.com/in/vincenzo-di-perna/"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>

      <a
        class="btn btn-outline"
        href="https://orcid.org/0009-0003-8834-9900"
        target="_blank"
        rel="me noopener noreferrer"
      >
        ORCID
      </a>
    </div>
  </section>

  <section class="mb-10">
    <h2 id="profile" class="text-3xl w-full font-bold mb-5">{t("Profile", "Profilo")}</h2>

    <div class="text-justify leading-relaxed">
      <p class="mb-4">
        {t("During my PhD, I designed benchmarking tools and procedures to compare blockchains across workloads, network topologies and operating conditions. I used them to study latency, energy use and the repeatability and predictability of performance measurements.", "Durante il dottorato ho progettato strumenti e procedure per ripetere gli esperimenti e confrontare le blockchain al variare del carico, della topologia di rete e delle condizioni operative. Li ho usati per studiare la latenza, i consumi e la ripetibilità e prevedibilità delle misure di prestazione.")}
      </p>

      <p class="mb-4">
        {t("I also worked on data and protocols for digital assets, decentralized finance and central bank digital currencies (CBDCs).", "Ho lavorato anche su dati e protocolli per gli asset digitali, la finanza decentralizzata e le valute digitali di banca centrale (CBDC).")}
      </p>

      <p>{t("I expect to join the University of Neuchâtel on 1 February 2027 as a postdoctoral researcher and scientific coordinator of CIRCULA. The SNSF-funded project will study expiry and renewal in blockchains.", "Dal 1° febbraio 2027 è previsto il mio ingresso all’Università di Neuchâtel come ricercatore post-dottorale e coordinatore scientifico di CIRCULA. Il progetto, finanziato dal Fondo nazionale svizzero (FNS), studierà la scadenza e il rinnovo nelle blockchain.")}</p>
    </div>
  </section>

  <section class="mb-10">
    <h2 id="experience" class="text-3xl w-full font-bold mb-5">
      {t("Research & Engineering Experience", "Esperienze di ricerca e sviluppo")}
    </h2>

    <div class="time-line-container grid gap-4">
      <TimeLineElement title={t("Incoming Postdoctoral Researcher and Scientific Coordinator - CIRCULA", "Ricercatore post-dottorale e coordinatore scientifico di CIRCULA (incarico previsto)")} subtitle={t("University of Neuchâtel · expected from 1 February 2027", "Università di Neuchâtel · avvio previsto il 1° febbraio 2027")}>
        {t("CIRCULA will study expiry and renewal in distributed ledgers with funding from the SNSF. I will coordinate scientific work on formal semantics, prototyping and evaluation.", "CIRCULA studierà la scadenza e il rinnovo nei registri distribuiti con il sostegno del Fondo nazionale svizzero (FNS). Il mio ruolo prevede il coordinamento della ricerca sulla semantica formale, sullo sviluppo dei prototipi e sulla loro valutazione.")}
        <br /><a href={localPath("/research/circula")} class="btn btn-xs btn-outline mt-3">{t("Explore CIRCULA", "Scopri CIRCULA")}</a>
      </TimeLineElement>
      <TimeLineElement
        title={t("Blockchain Benchmarking & Distributed Systems Research", "Valutazione sperimentale delle blockchain e ricerca sui sistemi distribuiti")}
        subtitle={t("PhD research and related publications", "Ricerca di dottorato e pubblicazioni")}
      >
        {t("Designed, executed, and analyzed reproducible blockchain experiments across multiple platforms, workloads, and network conditions. Evaluated throughput, latency, energy usage, variability, repeatability, and performance predictability under controlled experimental settings. Recent outputs include an ACM DLT journal article on topology-aware blockchain performance evaluation.", "Ho progettato, condotto e analizzato esperimenti riproducibili con più piattaforme blockchain, carichi di lavoro e condizioni di rete. In ambiente controllato ho misurato throughput, latenza e consumi energetici e studiato la variabilità, la ripetibilità e la prevedibilità delle prestazioni. Un articolo sulla rivista ACM DLT approfondisce l’effetto della topologia di rete.")}
      </TimeLineElement>

      <TimeLineElement
        title={t("Lilith - A Topology-Aware Blockchain Benchmarking Framework", "Lilith – Strumenti per confrontare blockchain in reti controllate")}
        subtitle={t("Research artifact and experimental toolchain", "Software e strumenti per gli esperimenti")}
      >
        {t("I developed Lilith, a framework for testing blockchains that generates workloads, emulates networks, orchestrates experiments and analyzes their data. I used it to study the combined effect of network topology and workload on performance and energy consumption.", "Ho sviluppato un framework per testare le blockchain (Lilith) che genera i carichi di lavoro, emula la rete, coordina gli esperimenti e ne analizza i dati. L’ho usato per studiare l’effetto combinato di topologia e carico sulle prestazioni e sui consumi.")}

        <br />

        <a
          href={localPath("/research/lilith-benchmarking-framework")}
          class="btn btn-xs btn-outline mt-3"
        >
          {t("Open Lilith research page", "Vai alla pagina di Lilith")}
        </a>
      </TimeLineElement>

      <TimeLineElement
        title={t("Digital Assets & CBDC-Oriented Data Workflows", "Asset digitali e analisi dei dati per le CBDC")}
        subtitle={t("Protocol analytics, dashboards, and structured data analysis", "Analisi dei protocolli, dashboard e dati strutturati")}
      >
        {t("Worked on data-oriented analysis and dashboard concepts for digital assets, digital-asset and CBDC-related infrastructures, and blockchain ecosystem indicators, connecting technical protocol behavior with analytical and economic perspectives.", "Ho analizzato dati e progettato dashboard per studiare gli asset digitali, le infrastrutture per le CBDC e gli indicatori degli ecosistemi blockchain. Il lavoro mette in relazione il funzionamento dei protocolli con i fenomeni economici osservati.")}
      </TimeLineElement>

      <TimeLineElement
        title={t("Digital Asset Programme Intern", "Tirocinio nel Digital Asset Programme")}
        subtitle="Cambridge Centre for Alternative Finance"
      >
        {t("Research internship experience within the Digital Asset Programme, focused on digital assets, DeFi taxonomy, protocol classification, DeFi/TradFi mapping, and the Cambridge DeFi Navigator.", "Durante il tirocinio ho studiato come classificare i protocolli DeFi e descriverne i rapporti con la finanza tradizionale. Il lavoro è collegato al Cambridge DeFi Navigator.")}

        <br />

        <a href={localPath("/research/ccaf-experience")} class="btn btn-xs btn-outline mt-3">
          {t("Open CCAF experience page", "Approfondisci l’esperienza al CCAF")}
        </a>

      </TimeLineElement>

      <TimeLineElement
        title={t("Research Engineering & Reproducibility", "Ingegneria del software e riproducibilità")}
        subtitle={t("Software artifacts, datasets, pipelines, and experimental methodology", "Software, dataset, procedure e metodologia sperimentale")}
      >
        {t("Developed scripts, datasets, reproducible workflows, statistical analyses, and documentation to support repeatable experiments and transparent evaluation of blockchain systems.", "Ho preparato codice, dati, analisi statistiche e documentazione per ripetere gli esperimenti e rendere verificabile il confronto tra blockchain.")}
      </TimeLineElement>
    </div>
  </section>

  <section class="mb-10">
    <h2 id="tools-and-artifacts" class="text-3xl w-full font-bold mb-5">{t("Tools & Artifacts", "Strumenti e materiali")}</h2>

    <div class="grid gap-4">
      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">Lilith</h3>
          <p>
            {t("Topology-aware blockchain benchmarking framework integrating workload generation, network emulation, orchestration, and experiment analysis.", "Strumento per confrontare le blockchain che automatizza la generazione dei carichi, l’emulazione della rete, l’esecuzione e l’analisi degli esperimenti.")}
          </p>
          <div class="card-actions justify-end">
            <a
              class="btn btn-sm btn-primary"
              href={localPath("/research/lilith-benchmarking-framework")}
            >
              {t("Artifact page", "Scheda dello strumento")}
            </a>

            <a
              class="btn btn-sm btn-outline"
              href="https://doi.org/10.5281/zenodo.11409100"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t("Zenodo artifact", "Materiali su Zenodo")}
            </a>

            <a
              class="btn btn-sm btn-outline"
              href={localPath("/research/acm-dlt-network-topologies-blockchain-performance")}
            >
              {t("Related ACM DLT article", "Articolo correlato su ACM DLT")}
            </a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Blockchain Repeatability Dataset", "Dataset sulla ripetibilità dei benchmark blockchain")}</h3>
          <p>
            {t("Network-controlled dataset with 300 aggregate configurations for studying blockchain benchmark variability, repeatability, and performance predictability.", "Risultati aggregati per 300 configurazioni di rete, utili per studiare variabilità, ripetibilità e prevedibilità delle prestazioni.")}
          </p>
          <div class="card-actions justify-end">
            <a
              class="btn btn-sm btn-primary"
              href={localPath("/research/blockchain-repeatability-dataset")}
            >
              {t("Dataset page", "Scheda del dataset")}
            </a>

            <a
              class="btn btn-sm btn-outline"
              href="https://doi.org/10.5281/zenodo.17681717"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t("Zenodo dataset", "Dataset su Zenodo")}
            </a>

            <a
              class="btn btn-sm btn-outline"
              href="https://github.com/vindipe/blockchain-repeatability-benchmarking"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t("GitHub repository", "Repository GitHub")}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-10">
    <h2 id="publications" class="text-3xl w-full font-bold mb-5">{t("Publications", "Pubblicazioni")}</h2>

    <div class="grid gap-4">
      {
        publications.map((publication) => (
          <div class="card bg-base-100 shadow-md">
            <div class="card-body">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
                <h3 class="card-title">{publication.title}</h3>
                <span class="badge badge-secondary shrink-0">
                  {publication.badge}
                </span>
              </div>

              <p>{publication.authors}</p>
              <p class="opacity-80">{publication.venue}</p>

              <div class="card-actions justify-end">
                {publication.links.map((link) => (
                  <a
                    class:list={[
                      "btn btn-sm",
                      link.primary ? "btn-primary" : "btn-outline",
                    ]}
                    href={localPath(link.href)}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-10">
    <h2 id="education" class="text-3xl w-full font-bold mb-5">{t("Education", "Formazione")}</h2>

    <div class="time-line-container grid gap-4">
      <TimeLineElement
        title={t("PhD in Blockchain & Distributed Ledger Technology", "Dottorato in blockchain e tecnologie a registro distribuito")}
        subtitle={t("University of Camerino, Italy", "Università di Camerino, Italia")}
        date="2022-2026"
      >
        {t("Dissertation focused on comparing blockchain systems across performance, energy, repeatability, predictability, and economic-efficiency dimensions. Research included topology-aware benchmarking, reproducible experimentation, workload design, network emulation, and statistical analysis of blockchain system behavior.", "La tesi confronta prestazioni, consumi ed efficienza economica delle blockchain e studia quanto siano ripetibili e prevedibili i risultati. Combina carichi di lavoro progettati per gli esperimenti, emulazione della rete e analisi statistica.")}

        <br />

        <a
          href={localPath("/research/comparing-blockchains")}
          class="btn btn-xs btn-outline mt-3 mr-2"
        >
          {t("Open thesis page", "Vai alla tesi")}
        </a>

        <a
          href="/theses/phd-thesis-comparing-blockchains.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-xs btn-outline mt-3"
        >
          {t("Open PDF", "Apri il PDF")}
        </a>
      </TimeLineElement>

      <TimeLineElement
        title={t("MSc in ICT Solutions Architect", "Laurea magistrale in ICT Solutions Architect")}
        subtitle={t("University of Pisa, Italy", "Università di Pisa, Italia")}
        date="2019-2022"
      >
        {t("Graduate studies focused on ICT architectures, software systems, networks, security, and technical design of digital infrastructures.", "Formazione in architetture ICT, sistemi software, reti, sicurezza e progettazione di infrastrutture digitali.")}

        <br />

        <a
          href={localPath("/research/decentralized-accounting-system")}
          class="btn btn-xs btn-outline mt-3 mr-2"
        >
          {t("Open thesis page", "Vai alla tesi")}
        </a>

        <a
          href="/theses/master-thesis-decentralized-accounting-system.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-xs btn-outline mt-3"
        >
          {t("Open PDF", "Apri il PDF")}
        </a>
      </TimeLineElement>

      <TimeLineElement
        title={t("BSc in Computer Systems and Network Security", "Laurea triennale in Sicurezza dei sistemi e delle reti informatiche")}
        subtitle={t("University of Milan, Italy", "Università degli Studi di Milano, Italia")}
        date="2015-2019"
      >
        {t("Foundation in computer systems, operating systems, networks, cybersecurity, programming, and technical problem solving.", "Formazione di base in sistemi informatici, sistemi operativi, reti, sicurezza informatica, programmazione e risoluzione di problemi tecnici.")}

        <br />

        <a
          href="/theses/bachelor-thesis-threat-modeling-process.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-xs btn-outline mt-3"
        >
          {t("Open bachelor thesis PDF", "Apri il PDF della tesi triennale")}
        </a>
      </TimeLineElement>
    </div>
  </section>

  <section class="mb-10">
    <h2 id="certifications" class="text-3xl w-full font-bold mb-5">{t("Certifications", "Certificazioni")}</h2>

    <div class="time-line-container grid gap-4">
      <TimeLineElement
        title="Blockchain for Business Certificate"
        subtitle={t("SUPSI / USI / Franklin University Switzerland / City of Lugano", "SUPSI / USI / Franklin University Switzerland / Città di Lugano")}
        date="2023"
        variant="warning"
      >
        {t("Professional certificate focused on blockchain applications, business use cases, digital-asset-related innovation, and the connection between blockchain technologies, institutions, and real-world business contexts.", "Certificazione sulle applicazioni della blockchain e degli asset digitali nelle imprese e nelle istituzioni.")}
      </TimeLineElement>
    </div>
  </section>

  <section class="mb-10">
    <h2 id="technical-skills" class="text-3xl w-full font-bold mb-5">{t("Technical Skills", "Competenze tecniche")}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Programming, scripting & automation", "Programmazione, scripting e automazione")}</h3>

          <ul class="list-disc mx-6 grid gap-1">
            <li>
              {t("Python for orchestration, data processing, experiment automation, and analysis workflows", "Python per automatizzare e coordinare gli esperimenti, elaborare i dati e analizzare i risultati")}
            </li>
            <li>
              {t("Bash scripting for Linux automation, reproducible runs, and command-line pipelines", "Bash per automatizzare le attività su Linux e ripetere gli esperimenti da riga di comando")}
            </li>
            <li>
              {t("Rust familiarity for systems-oriented programming and low-level software concepts", "Familiarità con Rust e con la programmazione di sistema")}
            </li>
            <li>
              {t("JavaScript / TypeScript basics for web interfaces, personal-site tooling, and frontend integration", "Nozioni di JavaScript e TypeScript per interfacce web e sviluppo frontend")}
            </li>
            <li>
              {t("Familiarity with Go, C, and C++ from systems, networking, and academic contexts", "Familiarità con Go, C e C++ per la programmazione di rete e di sistema")}
            </li>
            <li>
              {t("Git, GitHub, branching, pull requests, repository organization, and basic CI workflows", "Git e GitHub: branch, pull request, gestione dei repository e basi di integrazione continua")}
            </li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Data analysis, statistics & visualization", "Analisi dei dati, statistica e visualizzazione")}</h3>

          <ul class="list-disc mx-6 grid gap-1">
            <li>
              {t("Structured analysis of benchmark outputs, logs, experimental traces, and performance datasets", "Analisi di benchmark, log, tracce sperimentali e dati sulle prestazioni")}
            </li>
            <li>
              {t("Throughput, latency, energy, variability, repeatability, and predictability metrics", "Misure di throughput, latenza e consumo energetico. Analisi di variabilità, ripetibilità e prevedibilità")}
            </li>
            <li>
              {t("Statistical reasoning for experimental comparison, including ANOVA and ICC-style variance analysis", "Confronto statistico degli esperimenti, anche con ANOVA e analisi della varianza basate sull’ICC")}
            </li>
            <li>
              {t("Data cleaning, aggregation, transformation, and reproducible analysis pipelines", "Pulizia, aggregazione e trasformazione dei dati in procedure di analisi riproducibili")}
            </li>
            <li>
              {t("Python-based analytics with notebooks, scripts, CSV/JSON processing, and publication-ready figures", "Analisi in Python con notebook e script, elaborazione di CSV e JSON, grafici per le pubblicazioni")}
            </li>
            <li>
              {t("Dashboard-style visual analytics for protocol, digital-asset, and infrastructure indicators", "Dashboard per visualizzare indicatori di protocolli, asset digitali e infrastrutture")}
            </li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Distributed systems & infrastructure", "Sistemi distribuiti e infrastrutture")}</h3>

          <ul class="list-disc mx-6 grid gap-1">
            <li>
              {t("Linux-based development, debugging, scripting, and experimental execution environments", "Sviluppo, debugging, scripting e sperimentazione su Linux")}
            </li>
            <li>
              {t("Docker-based deployment, containerized experiments, and reproducible software environments", "Distribuzione del software con Docker, esperimenti in container e ambienti riproducibili")}
            </li>
            <li>
              {t("Network emulation and controlled experimental topologies for distributed-system evaluation", "Emulazione di rete e topologie controllate per valutare sistemi distribuiti")}
