---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getRecentWorks } from "../data/recentWorks";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const latestWorks = getRecentWorks(Astro.url.pathname)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);
---

<BaseLayout
  title={t("Vincenzo Di Perna | Research Software Engineer", "Vincenzo Di Perna | Ingegnere del software per la ricerca")}
  description={t("Vincenzo Di Perna works on distributed systems, blockchain benchmarking and reproducible experiments. Explore publications, tools and research projects.", "Vincenzo Di Perna, ingegnere del software per la ricerca. Sviluppo strumenti per studiare le blockchain e i sistemi distribuiti con esperimenti riproducibili.")}
  sideBarActiveItemID="home"
  ogImage="/og/vincenzo-di-perna-og.png"
>
  <section class="pb-12 mt-5">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-8 items-center">
      <div class="order-2 lg:order-1">
        <h1>
          <span class="block text-5xl font-bold leading-tight">Vincenzo Di Perna</span>
          <span class="block text-3xl py-3 font-bold">
            {t("Research Software Engineer", "Ingegnere del software per la ricerca")}<br />
            {t("Distributed Systems, Blockchain & DLT", "Sistemi distribuiti, blockchain e registri distribuiti (DLT)")}
          </span>
        </h1>

        <p class="py-2 text-lg leading-relaxed max-w-3xl">
          {t("I hold a PhD in Blockchain & DLT, working at the intersection of distributed systems, blockchain benchmarking, reproducible experimentation, protocol evaluation, and digital-asset analytics.", "Ho un dottorato in blockchain e tecnologie a registro distribuito. Sviluppo strumenti per mettere alla prova i protocolli, ripetere gli esperimenti e analizzare i dati degli asset digitali.")}<br
          />
          {t("My work focuses on understanding how blockchain technology can reshape today’s traditional and digital infrastructures, and how these systems behave under realistic evaluation conditions involving networks, workloads, protocols, performance, energy use, repeatability, predictability, and economic efficiency.", "Mi interessa capire come le blockchain possano cambiare le infrastrutture esistenti e come si comportino fuori dalle condizioni ideali. Per questo confronto reti, carichi di lavoro e protocolli diversi e ne misuro gli effetti sulle prestazioni, sui consumi e sull’efficienza economica. Studio anche quanto siano ripetibili e prevedibili i risultati.")}<br
          />
          {t("From 1 February 2027, I will join the University of Neuchâtel as a postdoctoral researcher and scientific coordinator of CIRCULA, a new SNSF-funded project studying expiry and renewal in blockchain systems.", "Dal 1° febbraio 2027 è previsto il mio ingresso all’Università di Neuchâtel come ricercatore post-dottorale e coordinatore scientifico di CIRCULA. Il progetto, finanziato dal Fondo nazionale svizzero, studierà come gestire la scadenza e il rinnovo delle risorse digitali nelle blockchain.")}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={localPath("/projects")}>
            {t("View Projects and Tools", "Esplora progetti e strumenti")}
          </a>

          <a class="btn btn-outline" href={localPath("/cv")}> {t("View CV", "Consulta il CV")} </a>

          <a
            class="btn btn-outline"
            href="https://github.com/vindipe"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>

          <a
            class="btn btn-outline"
            href="https://www.linkedin.com/in/vincenzo-di-perna/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>

          <a
            class="btn btn-outline"
            href="https://orcid.org/0009-0003-8834-9900"
            target="_blank"
            rel="me noopener noreferrer"
          >
            ORCID
          </a>
        </div>
      </div>

      <div class="order-1 lg:order-2 flex flex-col items-center gap-5">
        <div class="avatar">
          <div
            class="w-56 rounded-2xl ring ring-primary ring-offset-base-100 ring-offset-4 shadow-xl"
          >
            <img src="/profile-small.webp" width="280" height="320" fetchpriority="high" decoding="async" alt={t("Portrait of Vincenzo Di Perna", "Ritratto di Vincenzo Di Perna")} />
          </div>
        </div>
        <a href={localPath("/research/circula")} aria-label={t("Explore CIRCULA", "Scopri CIRCULA")}><img src="/research/circula/wordmark.webp" alt="CIRCULA" width="450" height="155" class="w-40 h-auto rounded-lg" loading="lazy" /></a>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <div
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-3 mb-5"
    >
      <div>
        <h2 class="text-3xl w-full font-bold">{t("Recent uploads", "Ultimi aggiornamenti")}</h2>

        <p class="mt-2 opacity-80">
          {t("Latest research pages, publications, thesis work, artifacts, and technical outputs added to the site.", "Le novità del sito, dalle pubblicazioni e dalle tesi ai progetti e agli strumenti di ricerca.")}
        </p>
      </div>
    </div>

    <div class="space-y-4">
      {
        latestWorks.map((work) => (
          <HorizontalCard
            title={work.title}
            img={work.img}
            imgAlt={work.imgAlt}
            desc={work.desc}
            url={work.url}
            badge={work.badge}
            target={work.target ?? "_blank"}
          />
        ))
      }

    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl w-full font-bold mb-5">{t("More about me", "Il mio lavoro")}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Projects and Tools", "Progetti e strumenti")}</h3>

          <p>
            {t("Explore selected research artifacts, datasets, software tools, and experimental pipelines related to blockchain systems and digital assets.", "Software, dati e materiali per esplorare le blockchain e gli asset digitali e riprodurre gli esperimenti.")}
          </p>

          <div class="card-actions justify-end mt-4">
            <a class="btn btn-sm btn-outline" href={localPath("/projects")}>
              {t("Browse software and datasets", "Esplora software e dataset")}
            </a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Research & publications", "Ricerca e pubblicazioni")}</h3>

          <p>
            {t("Read more about my publications, research themes, artifacts, and work on blockchain benchmarking, performance, energy, and economic efficiency.", "Studi sulle prestazioni delle blockchain, sui consumi energetici e sull’efficienza economica, con i dati e gli strumenti per approfondirli.")}
          </p>

          <div class="card-actions justify-end mt-4">
            <a class="btn btn-sm btn-outline" href={localPath("/research")}>
              {t("View research", "Esplora la ricerca")}
            </a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">Blockchain 101</h3>

          <p>
            {t("Interactive blockchain fundamentals, visual explainers, and small playable labs on cryptography, peer-to-peer networks, consensus, smart contracts, tokens, and distributed infrastructures.", "Come funziona una blockchain? Prova i laboratori su crittografia, reti peer-to-peer, consenso, smart contract e token.")}
          </p>

          <div class="card-actions justify-end mt-4">
            <a class="btn btn-sm btn-outline" href={localPath("/tutorials")}>
              {t("Start learning", "Vai ai laboratori")}
            </a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">CV</h3>

          <p>
            {t("See a compact overview of my background, experience, publications, technical skills, and research engineering profile.", "Formazione, esperienze di ricerca, pubblicazioni e competenze tecniche.")}
          </p>

          <div class="card-actions justify-end mt-4">
            <a class="btn btn-sm btn-outline" href={localPath("/cv")}> {t("View CV", "Consulta il CV")} </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-12 text-center">
    <h2 class="text-3xl font-bold mb-4">{t("Let's connect", "Parliamone")}</h2>

    <a class="btn btn-primary" href={localPath("/contact")}> {t("Contact me", "Contattami")} </a>
  </section>
</BaseLayout>
