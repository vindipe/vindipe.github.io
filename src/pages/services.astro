---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
const language = locale === "it" ? "it-IT" : "en-US";

const services = [
  {
    id: "poster",
    name: t("Design a poster", "Creare una locandina"),
    description: t("Layout and graphics for an event or announcement, ready for print and social media.", "Impaginazione e grafica per un evento o un annuncio, pronte per la stampa e i social."),
    rates: { EUR: 20, USD: 25 },
    icon: "M4 3h16v18H4zM7 16l3-4 3 3 2-2 2 3M8 8h4",
  },
  {
    id: "website",
    name: t("Build a website", "Realizzare un sito vetrina"),
    description: t("A responsive website to present your work, business or project.", "Un sito adatto anche a smartphone per presentare la tua attività o il tuo progetto."),
    rates: { EUR: 40, USD: 45 },
    icon: "M3 4h18v16H3zM3 9h18M6 6.5h.01M9 6.5h.01M7 13h5m-5 3h9",
  },
  {
    id: "paper",
    name: t("Prepare a research paper", "Preparare un articolo scientifico"),
    description: t("Support with the structure, figures, editing and LaTeX typesetting of your manuscript.", "Supporto per la struttura del manoscritto, le figure, la revisione del testo e l’impaginazione in LaTeX."),
    rates: { EUR: 55, USD: 65 },
    icon: "M6 3h8l4 4v14H6zM14 3v5h4M9 12h6m-6 4h6",
  },
  {
    id: "mentoring",
    name: t("Book a tutoring session", "Fare una sessione di tutoraggio"),
    description: t("One-to-one mentoring in programming, AI tools or blockchain, with practical exercises.", "Una sessione individuale di mentoring su programmazione, strumenti di IA o blockchain, con esercizi pratici."),
    rates: { EUR: 35, USD: 40 },
    icon: "m2 9 10-5 10 5-10 5zM6 11v5c3 3 9 3 12 0v-5m4-2v6",
  },
  {
    id: "automation",
    name: t("Automate a workflow", "Automatizzare un’attività"),
    description: t("Connect tools and automate repetitive steps, such as file processing or reporting.", "Collegamento tra strumenti e automazione di passaggi ripetitivi, come l’elaborazione di file o la creazione di report."),
    rates: { EUR: 50, USD: 60 },
    icon: "M3 3h6v6H3zM15 15h6v6h-6zM15 3h6v6h-6zM9 6h6m3 3v6",
  },
];

const currencies = ["EUR", "USD"] as const;
const initial = services[0];
const initialRate = new Intl.NumberFormat(language, {
  style: "currency", currency: "EUR", currencyDisplay: "narrowSymbol", maximumFractionDigits: 0,
}).format(initial.rates.EUR);
const appointmentHours = [[9, 12], [14, 17]];
const slots = appointmentHours.map(([start, end]) => (
  Array.from({ length: (end - start) * 2 }, (_, index) => {
    const hour = String(start + Math.floor(index / 2)).padStart(2, "0");
    return `${hour}:${index % 2 === 0 ? "00" : "30"}`;
  })
));
const email = "vincenzopaolo.diperna@outlook.com";
---

<BaseLayout
  title={t("Digital Studio | Services and hourly rates | Vincenzo Di Perna", "Digital Studio | Servizi e tariffe orarie | Vincenzo Di Perna")}
  description={t(
    "Explore hourly rates for website design, posters, research paper support, one-to-one tutoring and automation.",
    "Consulta le tariffe orarie per siti vetrina, locandine, supporto alla scrittura scientifica, tutoraggio e automazioni."
  )}
  sideBarActiveItemID="services"
>
  <digital-studio class="studio" data-language={language} data-email={email}>
    <header class="studio-header">
      <h1>Digital Studio<span aria-hidden="true">.</span></h1>
      <p>{t(
        "Websites, design, research support and one-to-one sessions. Pick an activity to see its hourly rate.",
        "Siti web, grafica, supporto alla ricerca e sessioni individuali. Scegli un’attività per vedere la tariffa oraria."
      )}</p>
    </header>

    <section class="studio-rates" aria-labelledby="rates">
      <h2 id="rates" class="studio-heading">{t("Services and rates", "Servizi e tariffe")}</h2>
      <div class="studio-grid">
        <fieldset class="service-list">
          <legend class="sr-only">{t("Choose a service", "Scegli un servizio")}</legend>
          {services.map((service) => (
            <label class="service-option">
              <input
                type="radio"
                name="studio-service"
                value={service.id}
                checked={service === initial}
                data-name={service.name}
                data-description={service.description}
                data-eur={service.rates.EUR}
                data-usd={service.rates.USD}
              />
              <svg class="service-icon" aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round"><path d={service.icon} /></svg>
              <span>{service.name}</span>
            </label>
          ))}
        </fieldset>

        <div class="rate-panel">
          <div class="rate-top">
            <span>{t("Hourly rate", "Tariffa oraria")}</span>
            <fieldset class="currency-switch">
              <legend class="sr-only">{t("Currency", "Valuta")}</legend>
              {currencies.map((currency) => (
                <label>
                  <input class="sr-only" type="radio" name="studio-currency" value={currency} checked={currency === "EUR"} />
                  <span>{currency}</span>
                </label>
              ))}
            </fieldset>
          </div>

          <output class="rate-output">
            <strong data-rate>{initialRate}</strong>
            <span>{t("/ hour", "/ ora")}</span>
          </output>

          <div class="rate-detail">
            <h3 data-service-name>{initial.name}</h3>
            <p data-service-description>{initial.description}</p>
          </div>

          <p class="rate-note">{t(
            "Indicative rate. We’ll agree on the hours and total before work starts.",
            "Tariffa indicativa. Concordiamo le ore e il costo totale prima di iniziare."
          )}</p>
        </div>
      </div>
    </section>

    <section class="studio-booking" aria-labelledby="appointment">
      <div>
        <h2 id="appointment" class="studio-heading">{t("Let’s talk about your project", "Parliamo del tuo progetto")}</h2>
        <p>{t("A 30-minute introductory call", "Un primo colloquio di 30 minuti")}</p>
      </div>
      <button class="btn btn-primary studio-cta" type="button" data-open-booking aria-haspopup="dialog" hidden>
        {t("Book an appointment", "Prenota un appuntamento")}
        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v14H4zM4 10h16M8 4v4m8-4v4" /></svg>
      </button>
      <noscript><a href={inLanguage("/contact/", locale)}>{t("Request an appointment by email", "Richiedi un appuntamento via email")}</a></noscript>
    </section>

    <dialog class="booking-dialog" aria-labelledby="booking-title" aria-describedby="booking-note">
      <div class="booking-header">
        <h3 id="booking-title">{t("Request an appointment", "Richiedi un appuntamento")}</h3>
        <form method="dialog">
          <button class="btn btn-ghost btn-circle btn-sm" aria-label={t("Close", "Chiudi")}>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
          </button>
        </form>
      </div>
      <p class="booking-summary" data-booking-summary>{initial.name}</p>
      <p id="booking-note">{t(
        "Choose a preferred time for a 30-minute call. Send your request by email and I’ll confirm the time.",
        "Scegli un orario per il colloquio di 30 minuti. Invia la richiesta via email e ti confermerò l’orario."
      )}</p>

      <form class="booking-form" data-booking-form data-subject={t("Digital Studio · Appointment request", "Digital Studio · Richiesta appuntamento")}>
        <div class="booking-fields">
          <label>
            {t("Preferred date", "Data preferita")}
            <input class="input input-bordered" type="date" name="date" required />
          </label>
          <label>
            {t("Start time", "Ora di inizio")}
            <select class="select select-bordered" name="time" aria-describedby="booking-timezone" required>
              <option value="">{t("Select a time", "Scegli un orario")}</option>
              {slots.map((times, index) => (
                <optgroup label={index === 0 ? t("Morning", "Mattina") : t("Afternoon", "Pomeriggio")}>
                  {times.map((time) => <option value={time}>{time}</option>)}
                </optgroup>
              ))}
            </select>
          </label>
        </div>
        <p id="booking-timezone">{t(
          "Italy time (Europe/Rome) · 09:00–12:00 and 14:00–17:00",
          "Ora italiana (Europe/Rome) · 09:00–12:00 e 14:00–17:00"
        )}</p>
        <button class="btn btn-primary" type="submit">{t("Open email", "Apri email")}</button>
      </form>
    </dialog>
  </digital-studio>
</BaseLayout>

<script>
  const romeClock = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Rome",
    year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
  });

  class DigitalStudio extends HTMLElement {
    #initialized = false;

    connectedCallback() {
      if (this.#initialized) return;
      this.#initialized = true;
      const rate = this.querySelector<HTMLElement>("[data-rate]")!;
      const name = this.querySelector<HTMLElement>("[data-service-name]")!;
      const description = this.querySelector<HTMLElement>("[data-service-description]")!;
      const summary = this.querySelector<HTMLElement>("[data-booking-summary]")!;
      const dialog = this.querySelector("dialog")!;
      const form = this.querySelector<HTMLFormElement>("[data-booking-form]")!;
      const date = form.querySelector<HTMLInputElement>('[name="date"]')!;
      const time = form.querySelector<HTMLSelectElement>('[name="time"]')!;
      const italian = this.dataset.language === "it-IT";

      const updateRate = () => {
        const service = this.querySelector<HTMLInputElement>('[name="studio-service"]:checked')!;
        const currency = this.querySelector<HTMLInputElement>('[name="studio-currency"]:checked')!.value;
        const amount = Number(service.dataset[currency.toLowerCase()]);

        name.textContent = summary.textContent = service.dataset.name!;
        description.textContent = service.dataset.description!;
        rate.textContent = new Intl.NumberFormat(this.dataset.language, {
          style: "currency", currency, currencyDisplay: "narrowSymbol", maximumFractionDigits: 0,
        }).format(amount);
      };

      const updateTimes = () => {
        const parts = Object.fromEntries(romeClock.formatToParts(new Date()).map(({ type, value }) => [type, value]));
        const today = `${parts.year}-${parts.month}-${parts.day}`;
        const now = `${parts.hour}:${parts.minute}`;

        date.min = today;
        for (const option of time.options) {
          option.disabled = Boolean(option.value && date.value === today && option.value <= now);
        }
        if (time.selectedOptions[0]?.disabled) time.value = "";
      };

      for (const input of this.querySelectorAll('input[type="radio"]')) {
        input.addEventListener("change", updateRate);
      }
      updateRate();

      const bookingButton = this.querySelector<HTMLButtonElement>("[data-open-booking]")!;
      bookingButton.hidden = false;
      bookingButton.addEventListener("click", () => {
        updateTimes();
        dialog.showModal();
      });
      date.addEventListener("change", updateTimes);
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        updateTimes();
        if (!form.reportValidity()) return;

        const body = italian
          ? `Ciao Vincenzo,\n\nvorrei richiedere un colloquio di 30 minuti per questa attività: ${name.textContent}.\nData e ora preferite: ${date.value}, ${time.value} (Europe/Rome).\n\nIl mio progetto:\n\nGrazie!`
          : `Hi Vincenzo,\n\nI’d like to request a 30-minute call about this service: ${name.textContent}.\nPreferred date and time: ${date.value}, ${time.value} (Europe/Rome).\n\nAbout my project:\n\nThank you!`;
        location.href = `mailto:${this.dataset.email}?subject=${encodeURIComponent(form.dataset.subject!)}&body=${encodeURIComponent(body)}`;
      });
    }
  }

  customElements.define("digital-studio", DigitalStudio);
</script>

<style>
  .studio {
    display: block;
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
    color: #202431;
  }

  .studio-header { margin-bottom: clamp(1.75rem, 5vw, 3rem); }
  .studio-header h1 {
    font-size: clamp(2.65rem, 6.8vw, 4.45rem);
    line-height: 1.03;
    font-weight: 750;
    letter-spacing: -0.065em;
  }
  .studio-header h1 span { color: #a85d08; }
  .studio-header p { margin-top: 0.85rem; max-width: 39rem; font-size: 1.12rem; color: #4e5360; }

  .studio-heading { font-size: 1.3rem; font-weight: 750; letter-spacing: -0.025em; }
  .studio-rates > h2 { margin-bottom: 0.85rem; }
  .studio-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 1rem;
  }
  .service-list {
    display: grid;
    align-content: stretch;
    gap: 0.45rem;
    min-width: 0;
  }
  .service-option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid #dddfe4;
    border-radius: 0.8rem;
    background: #fff;
    cursor: pointer;
    font-weight: 650;
    line-height: 1.25;
  }
  .service-option:hover { border-color: #aa7b36; }
  .service-option:has(input:checked) {
    background: #fff4d7;
    border-color: #a97528;
  }
  .service-option input { flex: none; accent-color: #805000; width: 1rem; height: 1rem; }
  .service-icon { flex: none; color: #615849; }

  .rate-panel {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
    padding: clamp(1.05rem, 3.5vw, 1.7rem);
    border-radius: 1rem;
    color: #f7f7fa;
    background: radial-gradient(ellipse at 100% 0%, #33394d, #222635 68%);
    box-shadow: 0 0.55rem 1.5rem #1c22331f;
  }
  .rate-top { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .rate-top > span { font-size: 0.91rem; font-weight: 650; }
  .currency-switch {
    display: inline-flex;
    gap: 0.15rem;
    padding: 0.18rem;
    border: 1px solid #676d7e;
    border-radius: 0.55rem;
    background: #202433;
  }
  .currency-switch span {
    display: block;
    min-width: 2.7rem;
    padding: 0.36rem 0.46rem;
    border-radius: 0.35rem;
    text-align: center;
    font-size: 0.78rem;
    font-weight: 750;
    cursor: pointer;
  }
  .currency-switch input:checked + span { background: #ffda79; color: #26202b; }
  .currency-switch input:focus-visible + span { outline: 2px solid #fff; outline-offset: 2px; }
  .rate-output { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.1rem 0.5rem; }
  .rate-output strong {
    font-size: clamp(2.75rem, 6.5vw, 4rem);
    line-height: 1.02;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.065em;
    color: #ffda79;
  }
  .rate-output span, .rate-detail p, .rate-note { color: #d4d8e4; }
  .rate-detail { border-top: 1px solid #ffffff38; padding-top: 0.8rem; }
  .rate-detail h3 { font-size: 1rem; font-weight: 700; }
  .rate-detail p { margin-top: 0.25rem; font-size: 0.95rem; }
  .rate-note { margin-top: auto; font-size: 0.82rem; }

  .studio-booking {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem 1rem;
    flex-wrap: wrap;
    margin-top: 1.4rem;
    padding: 1rem 1.1rem;
    border: 1px solid #dedfe5;
    border-radius: 0.8rem;
    background: #fff;
  }
  .studio-booking p { margin-top: 0.2rem; color: #4e5360; }
  .studio-cta { gap: 0.55rem; }
  .studio-cta[hidden] { display: none; }

  .booking-dialog {
    width: min(33rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: clamp(1rem, 4vw, 1.65rem);
    border: 1px solid #dedfe5;
    border-radius: 1rem;
    background: #fff;
    color: #202431;
    box-shadow: 0 1.5rem 4rem #171a3454;
  }
  .booking-dialog::backdrop { background: #1a1d30a6; }
  .booking-header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .booking-header h3 { font-size: 1.35rem; font-weight: 750; }
  .booking-summary { margin: 0.35rem 0 0.5rem; font-weight: 700; }
  .booking-form { margin-top: 1.1rem; }
  .booking-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  .booking-fields label { display: grid; gap: 0.35rem; min-width: 0; font-weight: 650; }
  .booking-fields :is(input, select) { width: 100%; min-width: 0; font-weight: 400; }
  #booking-timezone { margin: 0.6rem 0 1rem; font-size: 0.85rem; color: #4e5360; text-align: start; }

  @media (max-width: 42rem) {
    .studio-grid { grid-template-columns: minmax(0, 1fr); }
    .service-option { min-height: 2.95rem; }
  }

  @media (max-width: 27rem) {
    .booking-fields { grid-template-columns: minmax(0, 1fr); }
    .studio-cta { width: 100%; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .service-option, .currency-switch span { transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease; }
  }
</style>
