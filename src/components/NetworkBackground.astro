<div class="network-background" aria-hidden="true">
    <canvas id="network-background-canvas" data-animated="true"></canvas>
</div>

<style>
    .network-background {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
        opacity: 0.44;
    }

    @media (max-width: 767px) {
        .network-background {
            opacity: 0.34;
        }
    }

    #network-background-canvas {
        width: 100%;
        height: 100vh;
        height: 100lvh;
        display: block;
    }
</style>

<script is:inline>
    function startNetworkBackground() {
        const canvas = document.getElementById("network-background-canvas");
        if (!canvas || window.__networkBackgroundCanvas === canvas) return;
        window.__networkBackgroundCleanup?.();
        window.__networkBackgroundCanvas = canvas;

        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        let width = 0;
        let height = 0;
        let pixelRatio = 0;
        let mouseX = null;
        let mouseY = null;
        let scrollY = window.scrollY || 0;
        let animationFrameId = null;

        const nodes = [];
        const pulses = [];
        const edges = [];
        let lastGraphUpdate = -Infinity;

        function random(min, max) {
            return Math.random() * (max - min) + min;
        }

        function resizeCanvas() {
            const nextWidth = canvas.clientWidth;
            const nextHeight = canvas.clientHeight;
            const dpr = Math.min(window.devicePixelRatio || 1, nextWidth < 768 ? 1.25 : 1.5);
            if (nextWidth === width && nextHeight === height && dpr === pixelRatio) return false;

            width = nextWidth;
            height = nextHeight;
            pixelRatio = dpr;
            canvas.width = Math.round(width * dpr);
            canvas.height = Math.round(height * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            return true;
        }

        function createNodes() {
            nodes.length = 0;
            lastGraphUpdate = -Infinity;

            const nodeCount = width < 768 ? 52 : 170;

            for (let i = 0; i < nodeCount; i++) {
                nodes.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    vx: random(-0.22, 0.22),
                    vy: random(-0.22, 0.22),
                    r: random(1.2, 2.4),
                });
            }
        }

        function distance(a, b) {
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            return Math.sqrt(dx * dx + dy * dy);
        }

        function edgeKey(i, j) {
            return Math.min(i, j) * nodes.length + Math.max(i, j);
        }

        function updateNodes() {
            const scrollWave = scrollY * 0.003;

            for (const node of nodes) {
                node.x +=
                    node.vx + Math.sin(scrollWave + node.y * 0.012) * 0.035;
                node.y +=
                    node.vy + Math.cos(scrollWave + node.x * 0.012) * 0.035;

                if (node.x < -20) node.x = width + 20;
                if (node.x > width + 20) node.x = -20;
                if (node.y < -20) node.y = height + 20;
                if (node.y > height + 20) node.y = -20;

                if (mouseX !== null && mouseY !== null) {
                    const dx = node.x - mouseX;
                    const dy = node.y - mouseY;
                    const d = Math.sqrt(dx * dx + dy * dy);

                    if (d < 150 && d > 0) {
                        const force = (150 - d) / 150;
                        node.x += (dx / d) * force * 0.45;
                        node.y += (dy / d) * force * 0.45;
                    }
                }
            }
        }

        function drawEdge(i, j, forced) {
            const a = nodes[i];
            const b = nodes[j];
            const maxDistance = width < 768 ? 145 : 210;
            const opacity = forced ? 0.22 :
                Math.max(0.055, (1 - distance(a, b) / maxDistance) * 0.44);

            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = "rgba(15, 23, 42, " + opacity + ")";
            ctx.lineWidth = forced ? 1.05 : 0.9;
            ctx.stroke();
        }

        function updateGraph() {
            edges.length = 0;
            const seen = new Set();
            const addEdge = (i, j, forced) => {
                const key = edgeKey(i, j);
                if (seen.has(key)) return;
                seen.add(key);
                edges.push({ i, j, forced });
            };
            const nearestLinks = width < 768 ? 3 : 6;
            const proximityDistance = width < 768 ? 125 : 190;

            // Backbone: ogni nodo viene collegato al nodo precedente più vicino.
            // Questo evita componenti completamente isolate.
            for (let i = 1; i < nodes.length; i++) {
                let nearestIndex = 0;
                let nearestDistance = Infinity;

                for (let j = 0; j < i; j++) {
                    const d = distance(nodes[i], nodes[j]);

                    if (d < nearestDistance) {
                        nearestDistance = d;
                        nearestIndex = j;
                    }
                }

                addEdge(i, nearestIndex, true);
            }

            // Link extra verso i vicini.
            for (let i = 0; i < nodes.length; i++) {
                const neighbours = [];

                for (let j = 0; j < nodes.length; j++) {
                    if (i === j) continue;

                    neighbours.push({
                        index: j,
                        distance: distance(nodes[i], nodes[j]),
                    });
                }

                neighbours.sort((a, b) => a.distance - b.distance);

                for (let k = 0; k < nearestLinks; k++) {
                    const neighbour = neighbours[k];
                    if (neighbour)
                        addEdge(i, neighbour.index, false);
                }
            }

            // Link di prossimità per aumentare la densità.
            for (let i = 0; i < nodes.length; i++) {
                for (let j = i + 1; j < nodes.length; j++) {
                    const d = distance(nodes[i], nodes[j]);

                    if (d < proximityDistance) {
                        addEdge(i, j, false);
                    }
                }
            }
        }

        function drawNodes() {
            ctx.beginPath();
            for (const node of nodes) {
                ctx.moveTo(node.x + node.r, node.y);
                ctx.arc(node.x, node.y, node.r, 0, Math.PI * 2);
            }
            ctx.fillStyle = "rgba(15, 23, 42, 0.72)";
            ctx.fill();
        }

        function drawPulses() {
            for (let i = pulses.length - 1; i >= 0; i--) {
                const pulse = pulses[i];

                pulse.radius += 2.4;
                pulse.alpha *= 0.955;

                if (pulse.alpha < 0.01) {
                    pulses.splice(i, 1);
                    continue;
                }

                ctx.beginPath();
                ctx.arc(pulse.x, pulse.y, pulse.radius, 0, Math.PI * 2);
                ctx.strokeStyle = "rgba(250, 204, 21, " + pulse.alpha + ")";
                ctx.lineWidth = 1.8;
                ctx.stroke();

                for (const node of nodes) {
                    const dx = node.x - pulse.x;
                    const dy = node.y - pulse.y;
                    const d = Math.sqrt(dx * dx + dy * dy);

                    if (
                        d < pulse.radius + 38 &&
                        d > pulse.radius - 38 &&
                        d > 0
                    ) {
                        const force = 0.3 * pulse.alpha;
                        node.x += (dx / d) * force;
                        node.y += (dy / d) * force;
                    }
                }
            }
        }

        function draw(now) {
            animationFrameId = null;
            ctx.clearRect(0, 0, width, height);
            const moving = !document.hidden;
            if (moving) updateNodes();

            // Nodes move a few pixels between graph updates. Redraw their positions
            // every frame and recompute the nearest neighbours less frequently.
            if (now - lastGraphUpdate >= 140) {
                updateGraph();
                lastGraphUpdate = now;
            }
            for (const { i, j, forced } of edges) drawEdge(i, j, forced);
            drawNodes();
            if (moving) {
                drawPulses();
                animationFrameId = window.requestAnimationFrame(draw);
            }
        }

        function refresh() {
            if (animationFrameId !== null) window.cancelAnimationFrame(animationFrameId);
            lastGraphUpdate = -Infinity;
            draw(performance.now());
        }

        const handleResize = () => {
            if (!resizeCanvas()) return;
            createNodes();
            refresh();
        };

        const handleMouseMove = (event) => {
            mouseX = event.clientX;
            mouseY = event.clientY;
        };

        const handleMouseLeave = () => {
            mouseX = null;
            mouseY = null;
        };

        const handleScroll = () => {
            scrollY = window.scrollY || 0;
        };

        const handleTouchStart = (event) => {
            const touch = event.touches[0];

            if (!touch || document.hidden) {
                return;
            }

            pulses.push({
                x: touch.clientX,
                y: touch.clientY,
                radius: 8,
                alpha: 0.65,
            });
        };

        const listeners = new AbortController();
        const { signal } = listeners;
        window.addEventListener("resize", handleResize, { signal });
        document.addEventListener("visibilitychange", refresh, { signal });
        window.addEventListener("pageshow", refresh, { signal });
        window.addEventListener("mousemove", handleMouseMove, { passive: true, signal });
        window.addEventListener("mouseleave", handleMouseLeave, { signal });
        window.addEventListener("scroll", handleScroll, { passive: true, signal });
        window.addEventListener("touchstart", handleTouchStart, { passive: true, signal });

        window.__networkBackgroundCleanup = () => {
            if (animationFrameId !== null) window.cancelAnimationFrame(animationFrameId);
            listeners.abort();
            window.__networkBackgroundCanvas = null;
        };

        resizeCanvas();
        createNodes();
        refresh();
    }

    startNetworkBackground();

    if (!window.__networkBackgroundPageLoadRegistered) {
        window.__networkBackgroundPageLoadRegistered = true;
        document.addEventListener("astro:page-load", startNetworkBackground);
        document.addEventListener("astro:before-swap", () => window.__networkBackgroundCleanup?.());
    }
</script>
