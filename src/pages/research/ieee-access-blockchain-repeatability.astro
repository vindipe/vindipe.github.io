---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ieeeAccessPaper as paper } from "../../data/ieeeAccessPaper";
import { getLocale, inLanguage, translator } from "../../i18n/locale";

const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);
const description = t(...paper.description);
const datasetPage = localPath("/research/blockchain-repeatability-dataset/");

const experiment = [
  { label: t("Blockchain systems", "Blockchain"), value: "Algorand, Diem, Ethereum Clique, Quorum IBFT, Solana" },
  { label: t("Network topologies", "Topologie di rete"), value: t("Fat-tree, full mesh, hypercube, scale-free, torus", "Fat-tree, maglia completa, ipercubo, rete a invarianza di scala, toro") },
  { label: t("Workloads", "Carichi di lavoro"), value: "DDoS, FIFA, GAFAM, Gaming, PayPal, VISA" },
  { label: t("Validator sets", "Gruppi di validatori"), value: t("10 or 40 validators", "10 o 40 validatori") },
];

// Positive-commit and observed executions from the paper's outcome accounting table.
const outcomes = [
  { blockchain: "Algorand", small: [399, 399], large: [388, 388] },
  { blockchain: "Diem", small: [383, 383], large: [439, 440] },
  { blockchain: "Ethereum Clique", small: [402, 403], large: [390, 390] },
  { blockchain: "Quorum IBFT", small: [150, 401], large: [176, 428] },
  { blockchain: "Solana", small: [328, 458], large: [70, 390] },
];

const number = new Intl.NumberFormat(locale);
const showOutcomes = (commits: number, observed: number) =>
  `${number.format(commits)}/${number.format(observed)}`;

const figures = [
  {
    file: "throughput",
    title: t("Throughput", "Throughput"),
    summary: t("Differences in committed transactions per second (TPS).", "Differenze nelle transazioni confermate al secondo (TPS)."),
  },
  {
    file: "latency",
    title: t("Confirmation latency", "Latenza di conferma"),
    summary: t("Differences in time to confirm transactions, in seconds.", "Differenze nei tempi di conferma delle transazioni, in secondi."),
  },
  {
    file: "energy",
    title: t("Energy", "Consumi energetici"),
    summary: t("Differences in processor-package energy, in kWh.", "Differenze nell’energia assorbita dai processori, in kWh."),
  },
];

const citation = `${paper.authors.join(", ")}. (${paper.year}). ${paper.title}. ${paper.journal}.`;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: paper.title,
  description,
  url: new URL(localPath(paper.path), Astro.site ?? Astro.url).href,
  sameAs: paper.doiUrl,
  identifier: paper.doi,
  datePublished: String(paper.year),
  inLanguage: "en",
  author: paper.authors.map((name) => ({ "@type": "Person", name })),
  isPartOf: { "@type": "Periodical", name: paper.journal },
};
---

<BaseLayout
  title={`${paper.title} | Vincenzo Di Perna`}
  {description}
  image={paper.cover}
  ogType="article"
  sideBarActiveItemID="research"
  sideBarPageLabel={t("IEEE Access · Repeatability", "IEEE Access · Ripetibilità")}
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

  <article class="space-y-8">
    <header>
      <a class="btn btn-sm btn-outline mb-5" href={localPath("/research/")}>
        {t("← Back to Research", "← Torna alla ricerca")}
      </a>
      <div class="network-protected card bg-base-100 border-t-4 border-primary shadow-md">
        <div class="card-body p-6 sm:p-9 gap-4">
          <span class="badge badge-secondary">{paper.journal} · {paper.year}</span>
          <h1 class="text-3xl sm:text-4xl font-bold leading-tight" lang="en">{paper.title}</h1>
          <p class="text-lg leading-relaxed">{description}</p>
          <dl class="grid gap-3 rounded-xl border border-base-300 bg-base-200/50 p-4 sm:grid-cols-[minmax(0,1fr)_auto]">
            <div>
              <dt class="text-sm font-semibold">{t("Authors", "Autori")}</dt>
              <dd class="text-sm mt-1">{paper.authors.join(", ")}</dd>
            </div>
            <div>
              <dt class="text-sm font-semibold">DOI</dt>
              <dd class="text-sm mt-1 break-words">{paper.doi}</dd>
            </div>
          </dl>
          <div class="flex flex-wrap gap-3 mt-2">
            <a class="btn btn-primary" href={paper.doiUrl} target="_blank" rel="noopener noreferrer">
              {t("Read on IEEE Xplore", "Leggi su IEEE Xplore")}
            </a>
            <a class="btn btn-outline" href={datasetPage}>{t("Explore the dataset", "Esplora il dataset")}</a>
          </div>
        </div>
      </div>
    </header>

    <section class="network-protected card bg-base-100 shadow-md" aria-labelledby="experimental-design">
      <div class="card-body p-6 sm:p-8 gap-4">
        <h2 id="experimental-design" class="text-2xl font-bold">{t("Experimental design", "Come abbiamo condotto gli esperimenti")}</h2>
        <p class="leading-relaxed">
          {t("We used", "Abbiamo usato")}
          <a class="link font-medium" href={localPath("/research/lilith-benchmarking-framework/")}>Lilith</a>
          {t("to run blockchain clients under emulated geographic network conditions. We reset the system state between runs and measured committed throughput, transaction confirmation latency and processor-package energy.", "per eseguire i client blockchain emulando reti distribuite geograficamente. Abbiamo ripristinato lo stato a ogni esecuzione e misurato le transazioni confermate al secondo, la latenza di conferma e l’energia assorbita dai processori.")}
        </p>
        <dl class="grid grid-cols-1 sm:grid-cols-3 gap-px rounded-xl overflow-hidden bg-base-300 border border-base-300">
          <div class="bg-base-200 p-4 flex flex-col-reverse">
            <dt class="text-sm">{t("benchmark runs", "esecuzioni analizzate")}</dt>
            <dd class="text-2xl font-bold tabular-nums">{t("4,080", "4.080")}</dd>
          </div>
          <div class="bg-base-200 p-4 flex flex-col-reverse">
            <dt class="text-sm">{t("configurations", "configurazioni")}</dt>
            <dd class="text-2xl font-bold tabular-nums">300</dd>
          </div>
          <div class="bg-base-200 p-4 flex flex-col-reverse">
            <dt class="text-sm">{t("runs per configuration", "esecuzioni per configurazione")}</dt>
            <dd class="text-2xl font-bold tabular-nums">9–26</dd>
          </div>
        </dl>
        <dl class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
          {experiment.map(({ label, value }) => (
            <div>
              <dt class="font-semibold">{label}</dt>
              <dd class="text-sm leading-relaxed opacity-80">{value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="network-protected card bg-base-100 shadow-md" aria-labelledby="findings">
      <div class="card-body p-5 sm:p-8 gap-5">
        <h2 id="findings" class="text-2xl font-bold">{t("Results across five blockchains", "Risultati sulle cinque blockchain")}</h2>
        <p class="leading-relaxed">
          {t("The table shows how often each blockchain confirmed at least one transaction, grouping all workloads and topologies by validator-set size. This puts the performance plots in context, since those plots show measurements from runs that provided service.", "La tabella mostra quante esecuzioni hanno portato alla conferma di almeno una transazione, raggruppando carichi e topologie per numero di validatori. Il confronto aiuta a leggere i grafici delle prestazioni, che riportano misure ottenute nelle esecuzioni con conferme.")}
        </p>
        <div class="rounded-xl border border-base-300">
          <table class="w-full table-fixed text-xs sm:text-sm" aria-describedby="commit-outcomes-note">
            <caption class="bg-base-200 rounded-t-xl px-3 py-3 text-left font-semibold sm:px-4">
              {t("Runs with at least one commit / observed runs", "Esecuzioni con almeno una conferma / esecuzioni osservate")}
            </caption>
            <thead class="bg-base-200/60">
              <tr class="border-b border-base-300">
                <th scope="col" class="w-[34%] px-2 py-2 text-left sm:w-[38%] sm:px-4">Blockchain</th>
                <th scope="col" class="px-1 py-2 text-right sm:px-4">10 <span class="block sm:inline">{t("validators", "validatori")}</span></th>
                <th scope="col" class="px-1 py-2 text-right sm:px-4">40 <span class="block sm:inline">{t("validators", "validatori")}</span></th>
                <th scope="col" class="px-2 py-2 text-right sm:px-4">{t("Total", "Totale")}</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-base-300 tabular-nums">
              {outcomes.map(({ blockchain, small, large }) => (
                <tr>
                  <th scope="row" class="px-2 py-3 text-left font-medium sm:px-4">{blockchain}</th>
                  <td class="whitespace-nowrap px-1 py-3 text-right sm:px-4">{showOutcomes(small[0], small[1])}</td>
                  <td class="whitespace-nowrap px-1 py-3 text-right sm:px-4">{showOutcomes(large[0], large[1])}</td>
                  <td class="whitespace-nowrap px-1 py-3 text-right font-semibold sm:px-4">{showOutcomes(small[0] + large[0], small[1] + large[1])}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="text-sm leading-relaxed opacity-80" id="commit-outcomes-note">
          {t("Data from the paper’s execution-outcomes table. Across all five blockchains, 3,125 runs committed at least one transaction, 953 recorded submissions with zero commits and 2 recorded no submissions.", "Dati dalla tabella del paper sugli esiti delle esecuzioni. In totale, 3.125 esecuzioni hanno registrato almeno una conferma, 953 hanno registrato invii e zero conferme e 2 non hanno registrato invii.")}
        </p>
      </div>
    </section>

    <section class="network-protected card bg-base-100 shadow-md" aria-labelledby="paper-figures">
      <div class="card-body p-5 sm:p-8 gap-5">
        <h2 id="paper-figures" class="text-2xl font-bold">{t("Variability across repeated runs", "Variabilità tra le ripetizioni")}</h2>
        <p class="leading-relaxed">
          {t("The three figures from the paper cover all five blockchains and six workloads, with separate panels for 10 and 40 validators. Each dot represents one eligible run. Its height shows the signed difference from the mean of its own configuration, in absolute units on the left and as a percentage on the right.", "Le tre figure del paper coprono tutte e cinque le blockchain e tutti e sei i carichi, con pannelli distinti per 10 e 40 validatori. Ogni punto rappresenta un’esecuzione con una misura valida. La sua altezza indica lo scostamento con segno dalla media della stessa configurazione, in unità assolute a sinistra e in percentuale a destra.")}
        </p>
        <div class="grid gap-4 sm:grid-cols-3">
          {figures.map(({ file, title, summary }) => (
            <figure class="relative !grid grid-cols-[38%_minmax(0,1fr)] !items-stretch !justify-start rounded-xl border border-base-300 bg-base-200/60 transition-colors hover:bg-base-200 sm:grid-cols-1 sm:grid-rows-[auto_1fr]">
              <div class="grid place-items-center bg-white p-2">
                <img
                  class="w-full h-auto"
                  src={`/research/ieee-access/${file}-deviations.webp`}
                  width="640"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  alt=""
                />
              </div>
              <figcaption class="flex flex-col gap-1 p-3 sm:p-4">
                <h3 class="font-bold">{title}</h3>
                <p class="text-sm leading-relaxed">{summary}</p>
                <a class="link link-hover mt-auto pt-2 text-sm font-semibold after:absolute after:inset-0 after:rounded-xl" href={`/research/ieee-access/${file}-deviations.pdf`} target="_blank" rel="noopener noreferrer" aria-label={`${title} · ${t("Open full figure (PDF)", "Apri la figura ingrandita (PDF)")}`}>
                  {t("Open figure (PDF)", "Apri figura (PDF)")}
                </a>
              </figcaption>
            </figure>
          ))}
        </div>
        <dl class="grid gap-4 sm:grid-cols-2">
          <div class="rounded-lg border-l-4 border-primary bg-base-200/60 p-4">
            <dt class="font-bold">{t("Throughput and latency", "Throughput e latenza")}</dt>
            <dd class="mt-1 text-sm leading-relaxed">{t("Blockchain, workload and their interaction had the largest effects. The largest upward deviations observed across the study were about 497% for throughput and 573% for latency, relative to the respective configuration means.", "Blockchain, carico e la loro interazione hanno avuto gli effetti maggiori. Nell’insieme degli esperimenti, gli scostamenti più alti sono stati circa il 497% per il throughput e il 573% per la latenza, rispetto alle medie delle rispettive configurazioni.")}</dd>
          </div>
          <div class="rounded-lg border-l-4 border-primary bg-base-200/60 p-4">
            <dt class="font-bold">{t("Energy", "Consumi energetici")}</dt>
            <dd class="mt-1 text-sm leading-relaxed">{t("Energy use varied less across repetitions and was most strongly associated with workload in the fitted model.", "I consumi variavano meno tra le ripetizioni. Nel modello statistico, il carico di lavoro era il fattore più legato al consumo.")}</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="network-protected card bg-base-100 shadow-md" aria-labelledby="analysis">
      <div class="card-body p-6 sm:p-8 gap-4">
        <h2 id="analysis" class="text-2xl font-bold">{t("From repeated runs to predictable performance", "Dalle ripetizioni alla prevedibilità delle prestazioni")}</h2>
        <p class="leading-relaxed">
          {t("Our", "Il nostro")}
          <a class="link font-medium" href={localPath("/research/acm-dlt-network-topologies-blockchain-performance/")}>
            {t("ACM DLT study", "studio su ACM DLT")}
          </a>
          {t("introduced the P0–P3 predictability ladder. Here we revisited the shared benchmark data one run at a time. We measured how often each configuration committed transactions, then estimated dispersion and extreme deviations for each performance metric.", "ha introdotto la scala di prevedibilità P0–P3. In questo articolo abbiamo rianalizzato gli stessi dati a livello di singola esecuzione. Abbiamo misurato quanto spesso ogni configurazione portava a conferme, poi abbiamo stimato la dispersione e gli scostamenti estremi per ogni misura di prestazione.")}
        </p>
        <p class="leading-relaxed">
          {t("We used logistic regression for the chance of observing a commit and robust analysis of variance for the measured performance. We resampled the data to estimate uncertainty and repeated the analysis with nine runs per configuration to check the effect of uneven sample sizes. The largest deviations describe individual observations in this testbed.", "Abbiamo usato la regressione logistica per stimare la probabilità di osservare una conferma e l’analisi della varianza robusta per studiare le prestazioni misurate. Abbiamo ricampionato i dati per stimare l’incertezza e ripetuto l’analisi con nove esecuzioni per configurazione per capire quanto contassero le differenze di numerosità. Gli scostamenti massimi descrivono singole osservazioni in questo ambiente sperimentale.")}
        </p>
      </div>
    </section>

    <section class="network-protected card bg-base-100 shadow-md" aria-labelledby="citation">
      <div class="card-body p-6 sm:p-8 gap-4">
        <h2 id="citation" class="text-2xl font-bold">{t("Citation and materials", "Citazione e materiali")}</h2>
        <p class="leading-relaxed" lang="en">{citation} <a class="link break-words" href={paper.doiUrl}>{paper.doi}</a></p>
        <div class="flex flex-wrap gap-3">
          <a class="btn btn-sm btn-outline" href="https://doi.org/10.5281/zenodo.17681717" target="_blank" rel="noopener noreferrer">
            {t("Dataset on Zenodo", "Dataset su Zenodo")}
          </a>
          <a class="btn btn-sm btn-outline" href="https://github.com/vindipe/blockchain-repeatability-benchmarking" target="_blank" rel="noopener noreferrer">
            {t("Data and analysis on GitHub", "Dati e analisi su GitHub")}
          </a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
