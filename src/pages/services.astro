---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
const language = locale === "it" ? "it-IT" : "en-US";

const services = [
  {
    name: t("Consulting and digital strategy planning", "Consulenza e pianificazione strategia digitale"),
    detail: t("Review your tools, explore options and define practical next steps.", "Analisi degli strumenti, valutazione delle opzioni e definizione dei prossimi passi."),
  },
  {
    name: t("Implement digital infrastructure", "Implementare infrastruttura digitale"),
    detail: t("Configure and deploy an application with Docker and an automated publishing workflow.", "Configurazione e pubblicazione di un’applicazione con Docker e una procedura di rilascio automatizzata."),
    example: {
      name: t("This website", "Questo sito"),
      detail: t(
        "I built this bilingual site with Astro and automated deployments to GitHub Pages.",
        "Ho realizzato questo sito bilingue con Astro e ne ho automatizzato la pubblicazione su GitHub Pages."
      ),
      href: inLanguage("/", locale),
    },
  },
  {
    name: t("Digital support", "Supporto digitale"),
    detail: t("Get remote help with a specific issue on your computer.", "Assistenza da remoto per un problema al PC."),
  },
  {
    name: t("Mentoring and tutoring", "Mentoring e tutoring"),
    detail: t("Individual sessions on programming, digital tools or your own project.", "Sessioni individuali su programmazione, strumenti digitali o un tuo progetto."),
  },
];

const appointmentHours = [[9, 12], [14, 17]];
const slots = appointmentHours.map(([start, end]) => (
  Array.from({ length: (end - start) * 2 }, (_, index) => {
    const hour = String(start + Math.floor(index / 2)).padStart(2, "0");
    return `${hour}:${index % 2 === 0 ? "00" : "30"}`;
  })
));
const email = "vincenzopaolo.diperna@outlook.com";
---

<BaseLayout
  title={t("Digital Services | Vincenzo Di Perna", "Servizi digitali | Vincenzo Di Perna")}
  description={t(
    "Digital strategy, infrastructure implementation, remote support, mentoring and tutoring from Vincenzo Di Perna.",
    "Consulenza per la strategia digitale, implementazione di infrastrutture, supporto da remoto, mentoring e tutoring con Vincenzo Di Perna."
  )}
  sideBarActiveItemID="services"
>
  <digital-services class="studio" data-language={language} data-email={email}>
    <header class="mb-7">
      <h1 class="text-4xl font-bold mb-4">{t("Digital Services", "Servizi digitali")}</h1>
      <p class="text-lg leading-relaxed opacity-90">{t(
        "Alongside my research, I work in software development, digital infrastructure and training. I can help you get a digital project off the ground, put an application online, solve a technical problem or build your skills in a one-to-one session.",
        "Oltre alla ricerca, mi occupo di sviluppo software, infrastrutture digitali e formazione. Metto questa esperienza a disposizione di chi vuole avviare un progetto digitale, mettere online un’applicazione, risolvere un problema tecnico o imparare a usare nuovi strumenti con un affiancamento individuale."
      )}</p>
    </header>

    <ul class="mb-9 divide-y divide-base-300">
      {services.map(({ name, detail, example }) => (
        <li class="py-5 first:pt-0 last:pb-0">
          <h2 class="text-xl font-bold mb-1">{name}</h2>
          <p>{detail}</p>
          {example && (
            <p class="mt-2 text-sm">
              <a class="link" href={example.href}>{example.name}</a>
              {". "}{example.detail}
            </p>
          )}
        </li>
      ))}
    </ul>

    <section class="card bg-base-100 shadow-md mb-6" aria-labelledby="appointment">
      <div class="card-body studio-booking">
        <div>
          <h2 id="appointment" class="text-3xl font-bold mb-2">{t("A free 30-minute call", "Un primo colloquio gratuito")}</h2>
          <p>{t(
            "Tell me what you want to do or where you’re stuck. We can see how I can help.",
            "Raccontami cosa vuoi fare o dove ti sei bloccato. Possiamo sentirci per 30 minuti e capire come posso aiutarti."
          )}</p>
        </div>
        <button class="btn btn-primary studio-cta" type="button" data-open-booking aria-haspopup="dialog" hidden>
          {t("Request an appointment", "Richiedi un appuntamento")}
        </button>
        <noscript><a href={inLanguage("/contact/", locale)}>{t("Request an appointment by email", "Richiedi un appuntamento via email")}</a></noscript>
      </div>
    </section>

    <dialog class="booking-dialog" aria-labelledby="booking-title" aria-describedby="booking-note">
      <div class="booking-header">
        <h3 id="booking-title">{t("Request a free appointment", "Richiedi un appuntamento gratuito")}</h3>
        <form method="dialog">
          <button class="btn btn-ghost btn-circle btn-sm" aria-label={t("Close", "Chiudi")}>×</button>
        </form>
      </div>
      <p id="booking-note">{t(
        "Choose a time for your free 30-minute call. I’ll confirm the appointment by email.",
        "Scegli un orario per il colloquio gratuito di 30 minuti. Ti confermerò l’appuntamento via email."
      )}</p>

      <form class="booking-form" data-booking-form data-subject={t("Digital services · Appointment request", "Servizi digitali · Richiesta appuntamento")}>
        <label class="booking-date">
          {t("Preferred date", "Data preferita")}
          <input class="input input-bordered" type="date" name="date" required />
        </label>
        <fieldset class="booking-times" aria-describedby="booking-timezone" disabled>
          <legend>{t("Start time", "Ora di inizio")}</legend>
          <p id="booking-timezone">{t(
            "Italy time (Europe/Rome) · 09:00–12:00 and 14:00–17:00",
            "Ora italiana (Europe/Rome) · 09:00–12:00 e 14:00–17:00"
          )}</p>
          {slots.map((times, index) => (
            <div class="slot-group" role="group" aria-label={index === 0 ? t("Morning", "Mattina") : t("Afternoon", "Pomeriggio")}>
              {times.map((time) => (
                <label class="slot">
                  <input type="radio" class="sr-only" name="time" value={time} required />
                  <span>{time}</span>
                </label>
              ))}
            </div>
          ))}
        </fieldset>
        <p class="studio-note" data-no-times hidden>{t(
          "Choose another date to see more times.",
          "Scegli un’altra data per vedere altri orari."
        )}</p>
        <button class="btn btn-primary" type="submit">{t("Open email", "Apri email")}</button>
      </form>
    </dialog>
  </digital-services>
</BaseLayout>

<script>
  const romeClock = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Rome",
    year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
  });

  class DigitalServices extends HTMLElement {
    #initialized = false;

    connectedCallback() {
      if (this.#initialized) return;
      this.#initialized = true;

      const dialog = this.querySelector("dialog")!;
      const form = dialog.querySelector<HTMLFormElement>("[data-booking-form]")!;
      const date = form.querySelector<HTMLInputElement>('[name="date"]')!;
      const timeGroup = form.querySelector<HTMLFieldSetElement>(".booking-times")!;
      const times = [...timeGroup.querySelectorAll<HTMLInputElement>('[name="time"]')];
      const noTimes = form.querySelector<HTMLElement>("[data-no-times]")!;
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const italian = this.dataset.language === "it-IT";

      const updateTimes = () => {
        const parts = Object.fromEntries(romeClock.formatToParts(new Date()).map(({ type, value }) => [type, value]));
        const today = `${parts.year}-${parts.month}-${parts.day}`;
        const now = `${parts.hour}:${parts.minute}`;

        date.min = today;
        timeGroup.disabled = !date.value || !date.validity.valid;
        for (const time of times) {
          time.disabled = date.value === today && time.value <= now;
          if (time.disabled) time.checked = false;
        }
        const noneAvailable = times.every((time) => time.disabled);
        noTimes.hidden = !noneAvailable;
        submitButton.disabled = timeGroup.disabled || noneAvailable;
      };

      const bookingButton = this.querySelector<HTMLButtonElement>("[data-open-booking]")!;
      bookingButton.hidden = false;
      bookingButton.addEventListener("click", () => {
        updateTimes();
        dialog.showModal();
      });

      date.addEventListener("change", updateTimes);
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        updateTimes();
        const time = times.find((slot) => slot.checked && !slot.disabled);
        if (!form.reportValidity() || !time) return;

        const body = italian
          ? `Ciao Vincenzo,\n\nvorrei richiedere un colloquio gratuito di 30 minuti.\nData e ora preferite: ${date.value}, ${time.value} (Europe/Rome).\n\nDi cosa ho bisogno:\n\nGrazie!`
          : `Hi Vincenzo,\n\nI’d like to request a free 30-minute call.\nPreferred date and time: ${date.value}, ${time.value} (Europe/Rome).\n\nWhat I need help with:\n\nThank you!`;
        location.href = `mailto:${this.dataset.email}?subject=${encodeURIComponent(form.dataset.subject!)}&body=${encodeURIComponent(body)}`;
      });
    }
  }

  customElements.define("digital-services", DigitalServices);
</script>

<style>
  .studio {
    display: block;
    width: min(52rem, 100%);
    margin-inline: auto;
  }

  .studio-note { margin-top: 0.75rem; font-size: 0.88rem; opacity: 0.8; }

  .slot span {
    display: block;
    padding: 0.4rem 0.55rem;
    border-radius: 0.3rem;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 650;
    cursor: pointer;
  }
  .slot input:checked + span {
    background: oklch(var(--p));
    color: oklch(var(--pc));
  }
  .slot input:focus-visible + span {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .studio-booking {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem 1rem;
    flex-wrap: wrap;
  }
  .studio-cta[hidden] { display: none; }

  .booking-dialog {
    width: min(33rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: clamp(1rem, 4vw, 1.65rem);
    border: 1px solid #e2ded4;
    border-radius: 0.5rem;
    background: #fff;
    color: #282723;
  }

  .booking-dialog::backdrop { background: #22221ea3; }
  .booking-header { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .booking-header h3 { font-size: 1.3rem; line-height: 1.25; font-weight: 700; }
  .booking-header button { font-size: 1.3rem; }
  #booking-note { margin-top: 0.35rem; }
  .booking-form { display: grid; gap: 0.75rem; margin-top: 0.9rem; }
  .booking-date { display: grid; gap: 0.3rem; font-weight: 650; }
  .booking-date input { width: min(100%, 13rem); min-width: 0; font-weight: 400; }
  .booking-times { min-width: 0; }
  .booking-times legend { font-weight: 650; }
  #booking-timezone { margin: 0.2rem 0 0.55rem; font-size: 0.85rem; color: #5c5850; }
  .slot-group { display: grid; grid-template-columns: repeat(auto-fit, minmax(3.65rem, 1fr)); gap: 0.35rem; }
  .slot-group + .slot-group { margin-top: 0.35rem; }
  .slot span { padding-inline: 0.25rem; border: 1px solid #d5d0c3; }
  .slot input:disabled + span, .booking-times:disabled .slot span { opacity: 0.45; cursor: default; }
  .booking-form > button { justify-self: start; }
</style>
