---
import { translator } from "../../../i18n/locale";

const t = translator(Astro.url.pathname);
const { labelledBy } = Astro.props;
---

<section id="smart-contract-sandbox" aria-labelledby={labelledBy} class="card">
  <div class="card-body p-3 sm:p-4">
    <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1fr] gap-4">
      <div class="rounded-xl bg-base-200 border border-base-300 p-4">
        <label class="form-control mb-3">
          <span class="label-text font-semibold">{t("From", "Mittente")}</span>
          <select class="select select-bordered" data-contract-from>
            <option>Alice</option>
            <option>Bob</option>
            <option>Carol</option>
          </select>
        </label>

        <label class="form-control mb-3">
          <span class="label-text font-semibold">{t("To", "Destinatario")}</span>
          <select class="select select-bordered" data-contract-to>
            <option>Bob</option>
            <option>Alice</option>
            <option>Carol</option>
          </select>
        </label>

        <label class="form-control mb-4">
          <span class="label-text font-semibold">{t("Amount", "Importo")}</span>
          <input
            class="input input-bordered"
            type="number"
            min="1"
            value="10"
            data-contract-amount
          />
        </label>

        <div class="flex flex-wrap gap-2">
          <button class="btn btn-primary" data-contract-action="transfer">
            {t("Execute transfer", "Esegui il trasferimento")}
          </button>

          <button class="btn btn-outline" data-contract-action="reset">
            {t("Reset state", "Ripristina lo stato")}
          </button>
        </div>
      </div>

      <div class="grid gap-3">
        <div class="rounded-xl bg-base-200 border border-base-300 p-4">
          <p class="font-semibold mb-2">{t("Contract state", "Stato del contratto")}</p>
          <div data-contract-balances class="grid gap-2"></div>
        </div>

        <div class="rounded-xl bg-base-200 border border-base-300 p-4">
          <p class="font-semibold mb-1">{t("Execution result", "Risultato")}</p>
          <p data-contract-status class="text-sm opacity-80">
            {t("Submit a transfer to execute the contract rules.", "Prova un trasferimento per vedere come reagisce il contratto.")}
          </p>
        </div>

        <div class="rounded-xl bg-base-200 border border-base-300 p-4">
          <p class="font-semibold mb-1">{t("Rule", "Regola")}</p>
          <p class="text-sm opacity-80">
            {t("A transfer succeeds only if sender and receiver are different, the amount is positive, and the sender has enough balance.", "Il trasferimento riesce se mittente e destinatario sono diversi, l’importo è positivo e il mittente ha un saldo sufficiente.")}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const isItalian = () => document.documentElement.lang === "it";
  const translate = (english, italian) => isItalian() ? italian : english;

  function initSmartContractSandbox() {
    const root = document.querySelector("#smart-contract-sandbox");

    if (!root || root.dataset.initialized === "true") {
    return;
    }

    root.dataset.initialized = "true";

    const fromInput = root.querySelector("[data-contract-from]");
    const toInput = root.querySelector("[data-contract-to]");
    const amountInput = root.querySelector("[data-contract-amount]");
    const balancesOutput = root.querySelector("[data-contract-balances]");
    const status = root.querySelector("[data-contract-status]");

    const initialBalances = {
      Alice: 100,
      Bob: 40,
      Carol: 20,
    };

    let balances = { ...initialBalances };

    function render() {
      balancesOutput.innerHTML = Object.entries(balances)
        .map(
          ([account, balance]) => `
            <div>
              <div class="flex justify-between text-sm mb-1">
                <span>${account}</span>
                <span class="font-mono">${balance} TOK</span>
              </div>
              <progress class="progress progress-primary w-full" value="${balance}" max="120"></progress>
            </div>
          `,
        )
        .join("");
    }

    function transfer() {
      const from = fromInput.value;
      const to = toInput.value;
      const amount = Number(amountInput.value);

      if (from === to) {
        status.textContent = translate("Transaction rejected: sender and receiver cannot be the same account.", "Transazione rifiutata: mittente e destinatario devono essere diversi.");
        return;
      }

      if (!Number.isFinite(amount) || amount <= 0) {
        status.textContent = translate("Transaction rejected: amount must be positive.", "Transazione rifiutata: l’importo deve essere positivo.");
        return;
      }

      if (balances[from] < amount) {
        status.textContent = (isItalian() ? `Transazione rifiutata: ${from} ha soltanto ${balances[from]} TOK.` : `Transaction rejected: ${from} has only ${balances[from]} TOK.`);
        return;
      }

      balances[from] -= amount;
      balances[to] += amount;

      status.textContent = (isItalian() ? `Transazione eseguita: ${from} ha inviato ${amount} TOK a ${to}. Lo stato del contratto è cambiato in modo deterministico.` : `Transaction executed: ${from} sent ${amount} TOK to ${to}. The contract state changed deterministically.`);
      render();
    }

    function reset() {
      balances = { ...initialBalances };
      status.textContent = translate("Contract state restored.", "Stato del contratto ripristinato.");
      render();
    }

    root.querySelector('[data-contract-action="transfer"]').addEventListener("click", transfer);
    root.querySelector('[data-contract-action="reset"]').addEventListener("click", reset);

    render();
  }

  initSmartContractSandbox();

  if (!window.__smartContractSandboxPageLoadRegistered) {
    window.__smartContractSandboxPageLoadRegistered = true;
    document.addEventListener("astro:page-load", initSmartContractSandbox);
  }
</script>