---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getRecentWorks } from "../data/recentWorks";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const latestWorks = getRecentWorks(Astro.url.pathname)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 3);
---

<BaseLayout
  title={t("Vincenzo Di Perna | Research Software Engineer", "Vincenzo Di Perna | Ingegnere del software")}
  description={t("Vincenzo Di Perna, research software engineer working on distributed systems, blockchain benchmarking and digital resource expiry.", "Vincenzo Di Perna, ingegnere del software. Ricerca sui sistemi distribuiti, benchmark delle blockchain e scadenza delle risorse digitali.")}
  sideBarActiveItemID="home"
  ogImage="/og/vincenzo-di-perna-og.png"
>
  <section class="pb-12 mt-5">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-8 items-center">
      <div class="order-2 lg:order-1">
        <h1 class="text-5xl font-bold leading-tight">
          <span class="block">Vincenzo Di Perna</span>
          <span class="block text-3xl py-3">
            {t("Research Software Engineer", "Ingegnere del software")}<br />
            {t("Distributed Systems, Blockchain & DLT", "Sistemi distribuiti, blockchain e DLT")}
          </span>
        </h1>

        <div class="space-y-3 py-2 text-lg leading-relaxed">
          <p>{t("I hold a PhD in blockchain. I worked on tools for testing blockchain protocols, on experimental repeatability and predictability, and on digital asset data analysis.", "Ho un dottorato (PhD) in blockchain. Ho lavorato allo sviluppo di strumenti per testare i protocolli blockchain, alla ripetibilità degli esperimenti e alla prevedibilità dei risultati, e all'analisi di dati riguardanti gli asset digitali.")}</p>
          <p>{t("I’m interested in how blockchains can reshape existing infrastructure and how they behave outside ideal conditions. In my doctoral research, I compared networks, workloads and protocols and measured their effects on performance, energy consumption and economic efficiency.", "Mi interessa capire come le blockchain possano cambiare le infrastrutture esistenti e come si comportino fuori dalle condizioni ideali. Per questo confronto reti, carichi di lavoro e protocolli diversi e ne misuro gli effetti sulle prestazioni, sui consumi e sull’efficienza economica.")}</p>
          <p>{t("I expect to join the University of Neuchâtel on 1 February 2027 as a postdoctoral researcher and scientific coordinator of CIRCULA. Funded by the Swiss National Science Foundation (SNSF), the project will study how digital resources expire and can be renewed in blockchain systems.", "Dal 1° febbraio 2027 è previsto il mio ingresso all’Università di Neuchâtel come ricercatore post-dottorale e coordinatore scientifico di CIRCULA. Il progetto, finanziato dal Fondo nazionale svizzero (FNS), studierà come gestire la scadenza e il rinnovo delle risorse digitali nelle blockchain.")}</p>
        </div>

        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href={localPath("/projects")}>
            {t("View Projects and Tools", "Esplora progetti e strumenti")}
          </a>

          <a class="btn btn-outline" href={localPath("/cv")}> {t("View CV", "Consulta il CV")} </a>

          <a
            class="btn btn-outline"
            href="https://github.com/vindipe"
            target="_blank"
            rel="noopener noreferrer"
          >
            GitHub
          </a>

          <a
            class="btn btn-outline"
            href="https://www.linkedin.com/in/vincenzo-di-perna/"
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>

          <a
            class="btn btn-outline"
            href="https://orcid.org/0009-0003-8834-9900"
            target="_blank"
            rel="me noopener noreferrer"
          >
            ORCID
          </a>
        </div>
      </div>

      <div class="order-1 lg:order-2 flex flex-col items-center gap-5">
        <div class="avatar">
          <div
            class="w-56 rounded-2xl ring ring-primary ring-offset-base-100 ring-offset-4 shadow-xl"
          >
            <img src="/profile-small.webp" width="280" height="320" fetchpriority="high" decoding="async" alt={t("Portrait of Vincenzo Di Perna", "Ritratto di Vincenzo Di Perna")} />
          </div>
        </div>
        <a href={localPath("/research/circula")} aria-label={t("Explore CIRCULA", "Scopri CIRCULA")}><img src="/research/circula/wordmark.webp" alt="CIRCULA" width="450" height="155" class="w-40 h-auto rounded-lg" loading="lazy" /></a>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <h2 id="recent-uploads" class="text-3xl font-bold mb-5">{t("Recent uploads", "Ultimi aggiornamenti")}</h2>

    <div class="space-y-4">
      {
        latestWorks.map((work) => (
          <HorizontalCard
            title={work.title}
            img={work.img}
            imgAlt={work.imgAlt}
            desc={work.desc}
            url={work.url}
            badge={work.badge}
            target={work.target ?? "_blank"}
          />
        ))
      }

    </div>
  </section>

  <section class="mb-12">
    <h2 id="my-work" class="text-3xl w-full font-bold mb-5">{t("More about me", "Il mio lavoro")}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Projects and Tools", "Progetti e strumenti")}</h3>

          <p>
            {t("Explore selected research artifacts, datasets, software tools, and experimental pipelines related to blockchain systems and digital assets.", "Software, dati e materiali per esplorare le blockchain e gli asset digitali e riprodurre gli esperimenti.")}
          </p>

          <div class="card-actions justify-end mt-4">
            <a class="btn btn-sm btn-outline" href={localPath("/projects")}>
              {t("Browse software and datasets", "Esplora software e dataset")}
            </a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Research & publications", "Ricerca e pubblicazioni")}</h3>

          <p>
            {t("Read more about my publications, research themes, artifacts, and work on blockchain benchmarking, performance, energy, and economic efficiency.", "Studi sulle prestazioni delle blockchain, sui consumi energetici e sull’efficienza economica, con i dati e gli strumenti per approfondirli.")}
          </p>

          <div class="card-actions justify-end mt-4">
            <a class="btn btn-sm btn-outline" href={localPath("/research")}>
              {t("View research", "Esplora la ricerca")}
            </a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">Blockchain 101</h3>

          <p>
            {t("Interactive blockchain fundamentals, visual explainers, and small playable labs on cryptography, peer-to-peer networks, consensus, smart contracts, tokens, and distributed infrastructures.", "Come funziona una blockchain? Prova i laboratori su crittografia, reti peer-to-peer, consenso, smart contract e token.")}
          </p>

          <div class="card-actions justify-end mt-4">
            <a class="btn btn-sm btn-outline" href={localPath("/tutorials")}>
              {t("Start learning", "Vai ai laboratori")}
            </a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">CV</h3>

          <p>
            {t("See a compact overview of my background, experience, publications, technical skills, and research engineering profile.", "Formazione, esperienze di ricerca, pubblicazioni e competenze tecniche.")}
          </p>

          <div class="card-actions justify-end mt-4">
            <a class="btn btn-sm btn-outline" href={localPath("/cv")}> {t("Explore my experience", "Scopri la mia esperienza")} </a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 id="research-in-practice" class="card-title" data-section-anchor>{t("How I study blockchain systems", "Come studio i sistemi blockchain")}</h3>
          <p>{t(
            "I compare protocols under controlled conditions to see how node placement, network delays and transaction workloads affect performance. I publish the tools and data so others can inspect the setup and repeat the measurements.",
            "Confronto i protocolli in condizioni controllate per capire come la posizione dei nodi, i ritardi di rete e i carichi di transazioni incidono sulle prestazioni. Pubblico strumenti e dati per permettere a chi legge di esaminare la configurazione e ripetere le misure."
          )}</p>
          <div class="card-actions justify-end mt-4">
            <a class="btn btn-sm btn-outline" href={localPath("/research/lilith-benchmarking-framework")}>{t("Lilith benchmarking framework", "Framework di benchmark Lilith")}</a>
            <a class="btn btn-sm btn-outline" href={localPath("/research/blockchain-repeatability-dataset")}>{t("Repeatability dataset", "Dataset sulla ripetibilità")}</a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("How I work with clients", "Come lavoro con i clienti")}</h3>
          <p>{t(
            "I start by asking what you want to achieve and what tools you already use. From there I can help you choose a solution, build and launch a website or application, fix a technical problem, or learn a tool through hands-on practice.",
            "Parto da quello che vuoi ottenere e dagli strumenti che usi già. Posso aiutarti a scegliere una soluzione, mettere online un sito o un’applicazione, risolvere un problema tecnico o imparare a usare uno strumento facendo pratica."
          )}</p>
          <div class="card-actions justify-end mt-4">
            <a class="btn btn-sm btn-outline" href={localPath("/services")}>{t("Freelance Services", "Servizi freelance")}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-12 text-center">
    <h2 id="connect" class="text-3xl font-bold mb-4">{t("Let's connect", "Parliamone")}</h2>

    <a class="btn btn-primary" href={localPath("/contact")}> {t("Get in touch", "Scrivimi")} </a>
  </section>
</BaseLayout>
