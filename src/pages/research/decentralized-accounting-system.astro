---
import { getLocale, inLanguage, translator } from "../../i18n/locale";
import BaseLayout from "../../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const conceptFigures = [
  {
    title: t("Solid architecture", "Architettura Solid"),
    src: "/research/theses/master/solid-architecture.png",
    desc: t("The thesis uses Solid Pods as a privacy-preserving storage layer for business documents, invoices, orders, and data access control.", "Il prototipo conserva documenti, fatture e ordini in Solid Pods, dove l’accesso è riservato agli utenti autorizzati."),
  },
  {
    title: t("ERP domain", "Ambito ERP"),
    src: "/research/theses/master/erp-domain.png",
    desc: t("The work starts from the accounting and ERP context, where administrative processes can become costly, manual, and error-prone.", "Nei sistemi contabili e gestionali, molte operazioni amministrative si fanno a mano. Questo aumenta i costi e il rischio di errori."),
  },
  {
    title: t("Invoice formats", "Formati delle fatture"),
    src: "/research/theses/master/invoice-formats.png",
    desc: t("The thesis discusses the evolution from paper invoices to PDF/XML and electronic billing formats.", "La tesi ripercorre il passaggio dalle fatture cartacee a PDF, XML e formati per la fatturazione elettronica."),
  },
  {
    title: t("eBill flow", "Flusso eBill"),
    src: "/research/theses/master/ebill-flow.png",
    desc: t("The eBill process is used as a reference for designing a more digital and traceable billing workflow.", "Il prototipo prende spunto da eBill per digitalizzare la fatturazione e rendere tracciabili i passaggi."),
  },
];

const architectureFigures = [
  {
    title: t("Restaurant flow", "Flussi del ristorante"),
    src: "/research/theses/master/restaurant-flow.png",
    desc: t("A model of incoming and outgoing restaurant flows, including customers, business actors, services, bills, and payments.", "Schema dei rapporti tra clienti, fornitori e ristorante, con il percorso di ordini, conti e pagamenti."),
  },
  {
    title: t("Restaurant timeline", "Percorso del cliente"),
    src: "/research/theses/master/restaurant-timeline.png",
    desc: t("A timeline of the customer experience, from entry to menu selection, ordering, service, billing, and payment.", "Dall’ingresso nel ristorante alla scelta del menu, all’ordine, al servizio, al conto e al pagamento."),
  },
  {
    title: t("Infrastructure components", "Componenti dell’infrastruttura"),
    src: "/research/theses/master/infrastructure-components.png",
    desc: t("The implementation combines web technologies, Solid, Ethereum, MetaMask, QR codes, eBill concepts, and deployment tooling.", "Il prototipo usa Solid, Ethereum, MetaMask e codici QR. La fatturazione si ispira a eBill."),
  },
  {
    title: t("Infrastructure layers", "Livelli dell’infrastruttura"),
    src: "/research/theses/master/infrastructure-layers.png",
    desc: t("The proposed architecture separates interface, API, Solid, Pods, menu, eBill, and hash/blockchain layers.", "Lo schema distingue l’interfaccia e le API dalla gestione di menu, dati nei Pod, fatture e verifica su blockchain."),
  },
  {
    title: t("Wallet-blockchain structure", "Integrazione tra wallet e blockchain"),
    src: "/research/theses/master/wallet-blockchain-structure.png",
    desc: t("The payment side connects Ethereum, MetaMask, Web3.js, and blockchain transactions.", "Il cliente autorizza il pagamento con MetaMask. Il prototipo interagisce con Ethereum tramite Web3.js."),
  },
  {
    title: t("Solid graph interactions", "Interazioni nel grafo Solid"),
    src: "/research/theses/master/solid-graph-interactions.png",
    desc: t("The Solid-based data flow models how orders, bills, storage, and access-controlled resources interact.", "Il flusso dati di Solid descrive le relazioni tra ordini, conti, archiviazione e risorse ad accesso controllato."),
  },
];

const prototypeScreens = [
  {
    title: t("Menu and cart", "Menu e carrello"),
    src: "/research/theses/master/menu-cart-switches.png",
    desc: t("The user interface separates menu browsing from cart management.", "L’interfaccia distingue la consultazione del menu dalla gestione del carrello."),
  },
  {
    title: t("Product list", "Elenco dei prodotti"),
    src: "/research/theses/master/product-list.png",
    desc: t("Products are loaded from the restaurant data layer and exposed through the web interface.", "L’interfaccia mostra i prodotti presenti nel sistema del ristorante."),
  },
  {
    title: t("Product description", "Descrizione del prodotto"),
    src: "/research/theses/master/product-description.png",
    desc: t("The prototype includes product details and purchase actions.", "Il prototipo mostra i dettagli dei prodotti e permette di acquistarli."),
  },
  {
    title: t("Quantity update", "Modifica delle quantità"),
    src: "/research/theses/master/quantity-update.png",
    desc: t("The cart supports quantity changes before order confirmation.", "Prima di confermare l’ordine si possono modificare le quantità nel carrello."),
  },
  {
    title: t("Get bill phase", "Richiesta del conto"),
    src: "/research/theses/master/get-bill.png",
    desc: t("The customer can move from ordering to bill generation.", "Dopo aver ordinato, il cliente può generare il conto."),
  },
  {
    title: t("Billing phase", "Fase di fatturazione"),
    src: "/research/theses/master/billing-phase.png",
    desc: t("The billing workflow produces a payable state before final settlement.", "Il sistema prepara il conto e lo rende disponibile per il pagamento."),
  },
  {
    title: t("MetaMask experience", "Pagamento con MetaMask"),
    src: "/research/theses/master/metamask-experience.png",
    desc: t("MetaMask is used to confirm the blockchain payment transaction.", "MetaMask conferma la transazione blockchain."),
  },
  {
    title: t("Table QR code", "Codice QR del tavolo"),
    src: "/research/theses/master/table-qr-code.png",
    desc: t("QR codes are used to identify the table and connect the physical restaurant space with the digital workflow.", "Il cliente inquadra il codice QR sul tavolo per aprire il menu relativo a quel tavolo."),
  },
  {
    title: t("Digital bill QR code", "Codice QR del conto digitale"),
    src: "/research/theses/master/digital-bill-qr-code.png",
    desc: t("The invoice flow includes QR-based identification for payment and document retrieval.", "Il codice QR permette di identificare il conto per pagarlo e recuperare il documento."),
  },
  {
    title: t("Pre-invoice", "Prefattura"),
    src: "/research/theses/master/pre-invoice.png",
    desc: t("The prototype generates a pre-invoice containing order, payment, and blockchain-related information.", "Il prototipo genera una prefattura con i dati dell’ordine, del pagamento e della transazione blockchain."),
  },
];

const contributions = [
  t("Designed a decentralized document-management and accounting prototype for a restaurant/SME scenario.", "Prototipo di contabilità e gestione dei documenti per le piccole e medie imprese, sperimentato su un caso nella ristorazione."),
  t("Combined Ethereum blockchain transactions with Solid Pods to separate verifiable payment events from private business documents.", "Integrazione delle transazioni Ethereum con Solid Pods per separare gli eventi di pagamento verificabili dai documenti aziendali riservati."),
  t("Used QR codes to connect physical restaurant tables, bills, and digital interaction flows.", "Collegamento tra tavoli, conti e interazioni digitali tramite codici QR."),
  t("Integrated MetaMask and Web3-style payment interaction into the customer-facing workflow.", "Integrazione di MetaMask e dei pagamenti Web3 nel percorso del cliente."),
  t("Explored how accounting, ERP, eBill, and blockchain concepts can be connected in a practical software prototype.", "Esplorazione di come collegare contabilità, sistemi ERP, eBill e blockchain in un prototipo software."),
];
---

<BaseLayout
  title={t("Decentralized Accounting with Blockchain and Solid", "Contabilità decentralizzata con blockchain e Solid Pods | Vincenzo Di Perna")}
  description={t("Master’s thesis on a restaurant accounting and document-management prototype using blockchain, Solid Pods, MetaMask and QR codes.", "Tesi magistrale su un prototipo di contabilità e gestione documentale con blockchain, Solid Pods, MetaMask, codici QR e procedure ispirate a eBill.")}
  sideBarActiveItemID="research"
>
  <section class="mb-8">
    <a href={localPath("/research")} class="btn btn-sm btn-outline mb-6">
      {t("← Back to Research", "← Torna alla ricerca")}
    </a>

    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <div class="flex flex-wrap gap-2 items-center mb-3">
          <h1 class="text-4xl font-bold">
            {t("Decentralized Accounting System", "Sistema di contabilità decentralizzata")}
          </h1>
          <span class="badge badge-secondary">{t("Master's thesis", "Tesi magistrale")}</span>
          <span class="badge badge-outline">{t("University of Pisa", "Università di Pisa")}</span>
        </div>

        <p class="text-lg leading-relaxed opacity-90">
          {t("This thesis explored the design and implementation of a decentralized accounting and document-management system for a restaurant use case. The prototype combines blockchain-based transactions, Solid Pods for privacy-preserving document storage, MetaMask payments, QR-code-based interaction, and eBill-inspired billing workflows.", "Nella tesi ho sviluppato un prototipo per gestire ordini, conti e documenti di un ristorante. I documenti sono conservati in Solid Pods, i pagamenti passano da MetaMask e la fatturazione si ispira a eBill. I codici QR collegano tavoli e conti all’interfaccia web.")}
        </p>

        <div class="flex flex-wrap gap-2 mt-5">
          <span class="badge badge-outline">Blockchain</span>
          <span class="badge badge-outline">Ethereum</span>
          <span class="badge badge-outline">Solid Pods</span>
          <span class="badge badge-outline">MetaMask</span>
          <span class="badge badge-outline">{t("QR codes", "Codici QR")}</span>
          <span class="badge badge-outline">eBill</span>
          <span class="badge badge-outline">{t("SME accounting", "Contabilità per PMI")}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">2021/22</p>
          <p class="opacity-80">{t("academic year", "anno accademico")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">SME</p>
          <p class="opacity-80">{t("restaurant use case", "caso d’uso nella ristorazione")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">Solid</p>
          <p class="opacity-80">{t("private document storage", "archiviazione riservata dei documenti")}</p>
        </div>
      </div>

      <div class="network-protected card bg-base-100 shadow-md">
        <div class="card-body">
          <p class="text-4xl font-bold">ETH</p>
          <p class="opacity-80">{t("blockchain transaction layer", "livello transazionale su blockchain")}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="context" class="card-title text-2xl">{t("Context", "Contesto")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The thesis starts from a practical problem: accounting and document management in small and medium-sized businesses can be costly, manual, error-prone, and difficult to verify. In a restaurant scenario, payments, invoices, orders, customer interactions, and supplier operations create a flow of documents that must remain consistent, auditable, and accessible to the right actors.", "In un ristorante, ordini, pagamenti e fatture di clienti e fornitori devono corrispondere e poter essere verificati. Per una piccola impresa, farlo con procedure manuali costa tempo e aumenta il rischio di errori.")}
        </p>

        <p class="leading-relaxed opacity-90 mt-3">
          {t("The proposed solution uses blockchain as a transparent and tamper-aware transaction layer, while Solid Pods provide a separate privacy-preserving storage layer for documents and business data that should not be placed directly on-chain.", "Il prototipo registra su blockchain le informazioni necessarie a verificare le transazioni. I documenti aziendali riservati restano fuori dal registro, in Solid Pods accessibili agli utenti autorizzati.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="conceptual-background" class="card-title text-2xl">{t("Conceptual background", "Concetti di base")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The work connects multiple concepts: ERP systems, electronic billing, Ethereum, smart contracts, Web3, Solid Pods, QR codes, and digital wallets. The key design idea is to avoid treating blockchain as a general-purpose database: verifiable payment events can be anchored on-chain, while sensitive documents remain stored in controlled, access-managed Pods.", "Il lavoro collega sistemi ERP, fatturazione elettronica, Ethereum, smart contract, Web3, Solid Pods, codici QR e wallet. La blockchain registra gli eventi di pagamento verificabili, mentre i documenti sensibili rimangono in Pod con accesso controllato.")}
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-5">
          {
            conceptFigures.map((item) => (
              <div class="card bg-base-200/50 border border-base-300">
                <figure class="px-4 pt-4">
                  <img
                    src={item.src}
                    alt={item.title}
                    class="rounded-lg bg-base-100"
                    loading="lazy"
                  />
                </figure>

                <div class="card-body p-4">
                  <h3 class="font-bold">{item.title}</h3>
                  <p class="text-sm opacity-80">{item.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="architecture" class="card-title text-2xl">{t("Architecture and design", "Architettura e progettazione")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The prototype models the restaurant as an interaction between physical space, customer actions, digital ordering, document storage, and payment confirmation. QR codes connect tables and invoices to the web interface, Solid manages private resources, and the blockchain layer handles payment-related verification.", "Il codice QR collega il tavolo all’interfaccia web. Solid conserva ordini e documenti riservati, mentre la blockchain permette di verificare il pagamento.")}
        </p>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-5">
          {
            architectureFigures.map((item) => (
              <div class="card bg-base-200/50 border border-base-300">
                <figure class="px-4 pt-4">
                  <img
                    src={item.src}
                    alt={item.title}
                    class="rounded-lg bg-base-100"
                    loading="lazy"
                  />
                </figure>

                <div class="card-body p-4">
                  <h3 class="font-bold">{item.title}</h3>
                  <p class="text-sm opacity-80">{item.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="prototype-workflow" class="card-title text-2xl">{t("Prototype workflow", "Come funziona il prototipo")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("The implemented prototype follows the customer journey: access the table-specific interface, browse the menu, manage the cart, generate the bill, confirm payment, and obtain a digital document that can be connected to the accounting workflow.", "Il cliente apre l’interfaccia del tavolo, consulta il menu, gestisce il carrello, genera il conto, conferma il pagamento e ottiene un documento digitale collegabile alla contabilità.")}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-5">
          {
            prototypeScreens.map((item) => (
              <div class="card bg-base-200/50 border border-base-300">
                <figure class="px-4 pt-4">
                  <img
                    src={item.src}
                    alt={item.title}
                    class="rounded-lg bg-base-100"
                    loading="lazy"
                  />
                </figure>

                <div class="card-body p-4">
                  <h3 class="font-bold">{item.title}</h3>
                  <p class="text-sm opacity-80">{item.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="technologies" class="card-title text-2xl">{t("Implementation stack", "Tecnologie utilizzate")}</h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("Backend and web interface", "Backend e interfaccia web")}</h3>
              <p class="text-sm opacity-80">
                {t("Node.js, Express, EJS, JavaScript, static assets, and Heroku-oriented deployment.", "Node.js, Express, EJS, JavaScript, risorse statiche e deployment pensato per Heroku.")}
              </p>
            </div>
          </div>

          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("Decentralized data", "Dati decentralizzati")}</h3>
              <p class="text-sm opacity-80">
                {t("Solid Pods, Inrupt APIs, WebID, access-control policies, containers, and document resources.", "Solid Pods, API Inrupt, WebID, criteri di controllo degli accessi, container e risorse documentali.")}
              </p>
            </div>
          </div>

          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body">
              <h3 class="font-bold">{t("Payment and verification", "Pagamento e verifica")}</h3>
              <p class="text-sm opacity-80">
                {t("Ethereum, MetaMask, Web3 interaction, QR codes, billing states, and transaction references.", "Ethereum, MetaMask, Web3, codici QR, stati di fatturazione e riferimenti alle transazioni.")}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="contribution" class="card-title text-2xl">{t("Main contribution", "Contributo principale")}</h2>

        <ul class="list-disc pl-5 space-y-2 opacity-90">
          {contributions.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="later-research" class="card-title text-2xl">{t("Relationship with later research", "Legame con le ricerche successive")}</h2>

        <p class="leading-relaxed opacity-90">
          {t("This thesis anticipates several directions that later became central in my research profile: blockchain systems, experimental prototypes, digital assets, privacy-aware data management, and the connection between technical infrastructure and real organisational workflows.", "La tesi anticipa temi che sono poi diventati centrali nel mio lavoro: blockchain, prototipi sperimentali, asset digitali, riservatezza dei dati e integrazione delle infrastrutture tecniche nei processi organizzativi.")}
        </p>

        <div class="card-actions mt-4">
          <a
            href={localPath("/research/dynamic-taxonomy-defi-tradfi")}
            class="btn btn-sm btn-outline"
          >
            {t("Related DeFi / digital assets work", "Lavori su DeFi e asset digitali")}
          </a>

          <a
            href={localPath("/research/topology-aware-blockchain-benchmarking")}
            class="btn btn-sm btn-outline"
          >
            {t("Related blockchain systems work", "Lavori sui sistemi blockchain")}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 id="links" class="card-title text-2xl">{t("Links", "Collegamenti")}</h2>

        <div class="flex flex-wrap gap-3 mt-2">
          <a
            href="/theses/master-thesis-decentralized-accounting-system.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm"
          >
            {t("Open master's thesis PDF", "Apri il PDF della tesi magistrale")}
          </a>

<a
  href="https://github.com/vindipe/restaurant-solid-blockchain-prototype"
  target="_blank"
  rel="noopener noreferrer"
  class="btn btn-outline btn-sm"
>
  {t("Open GitHub repository", "Apri il repository GitHub")}
</a>          

          <a
            href={localPath("/research")}
            class="btn btn-outline btn-sm"
          >
            {t("Back to research", "Torna alla ricerca")}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>