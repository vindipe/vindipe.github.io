---
import { getLocale, inLanguage, translator } from "../../i18n/locale";
import BaseLayout from "../../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const doiUrl = "https://dl.acm.org/doi/10.1145/3828757";
const debsUrl = "https://dl.acm.org/doi/10.1145/3701717.3730540";
const lilithUrl = "https://doi.org/10.5281/zenodo.11409100";

const keyPoints = [
  t("Treats the network topology as a first-class experimental variable rather than as a hidden deployment detail.", "Tratta la struttura della rete come una variabile dell’esperimento."),
  t("Connects blockchain throughput, latency, commit behaviour, and workload sensitivity with controlled network structures.", "Misura il numero di transazioni elaborate, i tempi e il tasso di conferma al variare della struttura di rete e del carico di lavoro."),
  t("Builds on the Lilith benchmarking pipeline to support reproducible, topology-aware blockchain evaluation.", "Usa Lilith per ripetere le misure nelle stesse condizioni di rete."),
  t("Strengthens the research line developed during my PhD on performance, energy, repeatability, and realistic experimental conditions.", "Estende il lavoro di dottorato su prestazioni, consumi, ripetibilità e condizioni sperimentali realistiche."),
];

const researchLinks = [
  { label: t("Open ACM DOI", "Leggi l’articolo su ACM (DOI)"), href: doiUrl, primary: true },
  { label: t("Related DEBS paper", "Articolo DEBS correlato"), href: debsUrl },
  { label: t("Lilith artifact DOI", "DOI del framework Lilith"), href: lilithUrl },
  { label: t("Lilith research page", "Scheda di Lilith"), href: "/research/lilith-benchmarking-framework", internal: true },
  { label: t("PhD thesis page", "Tesi di dottorato"), href: "/research/comparing-blockchains", internal: true },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  name: "The Impact of Network Topology on Performance Metrics and Energy Consumption for Blockchains: Towards Repeatable Benchmarking",
  headline: "The Impact of Network Topology on Performance Metrics and Energy Consumption for Blockchains: Towards Repeatable Benchmarking",
  author: [
    { "@type": "Person", name: "Vincenzo P. Di Perna" },
    { "@type": "Person", name: "Valerio Schiavoni" },
    { "@type": "Person", name: "Miguel Matos" },
    { "@type": "Person", name: "Francesco Fabris" },
    { "@type": "Person", name: "Marco Bernardo" },
  ],
  publisher: { "@type": "Organization", name: "Association for Computing Machinery" },
  datePublished: "2026",
  identifier: "https://doi.org/10.1145/3828757",
  url: doiUrl,
  sameAs: [doiUrl, debsUrl, lilithUrl],
  about: [
    t("Blockchain benchmarking", "Benchmarking delle blockchain"),
    t("Network topology", "Topologia di rete"),
    "Distributed ledger technologies",
    "Reproducible experimentation",
    "Performance evaluation",
  ],
};
---

<BaseLayout
  title={t("Blockchain Network Topology and Performance | ACM DLT", "Topologia di rete e prestazioni delle blockchain | ACM DLT")}
  description={t("ACM DLT study on how network topology and workloads affect blockchain performance and energy use in reproducible experiments.", "Articolo di Vincenzo P. Di Perna e coautori su benchmarking delle blockchain, topologie di rete controllate e valutazione riproducibile delle prestazioni.")}
  sideBarActiveItemID="research"
  ogType="article"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="mb-8">
    <a href={localPath("/research")} class="btn btn-sm btn-outline mb-6">{t("← Back to Research", "← Torna alla ricerca")}</a>
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <div class="flex flex-wrap gap-2 items-center mb-3">
          <span class="badge badge-secondary">ACM DLT</span>
          <span class="badge badge-outline">{t("Journal article", "Articolo scientifico")}</span>
          <span class="badge badge-outline">2026</span>
        </div>
        <h1 class="text-4xl font-bold leading-tight">
          {t("The Impact of Network Topology on Performance Metrics and Energy Consumption for Blockchains: Towards Repeatable Benchmarking", "L’effetto della topologia di rete sulle prestazioni e sui consumi delle blockchain")}
        </h1>
        <p class="text-lg leading-relaxed opacity-90 mt-4">
          {t("This ACM DLT journal publication presents the topology-aware blockchain benchmarking line of work behind my PhD research. The article studies how network structure, workload shape, and controlled experimental assumptions influence blockchain performance, moving beyond evaluations that treat the network as an opaque or secondary execution layer.", "L’articolo su ACM DLT riprende gli esperimenti del mio dottorato. Misura come cambiano le prestazioni delle blockchain al variare della topologia e del carico di lavoro, con condizioni di rete esplicite e riproducibili.")}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body p-4">
              <p class="text-sm uppercase tracking-wide opacity-70">{t("Authors", "Autori")}</p>
              <p class="font-bold">
                Vincenzo P. Di Perna, Valerio Schiavoni, Miguel Matos,
                Francesco Fabris, and Marco Bernardo
              </p>
            </div>
          </div>
          <div class="card bg-base-200/50 border border-base-300">
            <div class="card-body p-4">
              <p class="text-sm uppercase tracking-wide opacity-70">{t("Publication", "Pubblicazione")}</p>
              <p class="font-bold">{t("ACM DLT journal article", "Articolo sulla rivista ACM DLT")}</p>
              <p class="text-sm opacity-80">DOI: 10.1145/3828757</p>
            </div>
          </div>
        </div>
        <div class="flex flex-wrap gap-3 mt-7">
          <a href={doiUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">{t("Open ACM article", "Apri l’articolo su ACM")}</a>
          <a href={localPath("/research/topology-aware-blockchain-benchmarking")} class="btn btn-outline">{t("Related DEBS page", "Studio DEBS correlato")}</a>
          <a href={localPath("/research/lilith-benchmarking-framework")} class="btn btn-outline">{t("Related artifact", "Materiali correlati")}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div class="network-protected card bg-base-100 shadow-md"><div class="card-body"><p class="text-4xl font-bold">5</p><p class="opacity-80">{t("blockchain systems", "sistemi blockchain")}</p></div></div>
      <div class="network-protected card bg-base-100 shadow-md"><div class="card-body"><p class="text-4xl font-bold">5</p><p class="opacity-80">{t("network topologies", "topologie di rete")}</p></div></div>
      <div class="network-protected card bg-base-100 shadow-md"><div class="card-body"><p class="text-4xl font-bold">6</p><p class="opacity-80">{t("workload families", "tipi di carico di lavoro")}</p></div></div>
      <div class="network-protected card bg-base-100 shadow-md"><div class="card-body"><p class="text-4xl font-bold">DOI</p><p class="opacity-80">10.1145/3828757</p></div></div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <figure class="px-6 pt-6">
        <img src="/research/dlt26/table4-overall-blockchain-variability-v2.webp" width="1001" height="404" decoding="async" alt={t("Table 4 from the ACM DLT journal article, reporting overall blockchain-level variability for throughput, latency, and energy consumption.", "La tabella 4 dell’articolo ACM DLT mostra la variabilità complessiva di throughput, latenza e consumi energetici per ogni blockchain.")} class="rounded-xl border border-base-300 bg-base-200" loading="lazy" />
      </figure>
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("What the journal article highlights", "Che cosa mostra l’articolo")}</h2>
        <p class="leading-relaxed opacity-90">
          {t("Blockchain performance is not only a property of the protocol or the machines used during an experiment. It also depends on how nodes are connected, how messages propagate, how workloads stress the system, and how stable the experimental environment is. This publication makes that dependency explicit by placing network topology at the centre of the evaluation methodology.", "Come sono collegati i nodi? Quanto tempo impiegano i messaggi a propagarsi? Le risposte contano per le prestazioni quanto il protocollo e l’hardware. Lo studio controlla la struttura della rete, il carico e la stabilità dell’ambiente per distinguere questi effetti.")}
        </p>
        <ul class="list-disc pl-5 space-y-2 opacity-90 mt-4">
          {keyPoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Experimental perspective", "Come sono stati condotti gli esperimenti")}</h2>
        <p class="leading-relaxed opacity-90">
          {t("The research line compares blockchain systems under controlled network topologies such as fat-tree, full mesh, hypercube, scale-free, and torus. These topologies are used as experimental lenses: they make it possible to observe how different communication structures affect throughput, latency, commit ratio, network load, and robustness.", "Abbiamo confrontato le blockchain in cinque topologie: fat-tree, maglia completa, ipercubo, rete a invarianza di scala e toro. Per ciascuna abbiamo misurato throughput, latenza, tasso di conferma, traffico e robustezza.")}
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-5">
          <div class="card bg-base-200/50 border border-base-300"><div class="card-body"><h3 class="font-bold">{t("Performance", "Prestazioni")}</h3><p class="text-sm opacity-80">{t("Throughput, latency, commit behaviour, and workload sensitivity are interpreted in relation to the network conditions under which the system is executed.", "Per interpretare throughput, latenza e tasso di conferma bisogna conoscere le condizioni di rete e il carico a cui era sottoposto il sistema.")}</p></div></div>
          <div class="card bg-base-200/50 border border-base-300"><div class="card-body"><h3 class="font-bold">{t("Reproducibility", "Riproducibilità")}</h3><p class="text-sm opacity-80">{t("The work uses controlled experimental assumptions to reduce hidden variability and make blockchain comparisons easier to repeat and interpret.", "Controllare le condizioni riduce le differenze dovute all’ambiente e permette di ripetere gli esperimenti e confrontarne i risultati.")}</p></div></div>
          <div class="card bg-base-200/50 border border-base-300"><div class="card-body"><h3 class="font-bold">{t("Network awareness", "Ruolo della rete")}</h3><p class="text-sm opacity-80">{t("The article reinforces the idea that blockchain benchmarking should model the network explicitly instead of abstracting it away as neutral infrastructure.", "L’articolo mostra perché il benchmarking delle blockchain dovrebbe modellare esplicitamente la rete come parte del sistema.")}</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-8">
    <div class="network-protected card bg-base-100 shadow-md">
      <figure class="px-6 pt-6">
        <img src="/research/debs/network-load-workloads.webp" width="3600" height="4500" decoding="async" alt={t("Network load during blockchain workload execution across workloads and topologies.", "Traffico di rete durante l’esecuzione dei benchmark, per diversi carichi e topologie.")} class="rounded-xl border border-base-300 bg-base-200" loading="lazy" />
      </figure>
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Connection to my PhD work", "Il legame con il dottorato")}</h2>
        <p class="leading-relaxed opacity-90">
          {t("This publication is directly connected to my doctoral dissertation, which compares blockchain systems across performance, energy, repeatability, predictability, and economic-efficiency dimensions. It represents the journal-facing part of the broader topology-aware benchmarking contribution, alongside the Lilith artifact and the conference publications on performance and energy evaluation.", "L’articolo approfondisce la parte della mia tesi dedicata a prestazioni e consumi delle blockchain. Gli esperimenti si inseriscono nello stesso filone del framework Lilith e degli studi presentati a DEBS e ICBC.")}
        </p>
      </div>
    </div>
  </section>

  <section class="mb-12">
    <div class="network-protected card bg-base-100 shadow-md">
      <div class="card-body">
        <h2 class="card-title text-2xl">{t("Links", "Collegamenti")}</h2>
        <div class="flex flex-wrap gap-3 mt-2">
          {
            researchLinks.map((link) => (
              <a href={localPath(link.href)} target={link.internal ? undefined : "_blank"} rel={link.internal ? undefined : "noopener noreferrer"} class={link.primary ? "btn btn-primary btn-sm" : "btn btn-outline btn-sm"}>
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
