---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";

const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
const language = locale === "it" ? "it-IT" : "en-US";

const services = [
  {
    name: t("Consulting and digital strategy planning", "Consulenza e pianificazione strategia digitale"),
    question: t("What solution do I need, and where should I start?", "Quale soluzione mi serve e da dove comincio?"),
    need: t(
      "You know what you want to achieve but need to decide whether to adopt a ready-made tool, adapt what you already use or build something tailored to your needs.",
      "Hai un obiettivo, ma devi decidere se adottare uno strumento già pronto, adattare quello che usi o sviluppare qualcosa su misura."
    ),
    work: [
      t("Clarify who will use the solution and what they need it to do.", "Chiarire chi userà la soluzione e che cosa deve poter fare."),
      t("Compare options by cost, time and the effort needed to maintain them.", "Confrontare le alternative per costi, tempi e impegno di gestione."),
      t("Decide what you need now and what can wait.", "Decidere quali funzioni servono subito e quali possono aspettare."),
    ],
    outcome: t(
      "A decision you can explain and a plan that tells you what to do first.",
      "Una scelta motivata e un piano che ti dice da dove partire."
    ),
  },
  {
    name: t("Implement digital infrastructure", "Implementare infrastruttura digitale"),
    question: t("How do I build and launch my website or application?", "Come realizzo e metto online il sito o l’applicazione che mi serve?"),
    need: t(
      "You need a website built, an application published or an existing service moved to a new hosting provider. You want someone to handle the technical work through to launch.",
      "Devi realizzare un sito, pubblicare un’applicazione o trasferire un servizio che usi già. Cerchi chi può occuparsi del lavoro tecnico fino alla messa online."
    ),
    work: [
      t("Build the site or configure the application around the features we agree on.", "Sviluppare il sito o configurare l’applicazione in base alle funzioni concordate."),
      t("Set up hosting, the domain and the tools needed to publish changes.", "Configurare l’hosting, il dominio e gli strumenti per pubblicare gli aggiornamenti."),
      t("Move existing content or services where needed and check that core features work online.", "Trasferire contenuti o servizi esistenti, se previsto, e verificare online le funzioni principali."),
    ],
    outcome: t(
      "A live website or application, with instructions for managing and updating it.",
      "Un sito o un’applicazione online, con le istruzioni per la gestione e gli aggiornamenti."
    ),
  },
  {
    name: t("Digital support", "Supporto digitale"),
    question: t("Something has stopped working. Who can help?", "Uno strumento che uso si è bloccato. Come riprendo a lavorare?"),
    need: t(
      "A tool you rely on has stopped working, you can’t access a service or you need help configuring it. Remote help is also available.",
      "Uno strumento che usi per lavorare non funziona più, hai difficoltà ad accedere a un servizio o ti serve una mano a configurarlo. Posso aiutarti anche da remoto."
    ),
    work: [
      t("Work out whether the issue is with the device, the software or the account settings.", "Individuare se il problema dipende dal dispositivo, dal software o dalle impostazioni dell’account."),
      t("Apply a fix or reconfigure the tool so you can use it again.", "Applicare una correzione o riconfigurare lo strumento per renderlo di nuovo utilizzabile."),
      t("Check the result with you and identify any next steps.", "Verificare insieme che tu possa riprendere il lavoro e individuare eventuali passi successivi."),
    ],
    outcome: t(
      "A fix we’ve tested together, or a clear account of what to report if the provider needs to step in.",
      "Una soluzione verificata insieme oppure indicazioni precise su cosa segnalare se deve intervenire il fornitore."
    ),
  },
  {
    name: "Training",
    question: t("How can I get better at using the tools I need?", "Come imparo a usare meglio gli strumenti che mi servono?"),
    need: t(
      "You want to learn a new tool or skill and practise it on a task you actually do at work.",
      "Vuoi imparare a usare uno strumento o acquisire una competenza esercitandoti su un’attività che svolgi davvero."
    ),
    work: [
      t("Define what you want to be able to do on your own.", "Definire che cosa vuoi riuscire a fare in autonomia."),
      t("Work through your task together, whether it involves managing data, using AI or programming.", "Fare pratica sul tuo caso, dalla gestione di dati e documenti all’uso dell’IA o alla programmazione."),
      t("Guide you as you repeat the key steps and check the result.", "Affiancarti mentre ripeti i passaggi chiave e verifichi il risultato."),
    ],
    outcome: t(
      "A way to carry out the task independently and check that you’ve got the result you need.",
      "Un metodo per svolgere l’attività da solo e verificare di aver ottenuto il risultato che ti serve."
    ),
  },
];

const productionSteps = [
  {
    name: t("Checks before launch", "Verifiche prima del rilascio"),
    detail: t(
      "I test the main tasks users need to complete, including forms or sign-in where relevant, on desktop and mobile.",
      "Verifico da computer e da telefono che le persone riescano a completare le operazioni principali, come compilare un modulo o accedere a un’area riservata."
    ),
  },
  {
    name: t("Go-live", "Messa in produzione"),
    detail: t(
      "I publish the site or application on its final domain over HTTPS and check that updates can be released.",
      "Pubblico il sito o l’applicazione sul dominio definitivo con HTTPS e verifico che gli aggiornamenti si possano rilasciare."
    ),
  },
  {
    name: t("Handover", "Consegna"),
    detail: t(
      "I hand over the information you need to access the service, make updates or pass its maintenance to someone else.",
      "Ti lascio le informazioni per accedere al servizio, aggiornarlo o affidarne la gestione a un’altra persona."
    ),
  },
];

const appointmentHours = [[9, 12], [14, 17]];
const slots = appointmentHours.map(([start, end]) => (
  Array.from({ length: (end - start) * 2 }, (_, index) => {
    const hour = String(start + Math.floor(index / 2)).padStart(2, "0");
    return `${hour}:${index % 2 === 0 ? "00" : "30"}`;
  })
));
const email = "vincenzopaolo.diperna@outlook.com";
---

<BaseLayout
  title={t("Digital Services | Vincenzo Di Perna", "Servizi digitali | Vincenzo Di Perna")}
  description={t(
    "Digital consulting, production-ready websites and applications, technical support and hands-on training from Vincenzo Di Perna.",
    "Consulenza digitale, realizzazione e messa in produzione di siti e applicazioni, supporto tecnico e formazione pratica con Vincenzo Di Perna."
  )}
  sideBarActiveItemID="services"
  showNetworkBackground={false}
>
  <digital-services class="studio" data-language={language} data-email={email}>
    <header class="services-hero">
      <div class="hero-copy">
        <h1>{t("Digital Services", "Servizi digitali")}</h1>
        <p>{t(
          "I help you choose, build and manage the digital tools you rely on at work. I take websites and applications through to launch and offer technical support and hands-on training.",
          "Ti aiuto a scegliere, realizzare e gestire gli strumenti digitali con cui lavori. Seguo la messa in produzione di siti e applicazioni e offro supporto tecnico e formazione pratica."
        )}</p>
        <a class="services-action" href="#choose-service" data-astro-reload>
          {t("Explore the services", "Esplora i servizi")} <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="hero-image">
        <img src="/services/workbench.webp" width="1100" height="733" alt="" fetchpriority="high" decoding="async" />
      </div>
    </header>

    <section class="services-section" aria-labelledby="choose-service">
      <div class="section-heading">
        <h2 id="choose-service">{t("What do you need help with?", "Di cosa hai bisogno?")}</h2>
        <p>{t(
          "Open a service to see when it can help and what you can expect.",
          "Apri una voce per capire quando ti serve quel servizio e cosa puoi ottenere."
        )}</p>
      </div>
      <div class="service-list">
        {services.map(({ name, question, need, work, outcome }) => (
          <details class="service-option">
            <summary class="service-summary">
              <span class="service-label">
                <span class="service-name">{name}</span>
                <span class="service-question">{question}</span>
              </span>
              <span class="service-toggle" aria-hidden="true"></span>
            </summary>
            <div class="service-detail">
              <div class="service-detail-grid">
                <div>
                  <h3>{t("When it’s useful", "Quando ti serve")}</h3>
                  <p>{need}</p>
                </div>
                <div>
                  <h3>{t("What I can do for you", "Su cosa ti aiuto")}</h3>
                  <ul>
                    {work.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              </div>
              <div class="service-outcome">
                <div>
                  <h3>{t("What you get", "Cosa ottieni")}</h3>
                  <p>{outcome}</p>
                </div>
                <button
                  class="service-request"
                  type="button"
                  data-open-booking
                  data-service={name}
                  aria-haspopup="dialog"
                  hidden
                >
                  {t("Request an appointment", "Richiedi un appuntamento")} <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="services-section production" aria-labelledby="production-ready">
      <div class="section-heading">
        <h2 id="production-ready">
          {locale === "it"
            ? <>Cosa significa «<span lang="en">production ready</span>»</>
            : "What “production ready” means"}
        </h2>
        <p>{t(
          "A website or application is ready for production when people can use it at its final address and you know how to manage it after launch.",
          "Un sito o un’applicazione è pronto per la produzione quando le persone possono usarlo all’indirizzo definitivo e tu sai come gestirlo dopo il lancio."
        )}</p>
      </div>
      <div class="production-grid">
        {productionSteps.map(({ name, detail }) => (
          <div>
            <h3>{name}</h3>
            <p>{detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="services-section studio-booking" aria-labelledby="appointment">
      <div class="section-heading">
        <h2 id="appointment">{t("Tell me what you need", "Raccontami cosa ti serve")}</h2>
        <p>{t(
          "In a free 30-minute call, we can go over what you want to achieve, what you already have and where I can help.",
          "In un primo colloquio gratuito di 30 minuti possiamo capire cosa vuoi ottenere, da cosa parti e come posso aiutarti."
        )}</p>
      </div>
      <div class="booking-action">
        <button class="services-action" type="button" data-open-booking aria-haspopup="dialog" hidden>
          {t("Request an appointment", "Richiedi un appuntamento")} <span aria-hidden="true">→</span>
        </button>
        <noscript>
          <a class="services-action" href={inLanguage("/contact/", locale)}>
            {t("Contact me", "Contattami")} <span aria-hidden="true">→</span>
          </a>
        </noscript>
      </div>
    </section>

    <dialog class="booking-dialog" aria-labelledby="booking-title" aria-describedby="booking-topic booking-note">
      <div class="booking-header">
        <h3 id="booking-title">{t("Request a free appointment", "Richiedi un appuntamento gratuito")}</h3>
        <form method="dialog">
          <button class="btn btn-ghost btn-circle btn-sm" aria-label={t("Close", "Chiudi")}>×</button>
        </form>
      </div>
      <p id="booking-topic" class="booking-topic" data-booking-topic hidden></p>
      <p id="booking-note">{t(
        "Choose a time for your free 30-minute call. I’ll confirm the appointment by email.",
        "Scegli un orario per il colloquio gratuito di 30 minuti. Ti confermerò l’appuntamento via email."
      )}</p>

      <form class="booking-form" data-booking-form data-subject={t("Digital services · Appointment request", "Servizi digitali · Richiesta appuntamento")}>
        <label class="booking-date">
          {t("Preferred date", "Data preferita")}
          <input class="input input-bordered" type="date" name="date" required />
        </label>
        <fieldset class="booking-times" aria-describedby="booking-timezone" disabled>
          <legend>{t("Start time", "Ora di inizio")}</legend>
          <p id="booking-timezone">{t(
            "Italy time (Europe/Rome) · 09:00–12:00 and 14:00–17:00",
            "Ora italiana (Europe/Rome) · 09:00–12:00 e 14:00–17:00"
          )}</p>
          {slots.map((times, index) => (
            <div class="slot-group" role="group" aria-label={index === 0 ? t("Morning", "Mattina") : t("Afternoon", "Pomeriggio")}>
              {times.map((time) => (
                <label class="slot">
                  <input type="radio" class="sr-only" name="time" value={time} required />
                  <span>{time}</span>
                </label>
              ))}
            </div>
          ))}
        </fieldset>
        <p class="studio-note" data-no-times hidden>{t(
          "Choose another date to see more times.",
          "Scegli un’altra data per vedere altri orari."
        )}</p>
        <button class="btn btn-primary" type="submit">{t("Open email", "Apri email")}</button>
      </form>
    </dialog>
  </digital-services>
</BaseLayout>

<script>
  const romeClock = new Intl.DateTimeFormat("en-CA", {
    timeZone: "Europe/Rome",
    year: "numeric", month: "2-digit", day: "2-digit",
    hour: "2-digit", minute: "2-digit", hourCycle: "h23",
  });

  class DigitalServices extends HTMLElement {
    #initialized = false;

    connectedCallback() {
      if (this.#initialized) return;
      this.#initialized = true;

      const dialog = this.querySelector("dialog")!;
      const form = dialog.querySelector<HTMLFormElement>("[data-booking-form]")!;
      const topic = dialog.querySelector<HTMLParagraphElement>("[data-booking-topic]")!;
      const date = form.querySelector<HTMLInputElement>('[name="date"]')!;
      const timeGroup = form.querySelector<HTMLFieldSetElement>(".booking-times")!;
      const times = [...timeGroup.querySelectorAll<HTMLInputElement>('[name="time"]')];
      const noTimes = form.querySelector<HTMLElement>("[data-no-times]")!;
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const italian = this.dataset.language === "it-IT";

      const updateTimes = () => {
        const parts = Object.fromEntries(romeClock.formatToParts(new Date()).map(({ type, value }) => [type, value]));
        const today = `${parts.year}-${parts.month}-${parts.day}`;
        const now = `${parts.hour}:${parts.minute}`;

        date.min = today;
        timeGroup.disabled = !date.value || !date.validity.valid;
        for (const time of times) {
          time.disabled = date.value === today && time.value <= now;
          if (time.disabled) time.checked = false;
        }
        const noneAvailable = times.every((time) => time.disabled);
        noTimes.hidden = !noneAvailable;
        submitButton.disabled = timeGroup.disabled || noneAvailable;
      };

      for (const button of this.querySelectorAll<HTMLButtonElement>("[data-open-booking]")) {
        button.hidden = false;
        button.addEventListener("click", () => {
          topic.textContent = button.dataset.service ?? "";
          topic.hidden = !topic.textContent;
          updateTimes();
          dialog.showModal();
        });
      }

      date.addEventListener("change", updateTimes);
      form.addEventListener("submit", (event) => {
        event.preventDefault();
        updateTimes();
        const time = times.find((slot) => slot.checked && !slot.disabled);
        if (!form.reportValidity() || !time) return;

        const serviceLine = topic.textContent ? `\n${italian ? "Servizio" : "Service"}: ${topic.textContent}` : "";
        const body = italian
          ? `Ciao Vincenzo,\n\nvorrei richiedere un colloquio gratuito di 30 minuti.${serviceLine}\nData e ora preferite: ${date.value}, ${time.value} (Europe/Rome).\n\nDi cosa ho bisogno:\n\nGrazie!`
          : `Hi Vincenzo,\n\nI’d like to request a free 30-minute call.${serviceLine}\nPreferred date and time: ${date.value}, ${time.value} (Europe/Rome).\n\nWhat I need help with:\n\nThank you!`;
        location.href = `mailto:${this.dataset.email}?subject=${encodeURIComponent(form.dataset.subject!)}&body=${encodeURIComponent(body)}`;
      });
    }
  }

  customElements.define("digital-services", DigitalServices);
</script>

<style>
  .studio {
    --ink: #282624;
    --muted: #514d46;
    --line: #dfdad1;
    --accent: #f7ca57;
    display: block;
    width: min(56rem, 100%);
    margin-inline: auto;
    color: var(--ink);
  }

  .studio :is(p, li) {
    text-align: start;
    hyphens: manual;
  }

  .services-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.16fr) minmax(0, 1fr);
    overflow: hidden;
    border-radius: 1rem;
    background: #232120;
    color: #fff;
  }

  .hero-copy {
    align-self: center;
    padding: clamp(1.5rem, 4vw, 2.8rem);
  }

  .hero-copy h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 750;
    line-height: 1.03;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero-copy p {
    margin: 0.85rem 0 1.35rem;
    max-width: 35ch;
    color: #e8e1d9;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .hero-image {
    position: relative;
    overflow: hidden;
    background: #39322b;
  }

  .hero-image img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 57%;
  }

  .services-action {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border-radius: 0.4rem;
    background: var(--accent);
    color: #232120;
    font-size: 0.96rem;
    font-weight: 700;
    text-align: start;
  }

  .services-action:hover { background: #ffda78; }
  .services-action[hidden], .service-request[hidden] { display: none; }
  .services-action > span, .service-request > span { flex: none; }

  .services-section { margin-top: clamp(2rem, 4vw, 3rem); }
  .section-heading { margin-bottom: 1rem; }
  .section-heading h2 {
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 750;
    line-height: 1.14;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .section-heading p {
    max-width: 62ch;
    margin-top: 0.45rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .service-list { display: grid; gap: 0.65rem; }
  .service-option {
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: #fff;
  }

  .service-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem clamp(1rem, 3vw, 1.55rem);
    border-radius: inherit;
    cursor: pointer;
    list-style: none;
  }
  .service-summary::-webkit-details-marker { display: none; }
  .service-summary:hover, .service-option[open] > .service-summary { background: #fcf7ec; }
  .service-option[open] {
    border-color: #c7a95f;
  }
  .service-option[open] > .service-summary {
    border-end-start-radius: 0;
    border-end-end-radius: 0;
  }

  .service-label { display: grid; gap: 0.25rem; }
  .service-name {
    font-size: 0.86rem;
    font-weight: 700;
    color: #624810;
  }
  .service-question {
    font-size: clamp(1.07rem, 2.25vw, 1.35rem);
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: -0.015em;
  }
  .service-toggle {
    position: relative;
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid #d3c7aa;
    border-radius: 50%;
    color: #5f4310;
  }
  .service-toggle::before, .service-toggle::after {
    position: absolute;
    width: 0.7rem;
    height: 2px;
    background: currentColor;
    content: "";
  }
  .service-toggle::after { transform: rotate(90deg); }
  .service-option[open] .service-toggle {
    border-color: transparent;
    background: var(--accent);
    color: #232120;
  }
  .service-option[open] .service-toggle::after { transform: none; }

  .service-detail {
    border-top: 1px solid #eadfc2;
    padding: clamp(1rem, 3vw, 1.55rem);
  }
  .service-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(1.1rem, 3.5vw, 2.25rem);
  }
  .service-detail h3, .production h3 {
    margin-bottom: 0.3rem;
    font-size: 1rem;
    font-weight: 750;
    line-height: 1.25;
  }
  .service-detail :is(p, li), .production-grid p {
    color: var(--muted);
    line-height: 1.55;
  }
  .service-detail ul {
    list-style: disc;
    padding-inline-start: 1.15em;
  }
  .service-detail li + li { margin-top: 0.28rem; }

  .service-outcome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 0.45rem;
    background: #f7f4ed;
  }
  .service-request {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: #63460b;
    font-weight: 700;
    text-align: start;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .service-request:hover { color: #232120; }

  .production {
    padding: clamp(1.15rem, 4vw, 2.15rem);
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: #f7f4ee;
  }
  .production-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem 1.2rem;
  }
  .production-grid > div {
    padding-top: 0.7rem;
    border-top: 2px solid #b69546;
  }

  .studio-booking {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.35rem;
    margin-bottom: 0.65rem;
    padding: clamp(1.15rem, 4vw, 1.9rem);
    border-radius: 0.85rem;
    background: #232120;
    color: #fff;
  }
  .studio-booking .section-heading { margin: 0; }
  .studio-booking .section-heading p { color: #e8e1d9; }
  .booking-action { flex: none; max-width: 100%; }

  :is(.services-action, .service-summary, .service-request):focus-visible {
    outline: 2px solid #8e660f;
    outline-offset: 3px;
  }
  .services-action:focus-visible { outline-color: var(--accent); }

  @media (max-width: 43rem) {
    .services-hero { grid-template-columns: minmax(0, 1fr); }
    .hero-image { aspect-ratio: 2.1; }
    .hero-copy p { max-width: 52ch; }
    .service-detail-grid, .production-grid { grid-template-columns: minmax(0, 1fr); }
    .service-outcome, .studio-booking { flex-direction: column; align-items: flex-start; }
  }

  .booking-dialog {
    width: min(33rem, calc(100% - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: clamp(1rem, 4vw, 1.65rem);
