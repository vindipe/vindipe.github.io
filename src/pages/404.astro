---
import { translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
---

<BaseLayout title = {t("404: Not Found", "Pagina non trovata")} includeSidebar={false}>
  <div class="text-center">
    <div aria-hidden="true" class="text-9xl font-bold mb-4">🏝</div>
    <h1 class="text-9xl font-bold mb-2">404</h1>
    <h3 class="text-2xl">{t("The page you're looking for couldn't be found.", "La pagina che cerchi non è disponibile.")}</h3>
    <a class="btn btn-accent mt-9" href="/">{t("Home", "Torna alla home")}</a>
  </div>
</BaseLayout>
