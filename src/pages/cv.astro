---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const publications = [
  {
    title:
      "The Impact of Network Topology on Performance Metrics and Energy Consumption for Blockchains: Towards Repeatable Benchmarking",
    badge: t("ACM DLT journal", "Rivista ACM DLT"),
    authors:
      "Vincenzo P. Di Perna, Valerio Schiavoni, Miguel Matos, Francesco Fabris, and Marco Bernardo.",
    venue:
      t("ACM Distributed Ledger Technologies: Research and Practice journal, 2026.", "Rivista ACM Distributed Ledger Technologies: Research and Practice, 2026."),
    links: [
      {
        label: t("Research page", "Scheda della ricerca"),
        href: "/research/acm-dlt-network-topologies-blockchain-performance",
        primary: true,
      },
      {
        label: t("DOI / Paper", "DOI e articolo"),
        href: "https://dl.acm.org/doi/10.1145/3828757",
        external: true,
      },
    ],
  },
  {
    title: "Dynamic Taxonomy: A Bridge from DeFi to TradFi",
    badge: "SSRN / CCAF",
    authors:
      "Iqbal Mabruri, Carles Cerqueda, Christopher Jack, Alexis Lui, Yue Wu, Wenbin Wu, Vincenzo P. Di Perna, Keith Bear, and Bryan Zheng Zhang.",
    venue:
      t("SSRN working paper developed in collaboration with the Cambridge Centre for Alternative Finance (CCAF).", "Working paper su SSRN, sviluppato con il Cambridge Centre for Alternative Finance (CCAF)."),
    links: [
      {
        label: t("Research page", "Scheda della ricerca"),
        href: "/research/dynamic-taxonomy-defi-tradfi",
        primary: true,
      },
      {
        label: "SSRN",
        href: "https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5034378",
        external: true,
      },
      {
        label: t("CCAF experience", "Esperienza al CCAF"),
        href: "/research/ccaf-experience",
      },
    ],
  },
  {
    title:
      "An Entropy-Based Approach to Evaluating the Economic Efficiency of Cryptocurrencies",
    badge: "DLT '25",
    authors:
      "Vincenzo P. Di Perna, Michele Foderaro, Francesco Fabris, and Marco Bernardo.",
    venue:
      "Distributed Ledger Technology Workshop, CEUR Workshop Proceedings, Vol. 4105, 2025.",
    links: [
      {
        label: t("Research page", "Scheda della ricerca"),
        href: "/research/entropy-based-economic-efficiency",
        primary: true,
      },
      {
        label: t("CEUR paper", "Articolo su CEUR"),
        href: "https://ceur-ws.org/Vol-4105/paper09.pdf",
        external: true,
      },
    ],
  },
  {
    title:
      "Blockchain Energy Consumption: Unveiling the Impact of Network Topologies",
    badge: "IEEE ICBC '25",
    authors:
      "Vincenzo P. Di Perna, Valerio Schiavoni, Francesco Fabris, and Marco Bernardo.",
    venue:
      t("Proceedings of the 2025 IEEE International Conference on Blockchain and Cryptocurrency.", "Atti della IEEE International Conference on Blockchain and Cryptocurrency, 2025."),
    links: [
      {
        label: t("Research page", "Scheda della ricerca"),
        href: "/research/performance-energy-economic-efficiency",
        primary: true,
      },
      {
        label: "IEEE Xplore",
        href: "https://ieeexplore.ieee.org/document/11114569",
        external: true,
      },
    ],
  },
  {
    title: "Impact of Network Topologies on Blockchain Performance",
    badge: "ACM DEBS '25",
    authors:
      "Vincenzo P. Di Perna, Marco Bernardo, Francesco Fabris, Sebastião Amaro, Miguel Matos, and Valerio Schiavoni.",
    venue:
      t("Proceedings of the 19th ACM International Conference on Distributed and Event-Based Systems, 2025.", "Atti della 19ª ACM International Conference on Distributed and Event-Based Systems, 2025."),
    links: [
      {
        label: t("Research page", "Scheda della ricerca"),
        href: "/research/topology-aware-blockchain-benchmarking",
        primary: true,
      },
      {
        label: t("DOI / Paper", "DOI e articolo"),
        href: "https://dl.acm.org/doi/10.1145/3701717.3730540",
        external: true,
      },
    ],
  },
];
---

<BaseLayout
  title={t("CV | Research Software Engineer | Vincenzo Di Perna", "Curriculum | Vincenzo Di Perna")}
  description={t("Vincenzo Di Perna’s CV covers distributed systems, blockchain research, reproducible experiments, publications and software engineering.", "Curriculum di Vincenzo Di Perna, con esperienze, pubblicazioni e competenze in sistemi distribuiti, blockchain e sperimentazione riproducibile.")}
  sideBarActiveItemID="cv"
>
  <section class="mb-10">
    <h1 class="text-4xl font-bold mb-4">CV</h1>

    <p class="text-lg leading-relaxed opacity-90">
      {t("I am a Research Software Engineer with a PhD in Blockchain & DLT, focused on distributed systems, blockchain benchmarking, scientific computing, reproducible experimentation, protocol evaluation, and data analysis.", "Mi occupo di sviluppo software per la ricerca e ho un dottorato su blockchain e DLT. Lavoro su sistemi distribuiti, benchmarking, calcolo scientifico, esperimenti riproducibili, valutazione dei protocolli e analisi dei dati.")}
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        class="btn btn-primary"
        href="/cv/Vincenzo_Di_Perna_CV_2026.pdf?v=20260901"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t("Download CV (September 2026)", "Scarica il CV (PDF in inglese, settembre 2026)")}
      </a>

      <a
        class="btn btn-outline"
        href="https://github.com/vindipe"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>

      <a
        class="btn btn-outline"
        href="https://www.linkedin.com/in/vincenzo-di-perna/"
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>

      <a
        class="btn btn-outline"
        href="https://orcid.org/0009-0003-8834-9900"
        target="_blank"
        rel="me noopener noreferrer"
      >
        ORCID
      </a>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-3xl w-full font-bold mb-5">{t("Profile", "Profilo")}</h2>

    <div class="text-justify leading-relaxed">
      <p class="mb-4">
        {t("My work combines distributed systems research, experimental methodology, blockchain infrastructure evaluation, and data-driven analysis. During my PhD, I designed and used reproducible benchmarking pipelines to study how blockchain systems behave under different workloads, network topologies, and operational conditions.", "Il mio lavoro unisce ricerca sui sistemi distribuiti, metodologia sperimentale, valutazione delle infrastrutture blockchain e analisi dei dati. Durante il dottorato ho progettato e usato procedure di benchmarking riproducibili per studiare il comportamento delle blockchain al variare di carichi di lavoro, topologie di rete e condizioni operative.")}
      </p>

      <p class="mb-4">
        {t("I am particularly interested in performance and latency evaluation, energy efficiency, repeatability, performance predictability, protocol analytics, digital-asset and CBDC-related infrastructures, and research engineering practices that make experimental results easier to reproduce and compare.", "Mi interessano la valutazione delle prestazioni e della latenza, l’efficienza energetica, la ripetibilità e la prevedibilità, l’analisi dei protocolli e le infrastrutture per asset digitali e CBDC. Sviluppo metodi e strumenti che rendono i risultati sperimentali più facili da riprodurre e confrontare.")}
      </p>

      <p>{t("From 1 February 2027, I will join the University of Neuchâtel as a postdoctoral researcher and scientific coordinator of CIRCULA, an SNSF-funded research project about expiry-aware blockchain design.", "Dal 1° febbraio 2027 entrerò all’Università di Neuchâtel come ricercatore postdoc e coordinatore scientifico di CIRCULA, un progetto finanziato dal Fondo nazionale svizzero sulla scadenza e il rinnovo nelle blockchain.")}</p>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-3xl w-full font-bold mb-5">
      {t("Research & Engineering Experience", "Esperienza nella ricerca e nell’ingegneria")}
    </h2>

    <div class="time-line-container grid gap-4">
      <TimeLineElement title={t("Incoming Postdoctoral Researcher and Scientific Coordinator - CIRCULA", "Ricercatore postdoc e coordinatore scientifico di CIRCULA (incarico previsto)")} subtitle={t("University of Neuchâtel · expected from 1 February 2027", "Università di Neuchâtel · avvio previsto il 1° febbraio 2027")}>
        {t("CIRCULA is an SNSF-funded project on expiry and renewal in distributed ledgers. The planned role includes coordinating scientific work across formal semantics, prototyping and evaluation under Principal Investigator Valerio Schiavoni.", "CIRCULA è un progetto finanziato dal Fondo nazionale svizzero che studia scadenza e rinnovo nei registri distribuiti. Il ruolo prevede il coordinamento delle attività scientifiche sulla semantica formale, lo sviluppo di prototipi e la valutazione, sotto la responsabilità scientifica di Valerio Schiavoni.")}
        <br /><a href={localPath("/research/circula")} class="btn btn-xs btn-outline mt-3">{t("Explore CIRCULA", "Scopri CIRCULA")}</a>
      </TimeLineElement>
      <TimeLineElement
        title={t("Blockchain Benchmarking & Distributed Systems Research", "Benchmarking delle blockchain e ricerca sui sistemi distribuiti")}
        subtitle={t("PhD research and related publications", "Ricerca di dottorato e pubblicazioni")}
      >
        {t("Designed, executed, and analyzed reproducible blockchain experiments across multiple platforms, workloads, and network conditions. Evaluated throughput, latency, energy usage, variability, repeatability, and performance predictability under controlled experimental settings. Recent outputs include an ACM DLT journal article on topology-aware blockchain performance evaluation.", "Ho progettato, condotto e analizzato esperimenti blockchain riproducibili su più piattaforme, carichi di lavoro e condizioni di rete. Ho misurato throughput, latenza, consumi energetici, variabilità, ripetibilità e prevedibilità in condizioni controllate. Tra i risultati recenti c’è un articolo sulla rivista ACM DLT che valuta le prestazioni tenendo conto della topologia di rete.")}
      </TimeLineElement>

      <TimeLineElement
        title={t("Lilith - A Topology-Aware Blockchain Benchmarking Framework", "Lilith – Framework di benchmarking per blockchain con topologie controllate")}
        subtitle={t("Research artifact and experimental toolchain", "Software di ricerca e strumenti sperimentali")}
      >
        {t("Built a benchmarking framework integrating blockchain workload generation, network emulation, orchestration, and data analysis. Used it to study how topology and workload interactions affect blockchain performance and energy behavior.", "Ho sviluppato un framework di benchmarking che integra generazione dei carichi, emulazione di rete, orchestrazione e analisi dei dati. L’ho usato per studiare come l’interazione tra topologia e carico incida sulle prestazioni e sui consumi delle blockchain.")}

        <br />

        <a
          href={localPath("/research/lilith-benchmarking-framework")}
          class="btn btn-xs btn-outline mt-3"
        >
          {t("Open Lilith research page", "Vai alla pagina di Lilith")}
        </a>
      </TimeLineElement>

      <TimeLineElement
        title={t("Digital Assets & CBDC-Oriented Data Workflows", "Asset digitali e analisi dei dati per le CBDC")}
        subtitle={t("Protocol analytics, dashboards, and structured data analysis", "Analisi dei protocolli, dashboard e dati strutturati")}
      >
        {t("Worked on data-oriented analysis and dashboard concepts for digital assets, digital-asset and CBDC-related infrastructures, and blockchain ecosystem indicators, connecting technical protocol behavior with analytical and economic perspectives.", "Ho lavorato ad analisi dei dati e a proposte di dashboard per gli asset digitali, le infrastrutture per asset digitali e CBDC e gli indicatori degli ecosistemi blockchain, collegando il comportamento tecnico dei protocolli agli aspetti analitici ed economici.")}
      </TimeLineElement>

      <TimeLineElement
        title={t("Digital Asset Programme Intern", "Tirocinio nel Digital Asset Programme")}
        subtitle="Cambridge Centre for Alternative Finance"
      >
        {t("Research internship experience within the Digital Asset Programme, focused on digital assets, DeFi taxonomy, protocol classification, DeFi/TradFi mapping, and the Cambridge DeFi Navigator.", "Tirocinio di ricerca su asset digitali, tassonomia della DeFi, classificazione dei protocolli, relazioni tra DeFi e finanza tradizionale e Cambridge DeFi Navigator.")}

        <br />

        <a href={localPath("/research/ccaf-experience")} class="btn btn-xs btn-outline mt-3">
          {t("Open CCAF experience page", "Approfondisci l’esperienza al CCAF")}
        </a>

      </TimeLineElement>

      <TimeLineElement
        title={t("Research Engineering & Reproducibility", "Sviluppo software per la ricerca e riproducibilità")}
        subtitle={t("Software artifacts, datasets, pipelines, and experimental methodology", "Software, dataset, procedure e metodologia sperimentale")}
      >
        {t("Developed scripts, datasets, reproducible workflows, statistical analyses, and documentation to support repeatable experiments and transparent evaluation of blockchain systems.", "Ho sviluppato script, dataset, procedure riproducibili, analisi statistiche e documentazione per condurre esperimenti ripetibili e valutare le blockchain in modo trasparente.")}
      </TimeLineElement>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-3xl w-full font-bold mb-5">{t("Tools & Artifacts", "Strumenti e materiali")}</h2>

    <div class="grid gap-4">
      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">Lilith</h3>
          <p>
            {t("Topology-aware blockchain benchmarking framework integrating workload generation, network emulation, orchestration, and experiment analysis.", "Framework di benchmarking che integra topologie di rete controllate, generazione dei carichi, emulazione, orchestrazione e analisi degli esperimenti.")}
          </p>
          <div class="card-actions justify-end">
            <a
              class="btn btn-sm btn-primary"
              href={localPath("/research/lilith-benchmarking-framework")}
            >
              {t("Artifact page", "Scheda dello strumento")}
            </a>

            <a
              class="btn btn-sm btn-outline"
              href="https://doi.org/10.5281/zenodo.11409100"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t("Zenodo artifact", "Materiali su Zenodo")}
            </a>

            <a
              class="btn btn-sm btn-outline"
              href={localPath("/research/acm-dlt-network-topologies-blockchain-performance")}
            >
              {t("Related ACM DLT article", "Articolo correlato su ACM DLT")}
            </a>
          </div>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Blockchain Repeatability Dataset", "Dataset sulla ripetibilità dei benchmark blockchain")}</h3>
          <p>
            {t("Network-controlled dataset with 300 aggregate configurations for studying blockchain benchmark variability, repeatability, and performance predictability.", "Dataset con 300 configurazioni aggregate in condizioni di rete controllate, per studiare variabilità, ripetibilità e prevedibilità delle prestazioni delle blockchain.")}
          </p>
          <div class="card-actions justify-end">
            <a
              class="btn btn-sm btn-primary"
              href={localPath("/research/blockchain-repeatability-dataset")}
            >
              {t("Dataset page", "Scheda del dataset")}
            </a>

            <a
              class="btn btn-sm btn-outline"
              href="https://doi.org/10.5281/zenodo.17681717"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t("Zenodo dataset", "Dataset su Zenodo")}
            </a>

            <a
              class="btn btn-sm btn-outline"
              href="https://github.com/vindipe/blockchain-repeatability-benchmarking"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t("GitHub repository", "Repository GitHub")}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-3xl w-full font-bold mb-5">{t("Publications", "Pubblicazioni")}</h2>

    <div class="grid gap-4">
      {
        publications.map((publication) => (
          <div class="card bg-base-100 shadow-md">
            <div class="card-body">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-2">
                <h3 class="card-title">{publication.title}</h3>
                <span class="badge badge-secondary shrink-0">
                  {publication.badge}
                </span>
              </div>

              <p>{publication.authors}</p>
              <p class="opacity-80">{publication.venue}</p>

              <div class="card-actions justify-end">
                {publication.links.map((link) => (
                  <a
                    class:list={[
                      "btn btn-sm",
                      link.primary ? "btn-primary" : "btn-outline",
                    ]}
                    href={localPath(link.href)}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-3xl w-full font-bold mb-5">{t("Education", "Formazione")}</h2>

    <div class="time-line-container grid gap-4">
      <TimeLineElement
        title={t("PhD in Blockchain & Distributed Ledger Technology", "Dottorato in blockchain e tecnologie a registro distribuito")}
        subtitle={t("University of Camerino, Italy", "Università di Camerino, Italia")}
        date="2022-2025"
      >
        {t("Dissertation focused on comparing blockchain systems across performance, energy, repeatability, predictability, and economic-efficiency dimensions. Research included topology-aware benchmarking, reproducible experimentation, workload design, network emulation, and statistical analysis of blockchain system behavior.", "La tesi confronta i sistemi blockchain in termini di prestazioni, consumi energetici, ripetibilità, prevedibilità ed efficienza economica. La ricerca comprende benchmarking con topologie controllate, esperimenti riproducibili, progettazione dei carichi, emulazione di rete e analisi statistica.")}

        <br />

        <a
          href={localPath("/research/comparing-blockchains")}
          class="btn btn-xs btn-outline mt-3 mr-2"
        >
          {t("Open thesis page", "Vai alla tesi")}
        </a>

        <a
          href="/theses/phd-thesis-comparing-blockchains.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-xs btn-outline mt-3"
        >
          {t("Open PDF", "Apri il PDF")}
        </a>
      </TimeLineElement>

      <TimeLineElement
        title={t("MSc in ICT Solutions Architect", "Laurea magistrale in ICT Solutions Architect")}
        subtitle={t("University of Pisa, Italy", "Università di Pisa, Italia")}
        date="2019-2022"
      >
        {t("Graduate studies focused on ICT architectures, software systems, networks, security, and technical design of digital infrastructures.", "Studi magistrali su architetture ICT, sistemi software, reti, sicurezza e progettazione di infrastrutture digitali.")}

        <br />

        <a
          href={localPath("/research/decentralized-accounting-system")}
          class="btn btn-xs btn-outline mt-3 mr-2"
        >
          {t("Open thesis page", "Vai alla tesi")}
        </a>

        <a
          href="/theses/master-thesis-decentralized-accounting-system.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-xs btn-outline mt-3"
        >
          {t("Open PDF", "Apri il PDF")}
        </a>
      </TimeLineElement>

      <TimeLineElement
        title={t("BSc in Computer Systems and Network Security", "Laurea triennale in Sicurezza dei sistemi e delle reti informatiche")}
        subtitle={t("University of Milan, Italy", "Università degli Studi di Milano, Italia")}
        date="2015-2019"
      >
        {t("Foundation in computer systems, operating systems, networks, cybersecurity, programming, and technical problem solving.", "Formazione di base in sistemi informatici, sistemi operativi, reti, sicurezza informatica, programmazione e risoluzione di problemi tecnici.")}

        <br />

        <a
          href="/theses/bachelor-thesis-threat-modeling-process.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-xs btn-outline mt-3"
        >
          {t("Open bachelor thesis PDF", "Apri il PDF della tesi triennale")}
        </a>
      </TimeLineElement>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-3xl w-full font-bold mb-5">{t("Certifications", "Certificazioni")}</h2>

    <div class="time-line-container grid gap-4">
      <TimeLineElement
        title="Blockchain for Business Certificate"
        subtitle="SUPSI / USI / Franklin University Switzerland / City of Lugano"
        date="2023"
        variant="warning"
      >
        {t("Professional certificate focused on blockchain applications, business use cases, digital-asset-related innovation, and the connection between blockchain technologies, institutions, and real-world business contexts.", "Certificazione professionale sulle applicazioni aziendali della blockchain e sull’innovazione legata agli asset digitali, con attenzione al rapporto tra tecnologie, istituzioni e imprese.")}
      </TimeLineElement>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="text-3xl w-full font-bold mb-5">{t("Technical Skills", "Competenze tecniche")}</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Programming, scripting & automation", "Programmazione, scripting e automazione")}</h3>

          <ul class="list-disc mx-6 grid gap-1">
            <li>
              {t("Python for orchestration, data processing, experiment automation, and analysis workflows", "Python per orchestrazione, elaborazione dati, automazione degli esperimenti e analisi")}
            </li>
            <li>
              {t("Bash scripting for Linux automation, reproducible runs, and command-line pipelines", "Script Bash per l’automazione su Linux, le esecuzioni riproducibili e le procedure da riga di comando")}
            </li>
            <li>
              {t("Rust familiarity for systems-oriented programming and low-level software concepts", "Familiarità con Rust per la programmazione di sistema e i concetti di basso livello")}
            </li>
            <li>
              {t("JavaScript / TypeScript basics for web interfaces, personal-site tooling, and frontend integration", "Basi di JavaScript e TypeScript per interfacce web, strumenti del sito personale e integrazione frontend")}
            </li>
            <li>
              {t("Familiarity with Go, C, and C++ from systems, networking, and academic contexts", "Familiarità con Go, C e C++ in ambito accademico e per applicazioni di rete e di sistema")}
            </li>
            <li>
              {t("Git, GitHub, branching, pull requests, repository organization, and basic CI workflows", "Git, GitHub, gestione dei branch, pull request, organizzazione dei repository e procedure di integrazione continua di base")}
            </li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Data analysis, statistics & visualization", "Analisi dei dati, statistica e visualizzazione")}</h3>

          <ul class="list-disc mx-6 grid gap-1">
            <li>
              {t("Structured analysis of benchmark outputs, logs, experimental traces, and performance datasets", "Analisi strutturata di benchmark, log, tracce sperimentali e dataset sulle prestazioni")}
            </li>
            <li>
              {t("Throughput, latency, energy, variability, repeatability, and predictability metrics", "Metriche di throughput, latenza, energia, variabilità, ripetibilità e prevedibilità")}
            </li>
            <li>
              {t("Statistical reasoning for experimental comparison, including ANOVA and ICC-style variance analysis", "Confronto statistico degli esperimenti, anche con ANOVA e analisi della varianza basate sull’ICC")}
            </li>
            <li>
              {t("Data cleaning, aggregation, transformation, and reproducible analysis pipelines", "Pulizia, aggregazione e trasformazione dei dati in procedure di analisi riproducibili")}
            </li>
            <li>
              {t("Python-based analytics with notebooks, scripts, CSV/JSON processing, and publication-ready figures", "Analisi in Python con notebook, script, dati CSV e JSON e grafici per pubblicazioni")}
            </li>
            <li>
              {t("Dashboard-style visual analytics for protocol, digital-asset, and infrastructure indicators", "Dashboard per visualizzare indicatori di protocolli, asset digitali e infrastrutture")}
            </li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-100 shadow-md">
        <div class="card-body">
          <h3 class="card-title">{t("Distributed systems & infrastructure", "Sistemi distribuiti e infrastrutture")}</h3>

          <ul class="list-disc mx-6 grid gap-1">
            <li>
              {t("Linux-based development, debugging, scripting, and experimental execution environments", "Sviluppo, debugging, scripting e ambienti sperimentali su Linux")}
            </li>
            <li>
              {t("Docker-based deployment, containerized experiments, and reproducible software environments", "Deployment con Docker, esperimenti in container e ambienti software riproducibili")}
            </li>
            <li>
              {t("Network emulation and controlled experimental topologies for distributed-system evaluation", "Emulazione di rete e topologie controllate per valutare sistemi distribuiti")}
            </li>
            <li>
              {t("Benchmark orchestration across multiple nodes, workloads, platforms, and configurations", "Orchestrazione di benchmark con più nodi, carichi, piattaforme e configurazioni")}
