---
import { getLocale, inLanguage, translator } from "../i18n/locale";

const { sideBarActiveItemID } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = translator(Astro.url.pathname);
const items = [
  { id: "home", path: "/", label: "Home" },
  { id: "projects", path: "/projects/", label: t("Projects and Tools", "Progetti e strumenti") },
  { id: "research", path: "/research/", label: t("Research", "Ricerca") },
  { id: "tutorials", path: "/tutorials/", label: "Blockchain 101" },
  { id: "cv", path: "/cv/", label: "CV" },
  { id: "services", path: "/services/", label: "Freelancing", sectionMenu: false },
  { id: "contact", path: "/contact/", label: t("Contact me", "Contatti") },
];
---

<nav aria-label={t("Main navigation", "Navigazione principale")} class="grow shrink overflow-y-auto">
  <ul class="menu menu-md">
    {items.map(({ id, path, label, sectionMenu }) => (
      <li data-page-menu={inLanguage(path, locale)} data-section-menu={sectionMenu === false ? "off" : undefined}>
        <a
          class:list={["py-3 text-base font-medium", id === sideBarActiveItemID && "bg-primary-content/20"]}
          href={inLanguage(path, locale)}
          aria-current={Astro.url.pathname === inLanguage(path, locale) ? "page" : undefined}
        >{label}</a>
      </li>
    ))}
    <li data-current-sections hidden></li>
  </ul>
  <template id="page-sections-template">
    <details class="page-sections">
      <summary aria-label={t("Page sections", "Sezioni della pagina")}>
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <ul></ul>
    </details>
  </template>
</nav>

<script>
  type Section = { id: string; label: string };
  let navigation: Promise<Record<string, Section[]>> | undefined;

  function addSections(menu: HTMLElement, entries: Section[], path: string, current: boolean) {
    const template = document.querySelector<HTMLTemplateElement>("#page-sections-template");
    if (menu.dataset.sectionMenu === "off" || !template || entries.length < 2 || menu.querySelector(".page-sections")) return;
    const fragment = template.content.cloneNode(true) as DocumentFragment;
    const details = fragment.querySelector("details")!;
    const summary = details.querySelector("summary")!;
    const list = details.querySelector("ul")!;
    const title = menu.querySelector(":scope > a")?.textContent?.trim();

    if (title) summary.setAttribute("aria-label", `${summary.getAttribute("aria-label")} · ${title}`);
    else summary.prepend(document.querySelector("#main-content h1")?.textContent?.trim() ?? "");
    details.open = current;

    for (const { id, label } of entries) {
      const item = document.createElement("li");
      const link = document.createElement("a");
      link.href = `${current ? "" : path}#${id}`;
      link.textContent = label;
      link.dataset.sectionLink = "";
      if (current) link.dataset.astroReload = "";
      item.append(link);
      list.append(item);
    }

    menu.append(fragment);
    menu.hidden = false;
  }

  async function showPageSections() {
    const path = location.pathname.replace(/\/?$/, "/");
    const menus = [...document.querySelectorAll<HTMLElement>("[data-page-menu]")];
    const current = menus.find((menu) => menu.dataset.pageMenu === path) ??
      document.querySelector<HTMLElement>("[data-current-sections]");
    const sections = [...document.querySelectorAll<HTMLElement>("#main-content h2[id]")].map((heading) => ({
      id: heading.dataset.sectionTarget ?? heading.id,
      label: heading.textContent?.trim() ?? "",
    }));
    if (current) addSections(current, sections, path, true);
    if (!menus.length) return;

    navigation ??= fetch("/site-index/navigation.json").then((response) => {
      if (!response.ok) throw new Error("Section index unavailable");
      return response.json();
    });
    try {
      const index = await navigation;
      for (const menu of menus) {
        const url = menu.dataset.pageMenu!;
        if (menu.isConnected && url !== path && index[url]) addSections(menu, index[url], url, false);
      }
    } catch {
      navigation = undefined;
    }
  }

  showPageSections();
  document.addEventListener("astro:page-load", showPageSections);

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || event.defaultPrevented ||
        event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = event.target.closest<HTMLAnchorElement>("a[data-section-link]");
    if (!link) return;

    const drawer = document.querySelector<HTMLInputElement>("#my-drawer");
    if (drawer?.checked) drawer.checked = false;
    if (link.pathname !== location.pathname) return;
    const section = document.getElementById(link.hash.slice(1));
    if (section) {
      section.tabIndex = -1;
      requestAnimationFrame(() => section.focus({ preventScroll: true }));
    }
  });
</script>

<style is:global>
  .menu .page-sections {
    display: block;
    padding: 0 0.25rem 0.3rem;
  }

  .menu [data-page-menu]:has(> .page-sections) {
    position: relative;
    --page-menu-row: 3.25rem;
  }

  .menu [data-page-menu]:has(> .page-sections) > a {
    display: flex;
    align-items: center;
    min-height: var(--page-menu-row);
    padding-block: 0;
    padding-inline-end: 3.5rem;
  }

  .menu .page-sections > summary {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
  }

  .menu .page-sections > summary::-webkit-details-marker { display: none; }

  .menu .page-sections > summary::after {
    display: none;
  }

  .menu [data-page-menu] > a + .page-sections > summary {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    display: grid;
    place-items: center;
    place-content: center;
    width: 3.15rem;
    height: var(--page-menu-row);
    padding: 0;
    list-style: none;
  }

  .menu .page-sections[open] > summary svg {
    transform: rotate(180deg);
  }

  .menu .page-sections li > a {
    display: block;
    padding: 0.55rem 0.6rem;
    font-size: 0.875rem;
    line-height: 1.25;
  }
</style>
