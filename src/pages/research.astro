---
import { getLocale, inLanguage, translator } from "../i18n/locale";
import BaseLayout from "../layouts/BaseLayout.astro";

const t = translator(Astro.url.pathname);
const locale = getLocale(Astro.url.pathname);
const localPath = (href: string) => inLanguage(href, locale);

const publications = [
  {
    title:
      "The Impact of Network Topology on Performance Metrics and Energy Consumption for Blockchains: Towards Repeatable Benchmarking",
    badge: t("ACM DLT journal", "Rivista ACM DLT"),
    href: "/research/acm-dlt-network-topologies-blockchain-performance",
    desc: t("ACM DLT journal article on topology-aware blockchain benchmarking, network-controlled experiments, workload sensitivity, and reproducible evaluation of blockchain performance.", "Articolo sulla rivista ACM DLT dedicato al benchmarking delle blockchain con topologie controllate. Studia l’effetto dei carichi di lavoro e come ottenere valutazioni riproducibili delle prestazioni."),
    tags: [
      "ACM DLT",
      t("Blockchain benchmarking", "Benchmarking delle blockchain"),
      t("Network topology", "Topologia di rete"),
      t("Reproducibility", "Riproducibilità"),
    ],
  },
  {
    title: "Dynamic Taxonomy: A Bridge from DeFi to TradFi",
    badge: "CCAF / Working paper",
    href: "/research/dynamic-taxonomy-defi-tradfi",
    desc: t("Research developed within the Cambridge Centre for Alternative Finance on a dynamic DeFi taxonomy designed to connect decentralised finance with traditional finance, regulatory perspectives, and the Cambridge DeFi Navigator.", "Ricerca del Cambridge Centre for Alternative Finance su una tassonomia dinamica della DeFi, pensata per mettere in relazione finanza decentralizzata, finanza tradizionale, prospettive normative e Cambridge DeFi Navigator."),
    tags: ["DeFi", "TradFi", t("Taxonomy", "Tassonomia"), t("Digital assets", "Asset digitali"), "CCAF"],
  },
  {
    title:
      "An Entropy-Based Approach to Evaluating the Economic Efficiency of Cryptocurrencies",
    badge: "DLT '25",
    href: "/research/entropy-based-economic-efficiency",
    desc: t("Research introducing an entropy-based index to evaluate the economic efficiency of cryptocurrencies through on-chain attributes, user participation, supply dynamics, and transfer activity.", "Lo studio propone un indice basato sull’entropia per valutare l’efficienza economica delle criptovalute a partire da attributi on-chain, partecipazione degli utenti, dinamiche dell’offerta e attività di trasferimento."),
    tags: [
      t("Cryptocurrency efficiency", "Efficienza delle criptovalute"),
      t("Shannon entropy", "Entropia di Shannon"),
      t("Economic index", "Indice economico"),
      "Coin Metrics",
    ],
  },
  {
    title:
      "Blockchain Energy Consumption: Unveiling the Impact of Network Topologies",
    badge: "IEEE ICBC '25",
    href: "/research/performance-energy-economic-efficiency",
    desc: t("Peer-reviewed research on how network topology, workload type, and blockchain design affect energy consumption and energy per transaction.", "Studio sottoposto a revisione paritaria su come topologia, carico di lavoro e progettazione delle blockchain incidono sui consumi totali e sull’energia per transazione."),
    tags: [
      t("Blockchain energy", "Consumi energetici delle blockchain"),
      t("Network topology", "Topologia di rete"),
      "RAPL",
      t("Energy per transaction", "Energia per transazione"),
    ],
  },
  {
    title: "Impact of Network Topologies on Blockchain Performance",
    badge: "ACM DEBS '25",
    href: "/research/topology-aware-blockchain-benchmarking",
    desc: t("Peer-reviewed research on how network topology affects blockchain performance under controlled, reproducible, and cloud-inspired experimental conditions.", "Studio sottoposto a revisione paritaria sugli effetti della topologia di rete sulle prestazioni delle blockchain, in condizioni controllate e riproducibili ispirate al cloud."),
    tags: [
      t("Blockchain benchmarking", "Benchmarking delle blockchain"),
      t("Network topology", "Topologia di rete"),
      "Lilith",
      t("Reproducibility", "Riproducibilità"),
    ],
  },
];

const artifacts = [
  {
    title: t("Lilith - A Topology-Aware Blockchain Benchmarking Framework", "Lilith – Framework di benchmarking per blockchain con topologie controllate"),
    badge: t("Artifact", "Materiali di ricerca"),
    href: "/research/lilith-benchmarking-framework",
    desc: t("Public GitHub research artifact supporting topology-aware blockchain benchmarking, workload execution, network emulation, local validation, Git LFS-backed datasets, and reproducible experimental analysis.", "Strumento pubblico su GitHub per il benchmarking delle blockchain con topologie controllate. Supporta l’esecuzione dei carichi, l’emulazione di rete, la validazione locale, i dataset gestiti con Git LFS e l’analisi riproducibile."),
    tags: [
      "Framework",
      "GitHub",
      "Benchmarking",
      t("Network emulation", "Emulazione di rete"),
      t("Reproducibility", "Riproducibilità"),
    ],
  },
  {
    title: t("CryptoEntropy - Economic Efficiency Dataset", "CryptoEntropy – Dataset sull’efficienza economica"),
    badge: t("Dataset / Tool", "Dataset e strumento"),
    href: "/research/entropy-based-economic-efficiency",
    desc: t("Public normalized and entropy-derived cryptocurrency datasets supporting the DLT '25 EB-index paper, with documentation, citation metadata, reproducible plotting material, and an interactive dashboard.", "Dataset pubblici sulle criptovalute, normalizzati e derivati dall’entropia, a supporto dell’articolo DLT ’25 sull’EB-index. Includono documentazione, dati bibliografici, materiali per ricreare i grafici e una dashboard."),
    tags: [
      "Dataset",
      "EB-index",
      t("Cryptocurrency efficiency", "Efficienza delle criptovalute"),
      "Coin Metrics",
      t("Interactive dashboard", "Dashboard interattiva"),
    ],
  },
  {
    title:
      "Network-Controlled Dataset of Blockchain Benchmarks for Evaluating Repeatability and Performance Predictability",
    badge: "Dataset",
    href: "/research/blockchain-repeatability-dataset",
    desc: t("Public dataset of 300 aggregate configurations for evaluating blockchain benchmark repeatability and performance predictability across five platforms, five network topologies, six workloads, and two network sizes.", "Dataset pubblico di 300 configurazioni aggregate per valutare la ripetibilità dei benchmark e la prevedibilità delle prestazioni. Copre cinque piattaforme, cinque topologie, sei carichi di lavoro e due dimensioni di rete."),
    tags: [
      "Dataset",
      t("Repeatability", "Ripetibilità"),
      t("Performance predictability", "Prevedibilità delle prestazioni"),
      t("Experimental analysis", "Analisi sperimentale"),
    ],
  },
];

const academicTheses = [
  {
    title: "Comparing Blockchains: Performance, Energy, and Economic Efficiencies",
    badge: t("PhD thesis", "Tesi di dottorato"),
    href: "/research/comparing-blockchains",
    desc: t("Doctoral dissertation presenting a multidimensional comparison of blockchain systems across performance, energy consumption, experimental repeatability, performance predictability, and economic efficiency.", "Tesi di dottorato che confronta sistemi blockchain in termini di prestazioni, consumi energetici, ripetibilità, prevedibilità ed efficienza economica."),
    tags: [
      t("PhD thesis", "Tesi di dottorato"),
      t("Blockchain systems", "Sistemi blockchain"),
      t("Network topology", "Topologia di rete"),
      t("Repeatability", "Ripetibilità"),
      t("Energy", "Energia"),
      t("Economic efficiency", "Efficienza economica"),
    ],
  },
  {
    title:
      "Decentralized accounting system: Efficient document management system implemented on top of blockchain secure transactions environment",
    badge: t("Master's thesis", "Tesi magistrale"),
    href: "/research/decentralized-accounting-system",
    desc: t("Master's thesis on an efficient document-management and accounting system implemented with blockchain transactions, Solid Pods, MetaMask, QR codes, and eBill-inspired workflows.", "Tesi magistrale su un sistema di contabilità e gestione documentale che usa transazioni blockchain, Solid Pods, MetaMask, codici QR e procedure ispirate a eBill."),
    tags: [
      "Ethereum",
      "Solid Pods",
      t("Document management", "Gestione documentale"),
      t("SME accounting", "Contabilità per PMI"),
      t("Prototype", "Prototipo"),
    ],
  },
  {
    title: "Threat Modeling Process: Strumenti per la gestione del processo di modellamento delle minacce",
    badge: t("Bachelor's thesis", "Tesi triennale"),
    href: "/theses/bachelor-thesis-threat-modeling-process.pdf",
    external: true,
    desc: t("Bachelor's thesis on threat modeling, secure software development, threat intelligence, monitoring tools, log analysis, visualization, containerization, and security-oriented infrastructure.", "Tesi triennale su modellazione delle minacce, sviluppo sicuro, threat intelligence, monitoraggio, analisi dei log, visualizzazione, container e infrastrutture orientate alla sicurezza."),
    tags: [
      t("Threat modeling", "Modellazione delle minacce"),
      t("Cybersecurity", "Sicurezza informatica"),
      t("Monitoring", "Monitoraggio"),
      "Docker",
      "Kubernetes",
    ],
  },
];
---

<BaseLayout
  title={t("Blockchain Research and Publications | Vincenzo Di Perna", "Ricerca sulle blockchain e pubblicazioni | Vincenzo Di Perna")}
  description={t("Explore research on blockchain benchmarking, network topologies, energy use, economic efficiency, DeFi and reproducible datasets.", "Pubblicazioni e dataset di Vincenzo Di Perna su benchmarking delle blockchain, topologie, consumi energetici, efficienza economica e DeFi.")}
  sideBarActiveItemID="research"
>
  <section class="mb-10">
    <h1 class="text-4xl font-bold mb-4">{t("Research", "Ricerca")}</h1>

    <p class="text-lg leading-relaxed opacity-90">
      {t("My research focuses on blockchain systems evaluation, distributed infrastructures, digital assets, reproducible experimentation, network-aware benchmarking, energy and efficiency analysis, and the study of performance variability, repeatability, and predictability under controlled experimental conditions.", "Studio come si comportano le blockchain e le infrastrutture distribuite in condizioni sperimentali controllate. Il mio lavoro riguarda il benchmarking con topologie di rete realistiche, la riproducibilità degli esperimenti, i consumi e l’efficienza, con particolare attenzione a variabilità, ripetibilità e prevedibilità delle prestazioni.")}
    </p>
  </section>

  <section class="mb-12"><h2 class="text-3xl font-bold mb-5">{t("Research direction", "Nuovo filone di ricerca")}</h2>
    <article class="network-protected card bg-base-100 shadow-md"><div class="card-body">
  <div class="flex flex-wrap items-center gap-2"><h3 class="card-title">{t("CIRCULA - Expiry-Aware System Design for Blockchains", "CIRCULA – Scadenza e rinnovo nella progettazione delle blockchain")}</h3><span class="badge badge-primary">{t("Expected start · 1 February 2027", "Avvio previsto · 1° febbraio 2027")}</span></div>
  <p>{t("What if digital resources had an explicit lifetime? CIRCULA will investigate expiry and renewal in blockchain systems through formal semantics, prototypes and controlled evaluation. The project is funded by the SNSF and hosted at the University of Neuchâtel.", "Che cosa cambierebbe se le risorse digitali avessero una durata definita? CIRCULA studierà la scadenza e il rinnovo nelle blockchain attraverso una semantica formale, prototipi ed esperimenti controllati. L’Università di Neuchâtel ospita il progetto, finanziato dal Fondo nazionale svizzero.")}</p>
  
  <div class="card-actions mt-3"><a class="btn btn-sm btn-primary" href={localPath("/research/circula")}>{t("Explore CIRCULA", "Scopri CIRCULA")}</a><a class="btn btn-sm btn-outline" href="https://circula.unine.ch/" target="_blank" rel="noopener noreferrer">{t("Project website", "Sito del progetto")}</a></div>
</div></article>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-5">{t("Publications", "Pubblicazioni")}</h2>

    <div class="grid gap-5">
      {
        publications.map((item) => (
          <a
            href={localPath(item.href)}
            class="network-protected card bg-base-100 shadow-md transition ease-in-out hover:shadow-2xl hover:scale-[101%]"
          >
            <article class="card-body">
              <div class="flex flex-wrap gap-2 items-center">
                <h3 class="card-title">{item.title}</h3>
                <span class="badge badge-secondary">{item.badge}</span>
              </div>

              <p>{item.desc}</p>

              <div class="flex flex-wrap gap-2 mt-2">
                {item.tags.map((tag) => (
                  <span class="badge badge-outline">{tag}</span>
                ))}
              </div>

              <div class="card-actions justify-end mt-4">
                <span class="btn btn-sm btn-outline">{t("Open research page", "Approfondisci lo studio")}</span>
              </div>
            </article>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-5">{t("Artifacts & Datasets", "Materiali e dataset")}</h2>

    <div class="grid gap-5">
      {
        artifacts.map((item) =>
          item.disabled ? (
            <article class="network-protected card bg-base-100 shadow-md opacity-80">
              <div class="card-body">
                <div class="flex flex-wrap gap-2 items-center">
                  <h3 class="card-title">{item.title}</h3>
                  <span class="badge badge-secondary">{item.badge}</span>
                  <span class="badge badge-warning">{item.status}</span>
                </div>

                <p>{item.desc}</p>

                <div class="flex flex-wrap gap-2 mt-2">
                  {item.tags.map((tag) => (
                    <span class="badge badge-outline">{tag}</span>
                  ))}
                </div>

                <div class="card-actions justify-end mt-4">
                  <span class="btn btn-sm btn-disabled">{t("Page not available yet", "Pagina in preparazione")}</span>
                </div>
              </div>
            </article>
          ) : (
            <a
              href={localPath(item.href)}
              class="network-protected card bg-base-100 shadow-md transition ease-in-out hover:shadow-2xl hover:scale-[101%]"
            >
              <article class="card-body">
                <div class="flex flex-wrap gap-2 items-center">
                  <h3 class="card-title">{item.title}</h3>
                  <span class="badge badge-secondary">{item.badge}</span>
                </div>

                <p>{item.desc}</p>

                <div class="flex flex-wrap gap-2 mt-2">
                  {item.tags.map((tag) => (
                    <span class="badge badge-outline">{tag}</span>
                  ))}
                </div>

                <div class="card-actions justify-end mt-4">
                  <span class="btn btn-sm btn-outline">{t("Open artifact page", "Vai alla risorsa")}</span>
                </div>
              </article>
            </a>
          )
        )
      }
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-5">{t("Academic Theses", "Tesi")}</h2>

    <div class="grid gap-5">
      {
        academicTheses.map((item) =>
          item.disabled ? (
            <article class="network-protected card bg-base-100 shadow-md opacity-80">
              <div class="card-body">
                <div class="flex flex-wrap gap-2 items-center">
                  <h3 class="card-title">{item.title}</h3>
                  <span class="badge badge-secondary">{item.badge}</span>
                  <span class="badge badge-warning">{item.status}</span>
                </div>

                <p>{item.desc}</p>

                <div class="flex flex-wrap gap-2 mt-2">
                  {item.tags.map((tag) => (
                    <span class="badge badge-outline">{tag}</span>
                  ))}
                </div>

                <div class="card-actions justify-end mt-4">
                  <span class="btn btn-sm btn-disabled">{t("Page not available yet", "Pagina in preparazione")}</span>
                </div>
              </div>
            </article>
          ) : (
            <a
              href={localPath(item.href)}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class="network-protected card bg-base-100 shadow-md transition ease-in-out hover:shadow-2xl hover:scale-[101%]"
            >
              <article class="card-body">
                <div class="flex flex-wrap gap-2 items-center">
                  <h3 class="card-title">{item.title}</h3>
                  <span class="badge badge-secondary">{item.badge}</span>
                </div>

                <p>{item.desc}</p>

                <div class="flex flex-wrap gap-2 mt-2">
                  {item.tags.map((tag) => (
                    <span class="badge badge-outline">{tag}</span>
                  ))}
                </div>

                <div class="card-actions justify-end mt-4">
                  <span class="btn btn-sm btn-outline">
                    {item.external ? "Open thesis PDF" : "Open thesis page"}
                  </span>
                </div>
              </article>
            </a>
          )
        )
      }
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-3xl font-bold mb-5">{t("Research Experience", "Esperienza di ricerca")}</h2>

    <a
      href={localPath("/research/ccaf-experience")}
      class="network-protected card bg-base-100 shadow-md transition ease-in-out hover:shadow-2xl hover:scale-[101%]"
    >
      <article class="card-body">
        <div class="flex flex-wrap gap-2 items-center">
          <h3 class="card-title">
            {t("Digital Asset Programme Intern", "Tirocinio nel Digital Asset Programme")}
          </h3>
          <span class="badge badge-secondary">CCAF</span>
        </div>

        <p>
          {t("Research internship experience at the Cambridge Centre for Alternative Finance, within the Digital Asset Programme, connected to digital assets, DeFi taxonomy, TradFi integration, protocol classification, and the Cambridge DeFi Navigator.", "Tirocinio di ricerca presso il Cambridge Centre for Alternative Finance, nel Digital Asset Programme. Ho lavorato su asset digitali, tassonomia della DeFi, classificazione dei protocolli, rapporto con la finanza tradizionale e Cambridge DeFi Navigator.")}
        </p>

        <div class="flex flex-wrap gap-2 mt-2">
          <span class="badge badge-outline">Digital Asset Programme</span>
          <span class="badge badge-outline">DeFi</span>
          <span class="badge badge-outline">TradFi</span>
          <span class="badge badge-outline">{t("Taxonomy", "Tassonomia")}</span>
          <span class="badge badge-outline">DeFi Navigator</span>
        </div>

        <div class="card-actions justify-end mt-4">
          <span class="btn btn-sm btn-outline">{t("Open experience page", "Scopri l’esperienza")}</span>
        </div>
      </article>
    </a>
  </section>
</BaseLayout>
