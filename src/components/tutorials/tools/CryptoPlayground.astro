---
import { translator } from "../../../i18n/locale";

const t = translator(Astro.url.pathname);
const { labelledBy } = Astro.props;
---

<section id="crypto-playground" aria-labelledby={labelledBy} class="card">
  <div class="card-body p-3 sm:p-4">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
      <div class="grid gap-3">
        <label class="form-control">
          <span class="label-text font-semibold">{t("Transaction data", "Dati della transazione")}</span>
          <textarea
            data-crypto-input
            class="textarea textarea-bordered min-h-28"
          >{t("Alice sends 5 tokens to Bob", "Alice invia 5 token a Bob")}</textarea>
        </label>

        <button class="btn btn-primary" data-crypto-action="hash">
          {t("Compute hash", "Calcola l’hash")}
        </button>

        <button class="btn btn-outline" data-crypto-action="mine">
          {t("Mine toy block", "Mina un blocco")}
        </button>

        <button class="btn btn-outline" data-crypto-action="tamper">
          {t("Tamper with data", "Altera i dati")}
        </button>
      </div>

      <div class="grid gap-3">
        <div class="rounded-xl bg-base-200 border border-base-300 p-4">
          <p class="font-semibold mb-1">{t("SHA-256 hash", "Hash SHA-256")}</p>
          <p data-crypto-hash class="font-mono text-xs break-all opacity-80">
            {t("Click “Compute hash”.", "Premi «Calcola l’hash».")}
          </p>
        </div>

        <div class="rounded-xl bg-base-200 border border-base-300 p-4">
          <p class="font-semibold mb-1">{t("Toy block", "Blocco dimostrativo")}</p>
          <p class="text-sm opacity-80">
            {t("Previous hash:", "Hash precedente")}
            <span data-previous-hash class="font-mono break-all">
              0000previousblock
            </span>
          </p>
          <p class="text-sm opacity-80">
            {t("Nonce:", "Nonce")}
            <span data-nonce class="font-mono">-</span>
          </p>
          <p class="text-sm opacity-80">
            {t("Block hash:", "Hash del blocco")}
            <span data-block-hash class="font-mono break-all">-</span>
          </p>
        </div>

        <div class="rounded-xl bg-base-200 border border-base-300 p-4">
          <p class="font-semibold mb-1">{t("Lesson", "Che cosa osservare")}</p>
          <p data-crypto-status class="text-sm opacity-80">
            {t("Hashes are deterministic fingerprints: the same input gives the same output, but a tiny change creates a very different hash.", "Gli stessi dati producono sempre lo stesso hash. Basta una piccola modifica per ottenere un’impronta molto diversa.")}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const isItalian = () => document.documentElement.lang === "it";
  const translate = (english, italian) => isItalian() ? italian : english;

  function initCryptoPlayground() {
    const root = document.querySelector("#crypto-playground");

    if (!root || root.dataset.initialized === "true") {
    return;
    }

    root.dataset.initialized = "true";

    const input = root.querySelector("[data-crypto-input]");
    const hashOutput = root.querySelector("[data-crypto-hash]");
    const previousHash = root.querySelector("[data-previous-hash]");
    const nonceOutput = root.querySelector("[data-nonce]");
    const blockHashOutput = root.querySelector("[data-block-hash]");
    const status = root.querySelector("[data-crypto-status]");

    async function sha256(text) {
      const encoded = new TextEncoder().encode(text);
      const digest = await crypto.subtle.digest("SHA-256", encoded);
      return Array.from(new Uint8Array(digest))
        .map((byte) => byte.toString(16).padStart(2, "0"))
        .join("");
    }

    async function computeHash() {
      const hash = await sha256(input.value);
      hashOutput.textContent = hash;
      status.textContent =
        translate("The transaction now has a cryptographic fingerprint. Change even one character and compute it again.", "La transazione ora ha un’impronta crittografica. Modifica anche solo un carattere e ricalcola l’hash.");
    }

    async function mineToyBlock() {
      status.textContent = translate("Mining a tiny toy block...", "Ricerca di un blocco dimostrativo…");
      const data = input.value;
      const prev = previousHash.textContent.trim();

      for (let nonce = 0; nonce < 200000; nonce += 1) {
        const candidate = await sha256(`${prev}|${data}|${nonce}`);

        if (candidate.startsWith("000")) {
          nonceOutput.textContent = nonce;
          blockHashOutput.textContent = candidate;
          status.textContent =
            translate("Toy block mined. This is not real mining difficulty, but it shows the idea of searching for a valid hash.", "Blocco di prova minato. La difficoltà è bassa per mostrare come funziona la ricerca di un hash valido.");
          return;
        }
      }

      status.textContent =
        translate("No valid toy block found in the search limit. Try again or change the data.", "Nessun blocco valido trovato entro il numero di tentativi previsto. Riprova o cambia i dati.");
    }

    async function tamperData() {
      input.value = `${input.value} [tampered]`;
      const newHash = await sha256(input.value);
      hashOutput.textContent = newHash;
      status.textContent =
        translate("The data was modified. The hash changed, so the tampering becomes visible.", "I dati sono cambiati. Il nuovo hash rende visibile la modifica.");
    }

    root.querySelector('[data-crypto-action="hash"]').addEventListener("click", computeHash);
    root.querySelector('[data-crypto-action="mine"]').addEventListener("click", mineToyBlock);
    root.querySelector('[data-crypto-action="tamper"]').addEventListener("click", tamperData);

    computeHash();
  }

  initCryptoPlayground();

  if (!window.__cryptoPlaygroundPageLoadRegistered) {
    window.__cryptoPlaygroundPageLoadRegistered = true;
    document.addEventListener("astro:page-load", initCryptoPlayground);
  }
</script>